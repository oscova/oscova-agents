<Project>
  <Import Project="$(MSBuildThisFileDirectory)Versions.props" />
  <!-- Untracked Debug version overrides for local package testing. Release builds ignore them. -->
  <Import Project="$(MSBuildThisFileDirectory)Versions.local.props" Condition="'$(Configuration)' != 'Release' and Exists('$(MSBuildThisFileDirectory)Versions.local.props')" />

  <!-- App selector, App RID packages, and Host assembly share this version. Change it only with the package version bump script. -->
  <PropertyGroup>
    <OscovaAppVersion>3.5.1</OscovaAppVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedOscovaPackageVersions)' == 'true'">
    <AssemblyMetadata Include="Oscova.Agents.App" Value="$(OscovaAppVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <ICU4NSuppressNuGetBuildTasksPackVersionWarnings>true</ICU4NSuppressNuGetBuildTasksPackVersionWarnings>
    <EnableGpuAcceleration Condition="'$(EnableGpuAcceleration)' == '' and '$(UseGpu)' == ''">false</EnableGpuAcceleration>
    <EnableGpuAcceleration Condition="'$(EnableGpuAcceleration)' == '' and '$(UseGpu)' != ''">$(UseGpu)</EnableGpuAcceleration>
    <UseGpu>$(EnableGpuAcceleration)</UseGpu>

    <SpeechWhisperRuntimeVersion>1.9.0</SpeechWhisperRuntimeVersion>
    <SpeechOnnxRuntimeCpuVersion>1.24.4</SpeechOnnxRuntimeCpuVersion>
    <SpeechOnnxRuntimeGpuVersion>1.24.3</SpeechOnnxRuntimeGpuVersion>
    <SpeechKokoroSharpVersion>0.6.6</SpeechKokoroSharpVersion>

    <DefineConstants Condition="'$(EnableGpuAcceleration)' == 'true'">$(DefineConstants);GPU_ACCELERATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Oscova</Authors>
    <Company>oscova.ai</Company>
    <Product>Oscova Agents</Product>
    <Copyright>Copyright © 2026 oscova.ai</Copyright>
    <PackageProjectUrl>https://oscova.ai</PackageProjectUrl>
    <PackageIcon>oscova-package-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\branding\oscova-package-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn Condition="'$(MSBuildProjectName)' != 'Oscova.Agents'">$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.101">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Only production plugins share the host-provided compile-time references. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Mxc' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Docker' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.AgentTemplates' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Discord' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Telegram' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Slack' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.GoogleWorkspace' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.MicrosoftGraph' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Browser' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Web' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.FoundryLocal' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.LlamaSharp' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.LocalSpeechRecognition' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.LocalSpeechSynthesis' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.OpenAI' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.ElevenLabs'">
    <PackageReference Include="Oscova.Agents" Version="[$(OscovaAgentsVersion)]" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Plugins with a Microsoft.AspNetCore.App framework reference already get the logging abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" IncludeAssets="compile" PrivateAssets="all" Condition="'$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.GoogleWorkspace' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.MicrosoftGraph' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Browser' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.Web' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.FoundryLocal' Or '$(MSBuildProjectName)' == 'Oscova.Agents.Plugins.LlamaSharp'" />
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.317" />
    <PackageReference Update="Roslynator.Analyzers" Version="5.0.1" />
    <PackageReference Update="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Plugin manifests carry a $version$ token, replaced with the project Version before copy and pack. -->
  <Target Name="StampPluginManifestVersion" BeforeTargets="AssignTargetPaths;_GetPackageFiles;GenerateNuspec">
    <!-- Path.Combine keeps an absolute IntermediateOutputPath, which the CUDA speech pack passes. -->
    <PropertyGroup>
      <_StampedManifestDir>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'stamped'))</_StampedManifestDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginManifestSource Include="@(None)" Condition="('%(Filename)%(Extension)' == 'oscova-plugin.json' Or '%(Filename)%(Extension)' == 'oscova-plugin.cuda.json') And ($([System.IO.File]::ReadAllText('%(FullPath)').Contains('$version$')) Or $([System.IO.File]::ReadAllText('%(FullPath)').Contains('$frameworkVersion$')))">
        <StampedPath>$(_StampedManifestDir)/%(Filename)%(Extension)</StampedPath>
        <TargetPath Condition="'%(None.TargetPath)' == ''">%(Filename)%(Extension)</TargetPath>
      </_PluginManifestSource>
    </ItemGroup>
    <MakeDir Directories="$(_StampedManifestDir)" Condition="'@(_PluginManifestSource)' != ''" />
    <WriteLinesToFile File="%(_PluginManifestSource.StampedPath)" Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_PluginManifestSource.FullPath)').Replace('$version$', '$(Version)').Replace('$frameworkVersion$', '$(OscovaAgentsVersion)'))))" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'@(_PluginManifestSource)' != ''" />
    <ItemGroup>
      <None Remove="@(_PluginManifestSource)" />
      <None Include="@(_PluginManifestSource->'%(StampedPath)')" />
    </ItemGroup>
  </Target>
</Project>
