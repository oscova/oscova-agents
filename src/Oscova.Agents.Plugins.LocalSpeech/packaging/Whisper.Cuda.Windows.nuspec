<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Oscova.Agents.Native.Whisper.Cuda.Windows</id>
    <version>$whisperVersion$</version>
    <authors>Oscova</authors>
    <description>Whisper.net CUDA 13 native binaries for the Windows x64 Oscova local speech plugin. Requires separately installed NVIDIA CUDA prerequisites.</description>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <icon>oscova-package-icon.png</icon>
    <repository type="git" url="https://github.com/oscova/oscova-agents" />
  </metadata>
  <files>
    <file src="$windows$" target="runtimes/win-x64/native/runtimes/cuda/win-x64" />
    <file src="$readme$" target="README.md" />
    <file src="$icon$" target="oscova-package-icon.png" />
    <file src="$licenses$" target="licenses" />
  </files>
</package>
