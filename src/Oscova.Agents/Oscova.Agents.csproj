<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>
		<!-- Shell and SqliteVec are intentionally preview dependencies until stable packages are available. -->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Version>$(OscovaAgentsVersion)</Version>
		<AssemblyVersion>3.0.0.0</AssemblyVersion>
		<Description>Oscova Agents is a reusable .NET agent framework for building local-first AI agents and tools on top of the Microsoft Agent Framework.</Description>
		<PackageTags>oscova;oscova-agents;ai;agents;agent-framework;llm;local-first;dotnet</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/oscova/oscova-agents</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Cronos" Version="0.13.0" />
		<PackageReference Include="Microsoft.Agents.AI" Version="1.26.0" />
		<PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.26.0-preview.261023.1" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
		<PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.11.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
		<PackageReference Include="CommunityToolkit.VectorData.SqliteVec" Version="1.0.3-preview" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<PackageReference Include="Scriban" Version="7.5.3" />
		<PackageReference Include="Syn.Utilities" Version="1.7.7" />
		<PackageReference Include="TimeZoneConverter" Version="8.0.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Meziantou.Analyzer" Version="3.0.317" />
	  <PackageReference Update="Roslynator.Analyzers" Version="5.0.1" />
	  <PackageReference Update="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>

</Project>
