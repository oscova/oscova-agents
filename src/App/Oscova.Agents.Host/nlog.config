<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="Oscova.Agents.Infrastructure" />
  </extensions>

  <targets>
    <!-- Per-user JSONL: file path interpolates userId from scope -->
    <target xsi:type="File"
            name="userJsonFile"
            fileName="${environment:variable=OSCOVA_APP_DATA_DIR}/users/${scopeproperty:item=userId}/logs/user-${shortdate}.jsonl"
            archiveFileName="${environment:variable=OSCOVA_APP_DATA_DIR}/users/${scopeproperty:item=userId}/logs/archive/user-{#}.jsonl"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            keepFileOpen="false"
            createDirs="true"
            encoding="utf-8">
      <layout xsi:type="JsonLayout" suppressSpaces="true">
        <attribute name="time" layout="${longdate}" />
        <attribute name="level" layout="${level:upperCase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="metadata" encode="false">
          <layout xsi:type="JsonLayout"
                  suppressSpaces="true"
                  includeEventProperties="true"
                  includeScopeProperties="true"
                  excludeEmptyProperties="true" />
        </attribute>
        <attribute name="exception" encode="false">
          <layout xsi:type="JsonLayout">
            <attribute name="type" layout="${exception:format=type}" />
            <attribute name="message" layout="${exception:format=message}" />
            <attribute name="stacktrace" layout="${exception:format=tostring}" />
          </layout>
        </attribute>
      </layout>
    </target>

    <!-- System JSONL: events with no userId in scope -->
    <target xsi:type="File"
            name="systemJsonFile"
            fileName="${environment:variable=OSCOVA_APP_DATA_DIR}/logs/system/system-${shortdate}.jsonl"
            archiveFileName="${environment:variable=OSCOVA_APP_DATA_DIR}/logs/system/archive/system-{#}.jsonl"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            keepFileOpen="false"
            createDirs="true"
            encoding="utf-8">
      <layout xsi:type="JsonLayout" suppressSpaces="true">
        <attribute name="time" layout="${longdate}" />
        <attribute name="level" layout="${level:upperCase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="metadata" encode="false">
          <layout xsi:type="JsonLayout"
                  suppressSpaces="true"
                  includeEventProperties="true"
                  includeScopeProperties="true"
                  excludeEmptyProperties="true" />
        </attribute>
        <attribute name="exception" encode="false">
          <layout xsi:type="JsonLayout">
            <attribute name="type" layout="${exception:format=type}" />
            <attribute name="message" layout="${exception:format=message}" />
            <attribute name="stacktrace" layout="${exception:format=tostring}" />
          </layout>
        </attribute>
      </layout>
    </target>

    <!-- Console is user-facing; full exception details remain in JSONL logs. -->
    <target xsi:type="Console" name="console"
            layout="${longdate} [${uppercase:${level}}] ${logger}: ${message}" />

    <target xsi:type="NotificationInbox" name="notification-inbox" layout="${message}" />
  </targets>

  <rules>
    <!-- Console and notifications stay quiet for a file-retained framework recovery event. -->
    <!-- Ephemeral data protection keys change on every start, so a browser's old antiforgery cookie fails once and is replaced. -->
    <logger name="*" minlevel="Warn" writeTo="notification-inbox,console">
      <filters defaultAction="Log">
        <when condition="'${logger}' == 'Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager' and '${event-properties:item=EventName}' == 'NoXMLEncryptorConfiguredKeyMayBePersistedToStorageInUnencryptedForm'" action="Ignore" />
        <when condition="'${logger}' == 'Microsoft.AspNetCore.Antiforgery.DefaultAntiforgery' and '${event-properties:item=EventName}' == 'TokenDeserializeException'" action="IgnoreFinal" />
      </filters>
    </logger>

    <!-- Swallow ASP.NET Core (and other Microsoft) logs up to Info -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />

    <!-- Oscova.Agents: route to per-user file when userId scope is present -->
    <logger name="Oscova.Agents.*" minlevel="Info" writeTo="userJsonFile">
      <filters defaultAction="Ignore">
        <when condition="length('${scopeproperty:item=userId}') > 0" action="Log" />
      </filters>
    </logger>

    <!-- Oscova.Agents: otherwise route to system file -->
    <logger name="Oscova.Agents.*" minlevel="Info" writeTo="systemJsonFile" final="true">
      <filters defaultAction="Log">
        <when condition="length('${scopeproperty:item=userId}') > 0" action="Ignore" />
      </filters>
    </logger>

    <!-- Microsoft / System warnings: always system stream -->
    <logger name="Microsoft.*" minlevel="Warn" writeTo="systemJsonFile" final="true" />
    <logger name="System.*" minlevel="Warn" writeTo="systemJsonFile" final="true" />

    <!-- Default for everything else: per-user if scope present, else system -->
    <logger name="*" minlevel="Info" writeTo="userJsonFile">
      <filters defaultAction="Ignore">
        <when condition="length('${scopeproperty:item=userId}') > 0" action="Log" />
      </filters>
    </logger>
    <logger name="*" minlevel="Info" writeTo="systemJsonFile">
      <filters defaultAction="Log">
        <when condition="length('${scopeproperty:item=userId}') > 0" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
