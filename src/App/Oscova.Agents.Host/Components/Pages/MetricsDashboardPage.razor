    private static int ToolCallCount(ToolUsageEntry row) =>
        row.Succeeded + row.Failed;

    private static int PercentOf(long value, long max)
    {
        if (value <= 0 || max <= 0)
        {
            return 0;
        }

        return (int)Math.Clamp(Math.Round(value * 100d / max, MidpointRounding.AwayFromZero), 0, 100);
    }

    private static string Initial(string value)
    {
        var trimmed = value.Trim();
        return trimmed.Length == 0
            ? "?"
            : trimmed[0].ToString().ToUpper(CultureInfo.CurrentCulture);
    }

    private string FormatDuration(double seconds)
    {
        if (seconds <= 0)
        {
            return $"0 {Loc.GetOrDefault(NavigationTextKeys.DashboardSecondsShort, "s")}";
        }

        var duration = TimeSpan.FromSeconds(seconds);
        return duration.TotalMinutes >= 1
            ? $"{duration.TotalMinutes:N1} {Loc.GetOrDefault(NavigationTextKeys.DashboardMinutesShort, "m")}"
            : $"{duration.TotalSeconds:N0} {Loc.GetOrDefault(NavigationTextKeys.DashboardSecondsShort, "s")}";
    }

    private string FormatFileCount(int fileCount)
    {
        // A count label avoids Arabic inflections that the singular/other resources cannot express.
        if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
        {
            return $"{Loc.GetOrDefault(NavigationTextKeys.DashboardFiles, "files")}: {FormatLong(fileCount)}";
        }

        var fileLabel = fileCount == 1
            ? Loc.GetOrDefault(NavigationTextKeys.DashboardFile, "file")
            : Loc.GetOrDefault(NavigationTextKeys.DashboardFiles, "files");

        return $"{FormatLong(fileCount)} {fileLabel}";
    }

    private string FormatTaskOutcome(DashboardSnapshot snapshot) =>
        Loc.GetOrDefault(NavigationTextKeys.DashboardSucceeded, "Succeeded") + $" {FormatLong(snapshot.TaskSucceededCount)} / " +
        Loc.GetOrDefault(NavigationTextKeys.DashboardFailed, "Failed") + $" {FormatLong(snapshot.TaskFailedCount)}";

    private string FormatToolOutcome(IReadOnlyList<ToolUsageEntry> rows) =>
        Loc.GetOrDefault(NavigationTextKeys.DashboardSucceeded, "Succeeded") + $" {FormatLong(rows.Sum(row => row.Succeeded))} / " +
        Loc.GetOrDefault(NavigationTextKeys.DashboardFailed, "Failed") + $" {FormatLong(rows.Sum(row => row.Failed))}";

    private object BuildChartPayload(DashboardSnapshot snapshot)
    {
        var timeline = MergeTimeline(snapshot.TokenTimeline, snapshot.EgressTimeline).TakeLast(30).ToArray();
        var distribution = BuildDistributionRows(snapshot.TokensByProvider).ToArray();

        return new
        {
            labels = timeline.Select(point => point.Date.ToString("MMM d", CultureInfo.CurrentCulture)).ToArray(),
            inputTokens = timeline.Select(point => point.InputTokens).ToArray(),
            outputTokens = timeline.Select(point => point.OutputTokens).ToArray(),
            egress = timeline.Select(point => point.Egress).ToArray(),
            egressName = Loc.GetOrDefault(NavigationTextKeys.DashboardEgress, "Egress"),
            distributionTitle = Loc.GetOrDefault(NavigationTextKeys.DashboardByProvider, "By provider"),
            distribution,
            tokenMixTotal = Loc.GetOrDefault(NavigationTextKeys.DashboardTotalTokens, "Total tokens"),
            tokenMix = new[]
            {
                new ChartDatum(Loc.GetOrDefault(NavigationTextKeys.DashboardInputTokens, "Input tokens"), snapshot.TotalInputTokens),
                new ChartDatum(Loc.GetOrDefault(NavigationTextKeys.DashboardOutputTokens, "Output tokens"), snapshot.TotalOutputTokens)
            }
        };
    }

    private IEnumerable<ChartDatum> BuildDistributionRows(IReadOnlyList<TokenBreakdownEntry> rows)
    {
        var rankedRows = rows
            .Where(row => row.TotalTokens > 0)
            .OrderByDescending(row => row.TotalTokens)
            .ToArray();
        var visibleRows = rankedRows.Take(DashboardDistributionRowLimit);
        var hiddenRows = rankedRows.Skip(DashboardDistributionRowLimit).ToArray();

        foreach (var row in visibleRows)
        {
            yield return new ChartDatum(FormatBucketName(row.Name), row.TotalTokens);
        }

        if (hiddenRows.Length > 0)
        {
            yield return new ChartDatum(
                Loc.GetOrDefault(NavigationTextKeys.DashboardOther, "Other"),
                hiddenRows.Sum(row => row.TotalTokens));
        }
    }

    private static IReadOnlyList<UsageTimePoint> MergeTimeline(IReadOnlyList<UsageTimePoint> tokens, IReadOnlyList<UsageTimePoint> egress)
    {
        var points = new Dictionary<DateOnly, UsageTimePoint>();
        foreach (var point in tokens)
        {
            points[point.Date] = point;
        }

        foreach (var point in egress)
        {
            points[point.Date] = points.TryGetValue(point.Date, out var existing)
                ? existing with { Egress = point.Egress }
                : point;
        }

        return [.. points.Values.OrderBy(point => point.Date)];
    }

    public async ValueTask DisposeAsync()
    {
        if (_chartsModule is null)
        {
            return;
        }

        try
        {
            await _chartsModule.InvokeVoidAsync("disposeMetricsDashboardCharts");
            await _chartsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record ChartDatum(string Name, long Value);
}
