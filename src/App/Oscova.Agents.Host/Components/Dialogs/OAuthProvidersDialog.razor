@inject ManagementApiClient ManagementApiClient
@inject IToastService ToastService
@inject IStringLocalizer<CommonText> CommonLoc

@* Edits the registered host-wide OAuth providers without lengthening Administration. *@
<AppDialogShell Title="@(CommonLoc.GetOrDefault(CommonTextKeys.OAuthTitle, "OAuth Providers"))"
                Subtitle="@(CommonLoc.GetOrDefault(CommonTextKeys.OAuthDescription, "Configure the shared Google and Microsoft OAuth apps used for connected accounts and future integrations."))"
                Icon="lucide:key-round"
                HelpTopic="@HelpTopics.OAuthProviders"
                MaxWidthClass="max-w-4xl"
                BodyClass="custom-scrollbar min-h-0 overflow-y-auto px-5 py-4"
                CanClose="@(!IsBusy)"
                CloseResult="@DialogResult.Cancel">
    <ChildContent>
        <div class="space-y-4">
            <div class="alert alert-soft">
                <iconify-icon icon="lucide:info" width="18" height="18"></iconify-icon>
                <span>@CommonLoc.GetOrDefault(CommonTextKeys.OAuthSecretHint, "Leave the secret blank to keep the current stored secret. Clear the client ID to disable a provider.")</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div role="alert" class="alert alert-error alert-soft">
                    <iconify-icon icon="lucide:alert-circle"></iconify-icon>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (_isLoading)
            {
                <div class="text-base-content/60 flex items-center gap-2 text-sm">
                    <span class="loading loading-spinner loading-sm"></span>
                    <span>@CommonLoc.GetOrDefault(CommonTextKeys.OAuthLoadingProviders, "Loading provider settings...")</span>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var editor in _providers)
                    {
                        @ProviderSection(editor.Metadata.Id, editor.Metadata.DisplayName, ProviderDescription(editor.Metadata), editor)
                    }
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost btn-sm" disabled="@IsBusy" @onclick="Close">
            @CommonLoc.GetOrDefault(CommonTextKeys.Close, "Close")
        </button>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;

    private IReadOnlyList<ProviderEditor> _providers = [];
    private string? _savingProvider;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool IsBusy => _isLoading || _savingProvider is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private RenderFragment ProviderSection(string provider, string name, string description, ProviderEditor editor) => @<section class="border-base-300 rounded-box border p-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <div class="flex items-center gap-2">
                    <h4 class="font-medium">@name</h4>
                    <span class="badge badge-sm @(editor.IsConfigured ? "badge-success badge-soft" : "badge-ghost")">
                        @(editor.IsConfigured ? CommonLoc.GetOrDefault(CommonTextKeys.OAuthConfiguredStatus, "Configured") : CommonLoc.GetOrDefault(CommonTextKeys.NotConfigured, "Not configured"))
                    </span>
                </div>
                <p class="text-base-content/60 mt-1 text-sm">@description</p>
            </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            @foreach (var field in editor.Metadata.Fields)
            {
                @if (field.Name == OAuthProviderDefinition.ClientIdField)
                {
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.OAuthClientIdLabel, "Client ID")</legend>
                        <label class="input w-full">
                            <span class="iconify lucide--id-card text-base-content/60 size-4.5"></span>
                            <input id="client-id-@provider" class="grow focus:outline-0" aria-label="@(CommonLoc.GetOrDefault(CommonTextKeys.OAuthClientIdLabel, "Client ID"))" disabled="@IsBusy" @bind="editor.ClientId" placeholder="@FormatCommonText(CommonTextKeys.OAuthClientIdPlaceholder, "{0} client ID", name)" />
                        </label>
                    </fieldset>
                }
                else if (field.Name == OAuthProviderDefinition.ClientSecretField)
                {
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.OAuthClientSecretLabel, "Client Secret")</legend>
                        <label class="input w-full">
                            <span class="iconify lucide--key-round text-base-content/60 size-4.5"></span>
                            <input id="client-secret-@provider" class="grow focus:outline-0" type="password" aria-label="@(CommonLoc.GetOrDefault(CommonTextKeys.OAuthClientSecretLabel, "Client Secret"))" disabled="@IsBusy" @bind="editor.ClientSecret" placeholder="@(editor.HasClientSecret ? CommonLoc.GetOrDefault(CommonTextKeys.OAuthSecretPlaceholderExists, "Leave blank to keep current secret") : CommonLoc.GetOrDefault(CommonTextKeys.OAuthSecretPlaceholderNew, "Paste client secret"))" />
                        </label>
                        <p class="label text-xs opacity-70">@(editor.HasClientSecret ? CommonLoc.GetOrDefault(CommonTextKeys.OAuthSecretExists, "A secret is already stored.") : CommonLoc.GetOrDefault(CommonTextKeys.OAuthSecretNotStored, "No secret stored yet."))</p>
                    </fieldset>
                }
            }
        </div>

        <div class="mt-4 flex justify-end">
            <button type="button" class="btn btn-primary btn-sm" disabled="@IsBusy" @onclick="() => SaveAsync(provider, editor)">
                @if (_savingProvider == provider)
                {
                    <span class="loading loading-spinner loading-sm"></span>
                }
                else
                {
                    <span class="iconify lucide--save size-4" aria-hidden="true"></span>
                }
                @FormatCommonText(CommonTextKeys.OAuthSaveButton, "Save {0}", name)
            </button>
        </div>
    </section>;

    private async Task LoadAsync()
    {
        _errorMessage = null;
        _isLoading = true;
        try
        {
            await LoadConfigurationAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadConfigurationAsync(string? savedProvider = null)
    {
        var config = await ManagementApiClient.GetOAuthProviderConfigurationAsync();
        // A provider-specific save must preserve every other editor's unsaved values.
        _providers = config.Providers.Select(entry => savedProvider is null || entry.Id == savedProvider
            ? ProviderEditor.FromEntry(entry)
            : _providers.FirstOrDefault(editor => editor.Metadata.Id == entry.Id) ?? ProviderEditor.FromEntry(entry)).ToArray();
    }

    private async Task SaveAsync(string provider, ProviderEditor editor)
    {
        if (IsBusy)
        {
            return;
        }

        _errorMessage = null;
        _savingProvider = provider;
        try
        {
            await ManagementApiClient.SaveOAuthProviderConfigurationAsync(provider, new SaveOAuthProviderRequest
            {
                ClientId = editor.ClientId,
                ClientSecret = editor.ClientSecret
            });
            await LoadConfigurationAsync(provider);
            ToastService.Show(FormatCommonText(CommonTextKeys.OAuthConfigurationSaved, "{0} configuration saved.", editor.Metadata.DisplayName), ToastType.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _savingProvider = null;
        }
    }

    private string ProviderDescription(OAuthProviderAdminEntry provider) => provider.Id switch
    {
        "google" => CommonLoc.GetOrDefault(CommonTextKeys.OAuthGoogleDescription, provider.Description),
        "microsoft" => CommonLoc.GetOrDefault(CommonTextKeys.OAuthMicrosoftDescription, provider.Description),
        _ => provider.Description
    };

    private string FormatCommonText(string key, string fallback, params object?[] args) =>
        string.Format(CultureInfo.CurrentCulture, CommonLoc.GetOrDefault(key, fallback), args);

    private void Close() => DialogInstance.Close(DialogResult.Cancel);

    /// <summary>Holds editable OAuth values without exposing stored secret material.</summary>
    private sealed class ProviderEditor
    {
        public required OAuthProviderAdminEntry Metadata { get; init; }
        public string? ClientId { get; set; }
        public string ClientSecret { get; set; } = string.Empty;
        public bool HasClientSecret { get; set; }
        public bool IsConfigured { get; set; }

        public static ProviderEditor FromEntry(OAuthProviderAdminEntry entry) => new()
        {
            Metadata = entry,
            ClientId = entry.ClientId,
            HasClientSecret = entry.HasClientSecret,
            IsConfigured = entry.IsConfigured
        };
    }
}
