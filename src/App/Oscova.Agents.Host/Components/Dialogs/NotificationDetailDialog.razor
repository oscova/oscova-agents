@inject UserServiceScope UserScope
@inject IStringLocalizer<CommonText> CommonLoc

<AppDialogShell Title="@Entry.Title"
                Icon="lucide:bell-ring"
                MaxWidthClass="max-w-2xl"
                HelpTopic="@HelpTopics.NotificationDetails"
                BodyClass="min-h-0 overflow-y-auto px-5 py-4"
                CloseResult="@DialogResult.Ok">
    <ChildContent>
        <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="badge @KindBadgeClass(Entry.Kind)">@KindLabel(Entry.Kind)</span>
            <span class="text-xs text-base-content/60">@TimeZoneInfo.ConvertTime(Entry.CreatedAt, UserScope.UiSettings.GetTimeZone()).ToString("g", CultureInfo.CurrentCulture)</span>
        </div>
        <div class="whitespace-pre-wrap text-sm leading-relaxed">
            @Entry.Body
        </div>
    </ChildContent>
</AppDialogShell>

@code {
    [CascadingParameter] public DialogInstance DialogInstance { get; set; } = default!;
    [Parameter] public NotificationEntry Entry { get; set; } = default!;

    protected override void OnInitialized()
    {
        Entry ??= DialogInstance.Get<NotificationEntry>("Entry")!;
    }

    private string KindLabel(NotificationKind kind) => kind switch
    {
        NotificationKind.TaskSuccess => CommonLoc.GetOrDefault(CommonTextKeys.TaskStatusHealthy, "Healthy"),
        NotificationKind.TaskFailure => CommonLoc.GetOrDefault(CommonTextKeys.TaskStatusNeedsAttention, "Needs attention"),
        NotificationKind.SystemError => CommonLoc.GetOrDefault(CommonTextKeys.DialogLogLevelError, "Error"),
        NotificationKind.SystemWarning => CommonLoc.GetOrDefault(CommonTextKeys.DialogLogLevelWarn, "Warn"),
        NotificationKind.ChatMessage => CommonLoc.GetOrDefault(CommonTextKeys.Assistant, "Assistant"),
        _ => CommonLoc.GetOrDefault(CommonTextKeys.NotificationsTitle, "Notifications")
    };

    private static string KindBadgeClass(NotificationKind kind) => kind switch
    {
        NotificationKind.TaskSuccess => "badge-success badge-soft",
        NotificationKind.TaskFailure => "badge-error badge-soft",
        NotificationKind.SystemError => "badge-error",
        NotificationKind.SystemWarning => "badge-warning badge-soft",
        NotificationKind.ChatMessage => "badge-info badge-soft",
        _ => "badge-ghost"
    };

    private void Close()
    {
        DialogInstance.Close(DialogResult.Ok);
    }
}
