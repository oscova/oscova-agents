@using Oscova.Agents.Core.ApiContracts.Profile
@inject ManagementApiClient ManagementApiClient
@inject IToastService ToastService
@inject IStringLocalizer<CommonText> CommonLoc
@inject TimeProvider Clock

<AppDialogShell Title="@(CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordTitle, "Vault Password"))"
                Subtitle="@(CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordDescription, "Change the password that unlocks your saved credentials and protected data."))"
                Icon="lucide:key-round"
                HelpTopic="@HelpTopics.VaultPassword"
                CanClose="@(!_isBusy)"
                CloseResult="@DialogResult.Cancel">
    <ChildContent>
        <SignInRetryNotice RetryUntil="@_retryUntil" WasBlocked="@true" OnExpired="@RetryExpired" />
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div role="alert" class="alert alert-error alert-soft mb-4">
                <iconify-icon icon="lucide:alert-circle"></iconify-icon>
                <span>@_errorMessage</span>
            </div>
        }

        <div class="space-y-4">
            <fieldset class="fieldset">
                <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordCurrent, "Current Vault Password")</legend>
                <input id="vault-current-password" aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordCurrent, "Current Vault Password")" class="input w-full" type="password" @bind="_currentPassword" autocomplete="current-password" />
            </fieldset>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <fieldset class="fieldset">
                    <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordNew, "New Vault Password")</legend>
                    <input id="vault-new-password" aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordNew, "New Vault Password")" class="input w-full" type="password" @bind="_newPassword" autocomplete="new-password" />
                </fieldset>
                <fieldset class="fieldset">
                    <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordConfirm, "Confirm Vault Password")</legend>
                    <input id="vault-confirm-password" aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordConfirm, "Confirm Vault Password")" class="input w-full" type="password" @bind="_confirmation" autocomplete="new-password" />
                </fieldset>
            </div>

            <div role="alert" class="alert alert-warning alert-soft text-sm">
                <span>@CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordRecoveryWarning, "Save this password safely. Oscova cannot recover it, and protected data cannot be opened without it.")</span>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost btn-sm" disabled="@_isBusy" @onclick="Cancel">
            @CommonLoc.GetOrDefault(CommonTextKeys.Cancel, "Cancel")
        </button>
        <button type="button" class="btn btn-primary btn-sm" disabled="@(_isBusy || !_statusLoaded || IsWaiting)" @onclick="ChangeAsync">
            @if (_isBusy)
            {
                <span class="loading loading-spinner loading-sm"></span>
            }
            @CommonLoc.GetOrDefault(CommonTextKeys.DialogVaultPasswordChangeButton, "Change password")
        </button>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmation = string.Empty;
    private string? _errorMessage;
    private bool _isBusy;
    private bool _statusLoaded;
    private DateTimeOffset? _retryUntil;
    private bool IsWaiting => _retryUntil > Clock.GetUtcNow();

    private void RetryExpired() => _retryUntil = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await ManagementApiClient.GetVaultStatusAsync();
            _retryUntil = status.RetryUntil;
            _statusLoaded = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ChangeAsync()
    {
        if (_isBusy || !_statusLoaded || IsWaiting) { return; }
        if (!Validate())
        {
            ClearFields();
            return;
        }

        _errorMessage = null;
        _isBusy = true;
        try
        {
            await ManagementApiClient.ChangeVaultPasswordAsync(
                new ChangeVaultPasswordRequest
                {
                    CurrentPassword = _currentPassword,
                    NewPassword = _newPassword,
                    ConfirmNewPassword = _confirmation
                });

            ToastService.Show(
                CommonLoc.GetOrDefault(
                    CommonTextKeys.DialogVaultPasswordChangeSuccess,
                    "Your Vault Password was changed."),
                ToastType.Success);
            DialogInstance.Close(DialogResult.Ok);
        }
        catch (VaultRetryException ex)
        {
            _retryUntil = ex.RetryUntil;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
            ClearFields();
        }
    }

    private bool Validate()
    {
        _errorMessage = null;
        if (_newPassword.Length is < 12 or > 256)
        {
            _errorMessage = CommonLoc.GetOrDefault(
                CommonTextKeys.DialogVaultPasswordLengthError,
                "The Vault Password must be between 12 and 256 characters.");
            return false;
        }

        if (!string.Equals(_newPassword, _confirmation, StringComparison.Ordinal))
        {
            _errorMessage = CommonLoc.GetOrDefault(
                CommonTextKeys.DialogVaultPasswordConfirmationError,
                "The Vault Password confirmation does not match.");
            return false;
        }

        return true;
    }

    private void ClearFields()
    {
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
        _confirmation = string.Empty;
    }

    private void Cancel() => DialogInstance.Close(DialogResult.Cancel);
}
