@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Oscova.Agents.Core.ApiContracts.Skills
@using Oscova.Agents.Skills
@inject SettingsApiClient SettingsApiClient
@inject ILogger<SkillImportDialog> Logger
@inject IToastService ToastService
@inject IStringLocalizer<SettingsText> Loc
@inject IStringLocalizer<CommonText> CommonLoc

<AppDialogShell Title="@(Loc.GetOrDefault(SettingsTextKeys.SkillsImportDialogTitle, "Import Skill"))"
                Subtitle="@(Loc.GetOrDefault(SettingsTextKeys.SkillsImportDialogDescription, "Import a single skill as a raw SKILL.md file or a packaged .zip archive."))"
                Icon="lucide:file-up"
                HelpTopic="@HelpTopics.SkillImport"
                TitleClass="truncate text-lg font-bold"
                CloseResult="@DialogResult.Cancel"
                CanClose="@(!_isImporting)"
                OnClose="@HandleBackdropCloseAsync"
                ShowBackdropClose="true">
    <ChildContent>
        <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-3">
                <label for="skill-import-file" class="btn btn-outline btn-sm cursor-pointer" aria-disabled="@(_showWarningsAfterImport ? "true" : "false")">
                    <span class="iconify lucide--file-up size-4" aria-hidden="true"></span>
                    @Loc.GetOrDefault(SettingsTextKeys.SkillsChooseFileButton, "Choose Skill File")
                    <InputFile id="skill-import-file"
                               class="sr-only"
                               OnChange="SelectFileAsync"
                               accept=".md,.zip"
                               disabled="@_showWarningsAfterImport" />
                </label>
                <span class="text-sm @(string.IsNullOrWhiteSpace(_selectedFileName) ? "opacity-60" : "font-medium")">
                    @(string.IsNullOrWhiteSpace(_selectedFileName) ? CommonLoc.GetOrDefault(CommonTextKeys.NoFileSelected, "No file selected") : _selectedFileName)
                </span>
            </div>

            <div role="alert" class="alert alert-info alert-soft">
                <iconify-icon icon="lucide:info"></iconify-icon>
                <div class="space-y-1 text-sm">
                    <p>@Loc.GetOrDefault(SettingsTextKeys.SkillsImporterLimitInfo, "The importer accepts one SKILL.md document or one .zip package up to 10 MB.")</p>
                    <p>@Loc.GetOrDefault(SettingsTextKeys.SkillsImporterZipInfo, "Zip imports may include scripts/, references/, and assets/.")</p>
                </div>
            </div>

            @if (_warnings.Count > 0)
            {
                <div role="alert" class="alert alert-warning alert-soft">
                    <iconify-icon icon="lucide:triangle-alert"></iconify-icon>
                    <div class="space-y-1 text-sm">
                        <div class="font-medium">@Loc.GetOrDefault(SettingsTextKeys.SkillsImportWarningsTitle, "Import warnings")</div>
                        @foreach (string warning in _warnings)
                        {
                            <p>@warning</p>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div role="alert" class="alert alert-error alert-soft">
                    <iconify-icon icon="lucide:circle-alert"></iconify-icon>
                    <span class="min-w-0 break-words whitespace-normal text-sm">@_error</span>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        @if (_showWarningsAfterImport)
        {
            <button class="btn btn-primary btn-sm" @onclick="CloseAfterWarningsAsync">@CommonLoc.GetOrDefault(CommonTextKeys.Close, "Close")</button>
        }
        else
        {
            <button class="btn btn-ghost btn-sm" disabled="@_isImporting" @onclick="CancelAsync">@CommonLoc.GetOrDefault(CommonTextKeys.Cancel, "Cancel")</button>
            <button class="btn btn-primary btn-sm"
                    disabled="@(_selectedFile is null || _isImporting)"
                    @onclick="ImportAsync">
                @if (_isImporting)
                {
                    <span class="loading loading-spinner loading-xs"></span>
                }
                @CommonLoc.GetOrDefault(CommonTextKeys.Import, "Import")
            </button>
        }
    </FooterContent>
</AppDialogShell>

@code {
    private const long MaxImportFileSize = SkillImportLimits.MaxUploadSizeBytes;

    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;

    private IBrowserFile? _selectedFile;
    private string _selectedFileName = string.Empty;
    private string? _error;
    private bool _isImporting;
    private ImportedSkillResult? _importedResult;
    private List<string> _warnings = [];

    private bool _showWarningsAfterImport => _importedResult is not null && _warnings.Count > 0;

    private Task SelectFileAsync(InputFileChangeEventArgs args)
    {
        if (_showWarningsAfterImport)
        {
            return Task.CompletedTask;
        }

        _error = null;
        _selectedFile = null;
        _selectedFileName = string.Empty;

        if (args.File is null)
        {
            return Task.CompletedTask;
        }

        IBrowserFile file = args.File;
        _selectedFileName = file.Name;

        string extension = Path.GetExtension(file.Name);
        if (!extension.Equals(".md", StringComparison.OrdinalIgnoreCase) &&
            !extension.Equals(".zip", StringComparison.OrdinalIgnoreCase))
        {
            _error = Loc.GetOrDefault(SettingsTextKeys.SkillsUnsupportedFileTypeError, "Only .md and .zip files are supported.");
            return Task.CompletedTask;
        }

        if (file.Size > MaxImportFileSize)
        {
            _error = FormatCommonText(CommonTextKeys.FileTooLarge, "File is too large. Maximum size is {0}.", ByteSize.Format(MaxImportFileSize));
            return Task.CompletedTask;
        }

        _selectedFile = file;
        return Task.CompletedTask;
    }

    private async Task ImportAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _error = null;
        _isImporting = true;

        try
        {
            await using Stream stream = _selectedFile.OpenReadStream(MaxImportFileSize);
            ImportedSkillResult result = await SettingsApiClient.ImportSkillAsync(_selectedFile.Name, stream);

            _importedResult = result;
            _warnings = result.Warnings.ToList();
            ToastService.Show(FormatSettingsText(SettingsTextKeys.SkillsImportedToast, "Skill '{0}' imported.", result.Name), ToastType.Success);

            if (_warnings.Count == 0)
            {
                DialogInstance.Close(DialogResult.Ok, result);
            }
        }
        catch (SkillImportValidationException ex)
        {
            Logger.LogWarning(ex, "Rejected skill import '{FileName}'.", _selectedFile.Name);
            _error = Loc.GetOrDefault(
                SettingsTextKeys.SkillsInvalidImportFileError,
                "The file does not seem to be a valid skill file. Import a SKILL.md file or a .zip package that contains one skill.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import skill '{FileName}'.", _selectedFile.Name);
            _error = ex.Message;
        }
        finally
        {
            _isImporting = false;
        }
    }

    private Task CloseAfterWarningsAsync()
    {
        DialogInstance.Close(DialogResult.Ok, _importedResult);
        return Task.CompletedTask;
    }

    private Task CancelAsync()
    {
        DialogInstance.Close<ImportedSkillResult>(DialogResult.Cancel, null);
        return Task.CompletedTask;
    }

    private Task HandleBackdropCloseAsync()
    {
        return _showWarningsAfterImport
            ? CloseAfterWarningsAsync()
            : CancelAsync();
    }

    private string FormatSettingsText(string key, string fallback, params object?[] args)
    {
        return string.Format(CultureInfo.CurrentCulture, Loc.GetOrDefault(key, fallback), args);
    }

    private string FormatCommonText(string key, string fallback, params object?[] args)
    {
        return string.Format(CultureInfo.CurrentCulture, CommonLoc.GetOrDefault(key, fallback), args);
    }
}
