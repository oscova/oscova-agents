@using System.Globalization
@using Oscova.Agents.Core.ApiContracts.Credentials
@using Oscova.Agents.Core.Secrets.Credentials
@using Oscova.Agents.Core.Utils
@inject SettingsApiClient SettingsApiClient
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastService ToastService
@inject IStringLocalizer<SettingsText> Loc
@inject IStringLocalizer<CommonText> CommonLoc

@* Edits a credential without expanding the settings page below the user's current scroll position. *@
<AppDialogShell Title="@DialogTitle"
                Subtitle="@(Loc.GetOrDefault(SettingsTextKeys.CredentialsEncryptionDescription, "Secret values stay encrypted at rest and are never shown after save."))"
                Icon="lucide:key-round"
                MaxWidthClass="max-w-2xl"
                HelpTopic="@HelpTopics.CredentialEditor"
                CloseResult="@DialogResult.Cancel"
                CanClose="@(!_isSaving)">
    <ChildContent>
        @* Keep the submitted values stable until the dialog finishes saving. *@
        <fieldset disabled="@_isSaving">
        @if (_editor is not null)
        {
            <div class="space-y-5">
                @if (!string.IsNullOrWhiteSpace(_validationMessage))
                {
                    <div class="alert alert-error alert-soft">
                        <iconify-icon icon="lucide:alert-circle"></iconify-icon>
                        <span>@_validationMessage</span>
                    </div>
                }

                <fieldset class="fieldset w-full">
                    <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.CredentialsAliasLabel, "Name") <span class="text-error">*</span></legend>
                    <label class="input w-full">
                        <span class="iconify lucide--id-card text-base-content/60 size-4.5"></span>
                        <input id="credential-alias"
                               aria-label="@Loc.GetOrDefault(SettingsTextKeys.CredentialsAliasLabel, "Name")"
                               class="grow focus:outline-0"
                               @bind="_editor.Alias"
                               readonly="@(!_editor.IsFreeForm)"
                               placeholder="@Loc.GetOrDefault(SettingsTextKeys.CredentialsAliasPlaceholder, "LangSearch API")" />
                    </label>
                </fieldset>

                <fieldset class="fieldset w-full">
                    <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.Description, "Description")</legend>
                    @if (_editor.IsFreeForm)
                    {
                        <textarea dir="auto" class="textarea textarea-bordered min-h-24 w-full"
                                  aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.Description, "Description")"
                                  @bind="_editor.Description"
                                  placeholder="@Loc.GetOrDefault(SettingsTextKeys.CredentialsDescriptionPlaceholder, "What this credential is used for")"></textarea>
                    }
                    else if (!string.IsNullOrWhiteSpace(_editor.Description))
                    {
                        <p dir="auto" class="text-sm opacity-70">@_editor.Description</p>
                    }
                </fieldset>

                <div class="space-y-4">
                    @foreach (var field in _editor.Fields)
                    {
                        <div class="space-y-2 rounded-box border border-base-300 p-4">
                            <div class="font-medium">
                                @GetFieldLabel(_editor, field)
                                @if (field.IsRequired)
                                {
                                    <span class="text-error">*</span>
                                }
                            </div>

                            <div class="flex flex-wrap gap-4">
                                <label class="label cursor-pointer gap-2">
                                    <input type="radio"
                                           class="radio radio-sm"
                                           name="source-@field.Name"
                                           checked="@(field.Source != CredentialFieldSource.Env)"
                                           @onchange="@(() => field.Source = CredentialFieldSource.Stored)" />
                                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.CredentialsStoredValueOption, "Enter a value")</span>
                                </label>
                                @if (_canUseEnvironment)
                                {
                                <label class="label cursor-pointer gap-2">
                                    <input type="radio"
                                           class="radio radio-sm"
                                           name="source-@field.Name"
                                           checked="@(field.Source == CredentialFieldSource.Env)"
                                           @onchange="@(() => field.Source = CredentialFieldSource.Env)" />
                                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.CredentialsEnvironmentValueOption, "Use an environment variable")</span>
                                </label>
                                }
                            </div>

                            @if (field.Source == CredentialFieldSource.Env)
                            {
                                <AutocompleteInput Suggestions="@_environmentVariableNames"
                                                   @bind-Value="field.EnvVariable"
                                                   AriaLabel="@(Loc.GetOrDefault(SettingsTextKeys.CredentialsEnvironmentValueOption, "Use an environment variable"))"
                                                   Placeholder="@(Loc.GetOrDefault(SettingsTextKeys.CredentialsEnvironmentVariablePlaceholder, "ENVIRONMENT_VARIABLE"))"
                                                   IconClass="lucide--terminal" />
                                <p class="label text-xs opacity-70">@Loc.GetOrDefault(SettingsTextKeys.CredentialsEnvironmentVariableHint, "The value is read from this environment variable at runtime.")</p>
                            }
                            else
                            {
                                <label class="input w-full">
                                    <span class="iconify lucide--lock text-base-content/60 size-4.5"></span>
                                    <input id="credential-value-@field.Name"
                                           aria-label="@GetFieldLabel(_editor, field)"
                                           class="grow focus:outline-0"
                                           type="@(field.IsSecret ? "password" : "text")"
                                           @bind="field.Value"
                                           placeholder="@(field.HasStoredValue
                                               ? Loc.GetOrDefault(SettingsTextKeys.CredentialsSecretValueEditPlaceholder, "Leave blank to keep the current value")
                                               : Loc.GetOrDefault(SettingsTextKeys.CredentialsStoredValueOption, "Enter a value"))" />
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>
        }
            </fieldset>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost btn-sm" disabled="@_isSaving" @onclick="Cancel">
            @CommonLoc.GetOrDefault(CommonTextKeys.Cancel, "Cancel")
        </button>
        <button type="button" class="btn btn-primary btn-sm" disabled="@(_isSaving || _editor is null)" @onclick="SaveAsync">
            @if (_isSaving)
            {
                <span class="loading loading-spinner loading-sm mr-2"></span>
                <span role="status">@CommonLoc.GetOrDefault(CommonTextKeys.GovernanceApplying, "Stopping affected work and applying changes…")</span>
            }
            <span class="iconify lucide--save size-4" aria-hidden="true"></span>
            @Loc.GetOrDefault(SettingsTextKeys.CredentialsSaveButton, "Save Credential")
        </button>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;

    private CredentialEditorModel? _editor;
    private IReadOnlyList<string> _environmentVariableNames = [];
    private bool _canUseEnvironment;
    private bool _isSaving;
    private string? _validationMessage;

    private string DialogTitle => _editor?.IsNew == false
        ? Loc.GetOrDefault(SettingsTextKeys.CredentialsEditCredentialTitle, "Edit Credential")
        : Loc.GetOrDefault(SettingsTextKeys.CredentialsAddCredentialTitle, "Add Credential");

    protected override async Task OnInitializedAsync()
    {
        _canUseEnvironment = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        if (_canUseEnvironment) { _environmentVariableNames = EnvironmentUtil.GetEnvironmentVariableNames(); }
        var credentialKey = DialogInstance.Get<string?>("CredentialKey", null);
        var isFreeForm = DialogInstance.Get<bool>("IsFreeForm", true);

        if (string.IsNullOrWhiteSpace(credentialKey))
        {
            _editor = BuildNewEditor();
            return;
        }

        var slot = await SettingsApiClient.GetCredentialAsync(credentialKey);
        if (slot is null)
        {
            ToastService.Show(Loc.GetOrDefault(SettingsTextKeys.CredentialsNotFoundToast, "Credential not found."), ToastType.Warning);
            DialogInstance.Close(DialogResult.Cancel);
            return;
        }

        _editor = BuildEditor(slot, isFreeForm);
    }

    private async Task SaveAsync()
    {
        if (_editor is null)
        {
            return;
        }

        _validationMessage = ValidateEditor(_editor);
        if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            return;
        }

        _isSaving = true;
        try
        {
            var request = new SaveCredentialRequest
            {
                CredentialKey = _editor.CredentialKey,
                Alias = _editor.Alias.Trim(),
                Description = _editor.Description.NormalizeOptional(),
                Fields = [.. _editor.Fields.Select(ToFieldContract)]
            };

            if (!await ConfigurationChangeDialog.ApplyAsync(DialogService, CommonLoc, async confirmed =>
            {
                request.ConfirmInterruptions = confirmed;
                var error = await SettingsApiClient.SaveCredentialAsync(request);
                if (error?.RequiresInterruptionConfirmation == true) { return false; }
                if (error is not null) { throw new InvalidOperationException(error.Message); }
                return true;
            })) { return; }

            ToastService.Show(Loc.GetOrDefault(SettingsTextKeys.CredentialsUpdatedToast, "Credential saved."), ToastType.Success);
            DialogInstance.Close(DialogResult.Ok);
        }
        catch (Exception ex)
        {
            _validationMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        if (!_isSaving)
        {
            DialogInstance.Close(DialogResult.Cancel);
        }
    }

    private CredentialEditorModel BuildNewEditor()
    {
        return new CredentialEditorModel
        {
            IsNew = true,
            IsFreeForm = true,
            CredentialKey = string.Empty,
            Alias = string.Empty,
            Label = Loc.GetOrDefault(SettingsTextKeys.CredentialsNewCredentialLabel, "New credential"),
            Description = null,
            Fields =
            [
                new CredentialFieldEditorModel
                {
                    Name = CredentialFieldSets.FreeFormFieldName,
                    Label = Loc.GetOrDefault(SettingsTextKeys.CredentialsValueFieldLabel, "Value"),
                    IsSecret = true,
                    IsRequired = true,
                    Source = CredentialFieldSource.Stored
                }
            ]
        };
    }

    private string GetFieldLabel(CredentialEditorModel editor, CredentialFieldEditorModel field)
    {
        return editor.IsFreeForm
            ? Loc.GetOrDefault(SettingsTextKeys.CredentialsValueFieldLabel, "Value")
            : field.Label;
    }

    private static CredentialEditorModel BuildEditor(CredentialSlotContract slot, bool isFreeForm)
    {
        return new CredentialEditorModel
        {
            IsNew = !slot.RowExists,
            IsFreeForm = isFreeForm,
            CredentialKey = slot.Key,
            Alias = isFreeForm ? slot.Alias ?? string.Empty : slot.Label,
            Label = slot.Label,
            Description = slot.Description,
            Fields = [.. slot.Fields.Select(field =>
            {
                var isEnvSource = field.Source == CredentialFieldSource.Env;
                return new CredentialFieldEditorModel
                {
                    Name = field.Name,
                    Label = field.Label,
                    IsSecret = field.IsSecret,
                    IsRequired = field.IsRequired,
                    Source = isEnvSource ? CredentialFieldSource.Env : CredentialFieldSource.Stored,
                    Value = string.Empty,
                    EnvVariable = string.IsNullOrWhiteSpace(field.EnvVariable)
                        ? field.DefaultEnvVariable ?? string.Empty
                        : field.EnvVariable,
                    HasStoredValue = !isEnvSource && field.IsSet
                };
            })]
        };
    }

    private static SaveCredentialFieldContract ToFieldContract(CredentialFieldEditorModel field)
    {
        var isEnv = field.Source == CredentialFieldSource.Env;
        return new SaveCredentialFieldContract
        {
            Name = field.Name,
            Source = isEnv ? CredentialFieldSource.Env : CredentialFieldSource.Stored,
            Value = isEnv ? null : field.Value,
            EnvVariable = isEnv ? field.EnvVariable.Trim() : null
        };
    }

    private string? ValidateEditor(CredentialEditorModel editor)
    {
        if (string.IsNullOrWhiteSpace(editor.Alias))
        {
            return Loc.GetOrDefault(SettingsTextKeys.CredentialsAliasRequiredError, "A credential name is required.");
        }

        foreach (var field in editor.Fields.Where(field => field.IsRequired))
        {
            if (field.Source == CredentialFieldSource.Env)
            {
                if (string.IsNullOrWhiteSpace(field.EnvVariable))
                {
                    return string.Format(
                        CultureInfo.CurrentCulture,
                        Loc.GetOrDefault(SettingsTextKeys.CredentialsEnvironmentVariableRequiredError, "Enter an environment variable name for {0}."),
                        GetFieldLabel(editor, field));
                }
            }
            else if (string.IsNullOrWhiteSpace(field.Value) && !field.HasStoredValue)
            {
                return string.Format(
                    CultureInfo.CurrentCulture,
                    Loc.GetOrDefault(SettingsTextKeys.CredentialsValueRequiredError, "Enter a value for {0}."),
                    GetFieldLabel(editor, field));
            }
        }

        return null;
    }

    private sealed class CredentialEditorModel
    {
        public bool IsNew { get; set; }
        public bool IsFreeForm { get; set; }
        public string CredentialKey { get; set; } = string.Empty;
        public string Alias { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string? Description { get; set; }
        public IReadOnlyList<CredentialFieldEditorModel> Fields { get; set; } = [];
    }

    private sealed class CredentialFieldEditorModel
    {
        public string Name { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public bool IsSecret { get; set; }
        public bool IsRequired { get; set; }
        public CredentialFieldSource Source { get; set; } = CredentialFieldSource.Stored;

        /// <summary>A newly typed value; blank means "keep current" for an already-set stored secret.</summary>
        public string Value { get; set; } = string.Empty;

        public string EnvVariable { get; set; } = string.Empty;

        /// <summary>True only when a stored secret value is on file and blank input should preserve it.</summary>
        public bool HasStoredValue { get; set; }
    }
}
