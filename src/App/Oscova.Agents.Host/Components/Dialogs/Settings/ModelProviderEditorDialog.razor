                            <span>-2</span>
                            <span>-1</span>
                            <span>0</span>
                            <span>1</span>
                            <span>2</span>
                        </div>
                        <p class="text-xs mt-2 opacity-60">
                            @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersFrequencyPenaltyDescription, "Positive values discourage repetition; negative values increase it.")
                        </p>
                    </div>

                    <div class="form-control">
                        <div class="flex items-center justify-between">
                            <label class="label pl-0" for="presence-penalty">
                                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersPresencePenaltyLabel, "Presence Penalty")</span>
                                <span class="label-text-alt">@FormatNullable(_config.ChatOptions.PresencePenalty)</span>
                            </label>
                            <button type="button"
                                    class="btn btn-ghost btn-xs"
                                    disabled="@(_config.ChatOptions.PresencePenalty is null)"
                                    @onclick="() => UpdateChatOptions(o => o.PresencePenalty = null)">
                                @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersClearButton, "Clear")
