    private async Task DownloadSelectedProviderModelAsync()
    {
        if (!SupportsSelectedProviderDownload || string.IsNullOrWhiteSpace(_config.ModelId) || IsCurrentModelInstalled)
        {
            return;
        }

        var requestConfig = _config.Clone();
        requestConfig.ModelId = _config.ModelId.Trim();
        _config.ModelId = requestConfig.ModelId;
        _modelDownloadError = null;
        var parameters = new Dictionary<string, object?>
        {
            ["Config"] = requestConfig
        };
        // The optional provider capability uses the typed ID, independent of model discovery.
        var result = await DialogService.ShowAsync<ProviderModelDownloadDialog, string>(parameters);
        if (!string.IsNullOrWhiteSpace(result.Data))
        {
            _modelDownloadError = FormatSettingsText(SettingsTextKeys.ModelProvidersDownloadFailedMessage,
                "Could not download model '{0}': {1}", requestConfig.ModelId, result.Data);
        }
        if (!result.IsOk)
        {
            return;
        }

        await FetchAvailableModelsAsync();
        _selectedAvailableModel = _availableRemoteModels.Any(model =>
            string.Equals(model.Id, _config.ModelId, StringComparison.Ordinal))
                ? _config.ModelId ?? string.Empty
                : string.Empty;
        await ApplySelectedAvailableModelAsync();
    }

    private Task ApplySelectedLocalModelAsync()
    {
        _config.ModelId = string.IsNullOrWhiteSpace(_selectedLocalModel)
            ? string.Empty
            : _selectedLocalModel;
        RefreshLocalModelSizing();

        return Task.CompletedTask;
    }

    private async Task RefreshLocalModelsAsync()
    {
        _availableLocalModels = (await ManagementApiClient.GetLocalModelsAsync()).ToList();
        SyncSelectedLocalModel();
        RefreshLocalModelSizing();
    }

    private void SyncSelectedLocalModel()
    {
        if (_config.Type != ModelProviderKeys.Local)
        {
            _selectedLocalModel = string.Empty;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_config.ModelId) &&
            _availableLocalModels.Contains(_config.ModelId, StringComparer.Ordinal))
        {
            _selectedLocalModel = _config.ModelId;
            return;
        }

        _selectedLocalModel = string.Empty;

        if (!string.IsNullOrWhiteSpace(_config.ModelId))
        {
            _config.ModelId = string.Empty;
        }
    }

    private async Task StartModelDownloadAsync()
    {
        if (string.IsNullOrWhiteSpace(_downloadUrl))
        {
            return;
        }

        _downloadUrlError = null;
        var dir = PathUtil.GgufModelsPath;
        try
        {
            Directory.CreateDirectory(dir);
        }
        catch
        {
            return;
        }

        // Normalize HuggingFace blob URLs to resolve URLs (blob returns HTML, resolve returns the file)
        var downloadUrl = _downloadUrl.Trim();
        if (downloadUrl.Contains("huggingface.co/") && downloadUrl.Contains("/blob/"))
        {
            downloadUrl = downloadUrl.Replace("/blob/", "/resolve/");
        }

        // Validate the URL before use
        if (!Uri.TryCreate(downloadUrl, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _downloadUrlError = Loc.GetOrDefault(SettingsTextKeys.ModelProvidersInvalidDownloadUrl, "Please enter a valid http or https URL.");
            return;
        }

        // Derive filename from URL
        var fileName = Path.GetFileName(uri.LocalPath);
        if (string.IsNullOrWhiteSpace(fileName) || !fileName.EndsWith(".gguf", StringComparison.OrdinalIgnoreCase))
        {
            fileName = "model.gguf";
        }

        var destinationPath = Path.Combine(dir, fileName);

        var parameters = new Dictionary<string, object?>
        {
            ["Url"] = downloadUrl,
            ["DestinationPath"] = destinationPath
        };

        var result = await DialogService.ShowAsync<DownloadProgressDialog>(parameters);

        if (result == DialogResult.Ok)
        {
            _downloadUrl = string.Empty;
            _config.ModelId = fileName;
            _selectedLocalModel = fileName;
            await RefreshLocalModelsAsync();
        }
    }

    /// <summary>Resolves sizing from the current file selection or fetched endpoint and model.</summary>
    private ModelSizing? GetCurrentModelSizing()
    {
        if (_config.Type == ModelProviderKeys.Local)
        {
            return string.Equals(_localSizingModelId, _config.ModelId, StringComparison.Ordinal)
                ? _localModelSizing
                : null;
        }

        if (_config.Type != ModelProviderKeys.Ollama || _isFetchingAvailableModels
            || _availableModelsSource is not { } source
            || source.Type != _config.Type || source.BaseUrl != _config.BaseUrl)
        {
            return null;
        }

        var descriptor = _availableRemoteModels.FirstOrDefault(model =>
            string.Equals(model.Id, _config.ModelId, StringComparison.Ordinal));
        return descriptor is { SizeBytes: > 0, KvCacheBytesPerToken: > 0 }
            ? new ModelSizing(descriptor.SizeBytes.Value, descriptor.KvCacheBytesPerToken.Value)
            : null;
    }

    /// <summary>Reads the selected local file once when selection or the local list changes.</summary>
    private void RefreshLocalModelSizing()
    {
        _localModelSizing = null;
        _localSizingModelId = _config.ModelId;
        if (_config.Type != ModelProviderKeys.Local || string.IsNullOrWhiteSpace(_config.ModelId)
            || !_availableLocalModels.Contains(_config.ModelId, StringComparer.Ordinal))
        {
            return;
        }

        _localModelSizing = GgufMetadataReader.TryRead(
            Path.Combine(PathUtil.GgufModelsPath, _config.ModelId),
            Logger);
    }

