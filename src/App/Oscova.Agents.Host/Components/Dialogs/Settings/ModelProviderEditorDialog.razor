@using Microsoft.Extensions.AI
@using Oscova.Agents.Llm
@using Oscova.Agents.Core.ApiContracts.ModelProviders
@using Oscova.Agents.Core.Secrets
@using Oscova.Agents.Core.Settings
@using Oscova.Agents.Infrastructure.Utils
@using System.Globalization
@using Oscova.Agents.Plugins
@using Oscova.Agents.Core.Llm
@using Oscova.Agents.Core.Hardware
@implements IDisposable
@inject PluginSettingsCatalog PluginPanels
@inject IModelProviderCatalog Providers
@inject HostHardwareProbe HardwareProbe
@inject ILogger<ModelProviderEditorDialog> Logger
@inject IDialogService DialogService
@inject SettingsApiClient SettingsApiClient
@inject ManagementApiClient ManagementApiClient
@inject IStringLocalizer<SettingsText> Loc
@inject IStringLocalizer<CommonText> CommonLoc

<AppDialogShell Title="@(_managingCredentials ? Loc.GetOrDefault(SettingsTextKeys.CredentialsSavedCredentialsTitle, "Saved Credentials") : DialogTitle)"
                MaxWidthClass="max-w-2xl"
                HelpTopic="@(_managingCredentials ? HelpTopics.SettingsCredentials : HelpTopics.ModelProviderEditor)"
                OnClose="CloseAsync">
    <ChildContent>
        @if (_managingCredentials)
        {
            <SettingsCredentialsSection />
        }
        else
        {
        <div role="tablist" class="tabs tabs-border mb-4">
            <button type="button" role="tab" aria-selected="@(_activeTab == 0 ? "true" : "false")" class="tab @(_activeTab == 0 ? "tab-active" : "")" @onclick="() => _activeTab = 0">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDialogTabProvider, "Provider")</button>
            <button type="button" role="tab" aria-selected="@(_activeTab == 1 ? "true" : "false")" class="tab @(_activeTab == 1 ? "tab-active" : "")" @onclick="() => _activeTab = 1">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDialogTabChatOptions, "Chat Options")</button>
        </div>

        @if (_activeTab == 0)
        {
            <div class="space-y-4">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="form-control w-full">
                        <label class="label" for="provider-type">
                            <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersProviderTypeLabel, "Provider Type")</span>
                        </label>
                        <select id="provider-type" class="select select-bordered w-full"
                                @bind="_config.Type"
                                @bind:after="HandleProviderTypeChangedAsync">
                            @foreach (var type in _availableProviderTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="provider-name">
                            <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersProviderNameLabel, "Provider Name") <span class="text-error">*</span></span>
                        </label>
                        <label class="input w-full validator">
                            <span class="iconify lucide--id-card text-base-content/60 size-4.5"></span>
                            <input id="provider-name" class="grow focus:outline-0"
                                   @bind="_config.Name"
                                   required
                                   placeholder="@(Loc.GetOrDefault(SettingsTextKeys.ModelProvidersProviderNamePlaceholder, "e.g., Work OpenAI"))" />
                        </label>
                        <div class="validator-hint hidden">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersProviderNameRequired, "Provider name is required")</div>
                    </div>
                </div>

                @if (_config.Type == ModelProviderKeys.Local)
                {
                    <div class="form-control w-full">
                        <label class="label" for="local-model">
                            <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersModelFileLabel, "Model File") <span class="text-error">*</span></span>
                        </label>
                        <div class="flex gap-2">
                            <select id="local-model" class="select select-bordered flex-1"
                                    @bind="_selectedLocalModel"
                                    @bind:after="ApplySelectedLocalModelAsync">
                                @if (!_availableLocalModels.Any())
                                {
                                    <option disabled value="">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersNoGgufFilesOption, "No GGUF files found")</option>
                                }
                                else
                                {
                                    <option value="">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSelectModelPlaceholder, "Select a model...")</option>
                                    @foreach (var model in _availableLocalModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-square btn-sm" @onclick="RefreshLocalModelsAsync" title="@(CommonLoc.GetOrDefault(CommonTextKeys.Refresh, "Refresh"))">
                                <iconify-icon icon="lucide:refresh-cw"></iconify-icon>
                            </button>
                        </div>
                        <label class="label min-w-0 items-start">
                            <span class="label-text-alt text-xs whitespace-normal break-all opacity-70">@FormatSettingsText(SettingsTextKeys.ModelProvidersGgufFilesLocation, "GGUF files in {0}", PathUtil.GgufModelsPath)</span>
                        </label>
                    </div>

                    <div class="divider my-1 text-xs opacity-60">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDownloadSectionTitle, "Download a GGUF model")</div>

                    <div class="form-control w-full">
                        <label class="label" for="download-url">
                            <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDownloadUrlLabel, "Download URL")</span>
                        </label>
                        <div class="flex gap-2">
                            <label class="input flex-1">
                                <span class="iconify lucide--link text-base-content/60 size-4.5"></span>
                                <input id="download-url" class="grow focus:outline-0"
                                       @bind="_downloadUrl"
                                       @bind:event="oninput"
                                       placeholder="@(Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDownloadUrlPlaceholder, "https://huggingface.co/.../model.gguf"))" />
                            </label>
                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    disabled="@(string.IsNullOrWhiteSpace(_downloadUrl))"
                                    @onclick="StartModelDownloadAsync">
                                <span class="iconify lucide--download size-4" aria-hidden="true"></span> @CommonLoc.GetOrDefault(CommonTextKeys.Download, "Download")
                            </button>
                        </div>
                        <label class="label">
                            <span class="label-text-alt text-xs opacity-70">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDownloadUrlHelp, "Paste a direct link to a GGUF file (e.g. from HuggingFace)")</span>
                        </label>
                        @if (_downloadUrlError is not null)
                        {
                            <p class="text-xs text-error mt-1">@_downloadUrlError</p>
                        }
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        @if (ShouldShowBaseUrlField())
                        {
                            <div class="form-control w-full md:col-span-2">
                                <label class="label" for="base-url">
                                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersBaseUrlLabel, "Base URL")</span>
                                </label>
                                <label class="input w-full validator">
                                    <span class="iconify lucide--link text-base-content/60 size-4.5"></span>
                                    <input id="base-url" class="grow focus:outline-0"
                                           @bind="_config.BaseUrl"
                                           type="url"
                                           placeholder="@GetBaseUrlPlaceholder()" />
                                </label>
                                <div class="validator-hint hidden mt-1 text-xs leading-snug whitespace-normal break-words">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersBaseUrlInvalid, "Please enter a valid URL")</div>
                                <label class="label min-w-0 items-start py-1">
                                    <span class="label-text-alt text-xs leading-snug whitespace-normal break-words opacity-70">@GetBaseUrlHelpText()</span>
                                </label>
                            </div>
                        }

                        <div class="form-control w-full md:col-span-2">
                            <label class="label" for="model-id">
                                <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersModelIdLabel, "Model ID") <span class="text-error">*</span></span>
                            </label>
                            <div class="validator grid grid-cols-1 sm:flex items-center gap-2">
                                <label class="input w-full min-w-0 validator">
                                    <span class="iconify lucide--box text-base-content/60 size-4.5"></span>
                                    <input id="model-id" class="min-w-0 grow focus:outline-0"
                                           @bind="_config.ModelId" @bind:event="oninput" @bind:after="() => _modelDownloadError = null"
                                           required
                                           placeholder="@GetModelIdPlaceholder()" />
                                </label>
                                @if (SupportsSelectedProviderDownload)
                                {
                                    <button type="button" class="btn btn-outline btn-sm h-10 w-40 whitespace-normal shrink-0 ml-auto"
                                            disabled="@(string.IsNullOrWhiteSpace(_config.ModelId) || IsCurrentModelInstalled)"
                                            @onclick="DownloadSelectedProviderModelAsync">
                                        <span class="iconify lucide--download size-4 shrink-0" aria-hidden="true"></span>
                                        @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDownloadFetchedModelButton, "Download model")
                                    </button>
                                }
                            </div>
                            <div class="validator-hint hidden mt-1 text-xs leading-snug whitespace-normal break-words">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersModelIdRequired, "Model ID is required")</div>
                            <label class="label min-w-0 items-start py-1">
                                <span class="label-text-alt text-xs leading-snug whitespace-normal break-words opacity-70">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersModelIdHelp, "Type any model ID manually, or fetch provider models below.")</span>
                            </label>
                            @if (SupportsSelectedProviderDownload && !string.IsNullOrWhiteSpace(_modelDownloadError))
                            {
                                <div class="text-xs text-error break-words mt-2" role="alert">@_modelDownloadError</div>
                            }
                        </div>
                    </div>

                    <div class="card bg-base-200/40 border border-base-300">
                        <div class="card-body gap-3 p-4">
                            <div class="grid grid-cols-1 sm:flex flex-wrap items-center justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <h5 class="font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersProviderModelsTitle, "Provider Models")</h5>
                                    <p class="text-xs opacity-70">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersProviderModelsDescription, "Fetch available or suggested models, then copy one into the Model ID field.")</p>
                                </div>
                                <button type="button"
                                        class="btn btn-outline btn-sm w-40 whitespace-normal shrink-0 ml-auto"
                                        disabled="@_isFetchingAvailableModels"
                                        @onclick="FetchAvailableModelsAsync">
                                    @if (_isFetchingAvailableModels)
                                    {
                                        <span class="loading loading-spinner loading-sm mr-2"></span>
                                    }
                                    <span class="iconify lucide--refresh-cw size-4" aria-hidden="true"></span>@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersFetchModelsButton, "Fetch models")
                                </button>
                            </div>

                            @if (_availableRemoteModels.Count > 0)
                            {
                                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                    <div class="form-control w-full md:col-span-2">
                                        <label class="label">
                                            <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersChooseFetchedModelLabel, "Choose a fetched model")</span>
                                            <span class="label-text-alt">@FormatSettingsText(SettingsTextKeys.ModelProvidersAvailableModelsLoadedLabel, "{0} loaded", _availableRemoteModels.Count)</span>
                                        </label>
                                        <SearchableSelect Options="@BuildModelOptions(_availableRemoteModels)"
                                                          Value="@_selectedAvailableModel"
                                                          ValueChanged="@OnFetchedModelChangedAsync"
                                                          Placeholder="@(Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSelectFetchedModelPlaceholder, "Select a fetched model..."))"
                                                          AriaLabel="@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersChooseFetchedModelLabel, "Choose a fetched model")" />
                                    </div>

                                    @if (SelectedAvailableModel is { } selectedModel && SupportsSelectedProviderDownload)
                                    {
                                        <div class="md:col-span-2 space-y-2 rounded-box border border-base-300 bg-base-100 p-3">
                                            <p class="text-xs" role="status">@(EstimatedFootprint is { } footprint
                                                ? Loc[SettingsTextKeys.ModelProvidersMemoryFootprint, ByteSize.Format(footprint)]
                                                : Loc[SettingsTextKeys.ModelProvidersMemoryFitUnknown])</p>
                                            @if (!string.IsNullOrWhiteSpace(selectedModel.License))
                                            {
                                                <p class="text-sm">
                                                    <span class="font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersModelLicenseLabel, "License"):</span>
                                                    <span class="whitespace-pre-wrap break-words"> @selectedModel.License</span>
                                                </p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedModel.LicenseDescription))
                                            {
                                                <p class="text-xs whitespace-pre-wrap break-words opacity-80">@selectedModel.LicenseDescription</p>
                                            }

                                            @if (selectedModel.IsInstalled == true)
                                            {
                                                <span class="badge badge-success">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersInstalledModelBadge, "Installed")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_availableModelsMessage))
                            {
                                <div class="text-xs break-words @(_availableModelsMessageIsError ? "text-error" : "text-success")" role="status">
                                    @if (_availableModelsMessageIsError)
                                    {
                                        <p>@Loc[SettingsTextKeys.ModelProvidersFetchRecovery]</p>
                                    }
                                    <p dir="auto">@_availableModelsMessage</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="endpoint-scope">
                            <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersEndpointScopeLabel, "Endpoint scope")</span>
                        </label>
                        <select id="endpoint-scope" class="select select-bordered w-full" @bind="LocalEndpointSelection">
                            <option value="auto">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersEndpointScopeAuto, "Auto-detect")</option>
                            <option value="local">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersEndpointScopeLocal, "Treat as local")</option>
                            <option value="cloud">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersEndpointScopeCloud, "Treat as cloud")</option>
                        </select>
                        <label class="label min-w-0 items-start py-1">
                            <span class="label-text-alt text-xs leading-snug whitespace-normal break-words opacity-70">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersEndpointScopeDescription, "Use this when a custom endpoint is misclassified by Offline mode, such as a LAN gateway or a cloud proxy.")</span>
                        </label>
                    </div>
                    <div class="space-y-3 rounded-box border border-base-300 bg-base-200/40 p-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <h5 class="font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersCredentialSectionTitle, "Credential")</h5>
                                <p class="text-xs opacity-70">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersCredentialDescription, "Link this provider to a saved API key instead of storing secrets on the provider itself.")</p>
                            </div>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="OpenCredentialsTab">
                                <span class="iconify lucide--key-round size-4" aria-hidden="true"></span>@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersNewCredentialButton, "Manage credentials")
                            </button>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="saved-api-key">
                                <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSavedApiKeyLabel, "Saved API Key")</span>
                            </label>
                            <select id="saved-api-key" class="select select-bordered w-full" @bind="_config.CredentialKey">
                                <option value="">@CommonLoc.GetOrDefault(CommonTextKeys.NoneOption, "None")</option>
                                @foreach (var credential in _apiKeyCredentials)
                                {
                                    <option value="@credential.CredentialKey">@FormatCredentialOption(credential)</option>
                                }
                            </select>
                            <label class="label">
                                <span class="label-text-alt text-xs opacity-70">@GetCredentialHelpText()</span>
                            </label>
                        </div>
                    </div>
                }

                <div class="divider my-2"></div>

                <div>
                    <h4 class="font-semibold mb-3">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersModelConfigurationTitle, "Model Configuration")</h4>

                    <div class="space-y-4">
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-3">
                                    <input type="checkbox" class="checkbox" @bind="_config.SupportsImages" />
                                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSupportsImagesLabel, "Supports images")</span>
                                </label>
                            </div>
                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-3">
                                    <input type="checkbox" class="checkbox" @bind="_config.SupportsThinking" />
                                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSupportsThinkingLabel, "Supports thinking outputs")</span>
                                </label>
                                @if (_config.Type is ModelProviderKeys.Anthropic or ModelProviderKeys.OpenAI or ModelProviderKeys.Google)
                                {
                                    <label class="label" for="reasoning-effort">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersReasoningEffortLabel, "Reasoning effort")</label>
                                    <select id="reasoning-effort" class="select select-bordered w-full" @bind="ReasoningEffortValue">
                                        <option value="">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersDefaultBadge, "Default")</option>
                                        <option value="None">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersFallbackNoneOption, "None")</option>
                                        <option value="Low">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersReasoningEffortLow, "Low")</option>
                                        <option value="Medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersReasoningEffortMedium, "Medium")</option>
                                        <option value="High">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersReasoningEffortHigh, "High")</option>
                                        @if (_config.Type != ModelProviderKeys.Google)
                                        {
                                            <option value="ExtraHigh">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersReasoningEffortExtraHigh, "Extra high")</option>
                                        }
                                    </select>
                                    <p class="text-xs mt-2 opacity-60">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersReasoningEffortHelp, "Default uses Medium for OpenAI with thinking outputs enabled and the model default otherwise. The selected model must support the chosen effort.")</p>
                                }
                            </div>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="context-window-size">
                                <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersContextWindowSizeLabel, "Context Window Size")</span>
                            </label>
                            <label class="input w-full validator">
                                <span class="iconify lucide--hash text-base-content/60 size-4.5"></span>
                                <input id="context-window-size" class="grow focus:outline-0"
                                       type="number"
                                       min="0"
                                       @bind="_config.ContextWindowSize" />
                            </label>
                            <div class="validator-hint hidden mt-1 text-xs leading-snug whitespace-normal break-words">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersContextWindowSizeInvalid, "Context window size must be positive")</div>
                        </div>

                        @if (ModelFit is { } fit)
                        {
                            <div role="status" class="alert @GetFitAlertClass(fit) alert-soft items-start text-sm">
                                <span class="iconify @GetFitIcon(fit) size-4.5 shrink-0" aria-hidden="true"></span>
                                <span class="min-w-0 whitespace-normal">@GetFitMessage(fit)</span>
                            </div>
                            <p class="text-xs opacity-70">@Loc[SettingsTextKeys.ModelProvidersMemoryFitEstimateHelp]</p>
                            @if (EstimatedFootprint is { } footprint)
                            {
                                <p class="text-xs">@Loc[SettingsTextKeys.ModelProvidersMemoryFootprint, ByteSize.Format(footprint)]</p>
                            }
                        }

                        @foreach (var panel in PluginPanels.Entries.Where(entry => entry.Panel.SlotId == PluginSettingsSlots.ModelProvider && entry.Panel.AssociationId == _config.Type))
                        {
                            <h5 class="font-medium">@Loc[SettingsTextKeys.ModelProvidersAdvancedOptions]</h5>
                            <PluginSettingsPanel Entry="@panel" GetModelProviderSettings="@GetModelProviderSettings" />
                        }

                        @if (_config.Type == ModelProviderKeys.Ollama)
                        {
                            <div class="form-control w-full">
                                <label class="label">
                                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersOllamaKeepAliveLabel, "Keep alive")</span>
                                </label>
                                <label class="input w-full">
                                    <span class="iconify lucide--clock text-base-content/60 size-4.5"></span>
                                    <input class="grow focus:outline-0"
                                           @bind="_config.OllamaKeepAlive"
                                           @bind:event="oninput"
                                           aria-label="@(Loc.GetOrDefault(SettingsTextKeys.ModelProvidersOllamaKeepAliveLabel, "Keep alive"))"
                                           placeholder="5m" />
                                </label>
                                <label class="label min-w-0 items-start py-1">
                                    <span class="label-text-alt text-xs leading-snug whitespace-normal break-words opacity-70">
                                        @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersOllamaKeepAliveHelp, "Optional Ollama duration. Examples: 5m, 1h, -1, or 0. Blank uses the Ollama server default; 0 unloads after the response.")
                                    </span>
                                </label>
                            </div>
                        }

                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersInputCostLabel, "Input price, USD per 1M tokens")</span>
                            </label>
                            <label class="@($"input w-full{(_inputCostHasError ? " input-error" : string.Empty)}")">
                                <span class="iconify lucide--circle-dollar-sign text-base-content/60 size-4.5"></span>
                                <input class="grow focus:outline-0"
                                       type="number"
                                       min="0"
                                       step="any"
                                       value="@_inputCostText"
                                       aria-label="@(Loc.GetOrDefault(SettingsTextKeys.ModelProvidersInputCostLabel, "Input price, USD per 1M tokens"))"
                                       placeholder="0.00"
                                       @oninput="HandleInputCostInput" />
                            </label>
                            @if (_inputCostHasError)
                            {
                                <p class="validator-hint mt-1 text-xs leading-snug whitespace-normal break-words">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersCostPerMillionTokensInvalid, "Enter a non-negative amount or leave blank.")</p>
                            }
                        </div>
                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersOutputCostLabel, "Output price, USD per 1M tokens")</span>
                            </label>
                            <label class="@($"input w-full{(_outputCostHasError ? " input-error" : string.Empty)}")">
                                <span class="iconify lucide--circle-dollar-sign text-base-content/60 size-4.5"></span>
                                <input class="grow focus:outline-0"
                                       type="number"
                                       min="0"
                                       step="any"
                                       value="@_outputCostText"
                                       aria-label="@(Loc.GetOrDefault(SettingsTextKeys.ModelProvidersOutputCostLabel, "Output price, USD per 1M tokens"))"
                                       placeholder="0.00"
                                       @oninput="HandleOutputCostInput" />
                            </label>
                            @if (_outputCostHasError)
                            {
                                <p class="validator-hint mt-1 text-xs leading-snug whitespace-normal break-words">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersCostPerMillionTokensInvalid, "Enter a non-negative amount or leave blank.")</p>
                            }
                            <label class="label min-w-0 items-start py-1">
                                <span class="label-text-alt text-xs leading-snug whitespace-normal break-words opacity-70">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersCostEstimateHelp, "Optional standard rates for dashboard estimates. Cached input uses the input rate. Other charges are excluded.")</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="space-y-6">
                <section class="grid gap-6 md:grid-cols-2">
                    @if (_config.Type != ModelProviderKeys.OpenAI)
                    {
                    <div class="form-control">
                        <div class="flex items-center justify-between">
                            <label class="label pl-0" for="temperature">
                                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersTemperatureLabel, "Temperature")</span>
                                <span class="label-text-alt">@FormatNullable(_config.ChatOptions.Temperature)</span>
                            </label>
                            <button type="button"
                                    class="btn btn-ghost btn-xs"
                                    disabled="@(_config.ChatOptions.Temperature is null)"
                                    @onclick="() => UpdateChatOptions(o => o.Temperature = null)">
                                @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersClearButton, "Clear")
                            </button>
                        </div>
                        <input id="temperature" type="range"
                               min="0"
                               max="2"
                               step="0.01"
                               class="range range-primary"
                               value="@BindConverter.FormatValue(_temperatureValue, CultureInfo.InvariantCulture)"
                               @oninput="HandleTemperatureInput"
                               @onchange="HandleTemperatureChange" />
                        <div class="flex justify-between px-2.5 mt-2 text-xs select-none">
                            <span>0</span>
                            <span>0.5</span>
                            <span>1.0</span>
