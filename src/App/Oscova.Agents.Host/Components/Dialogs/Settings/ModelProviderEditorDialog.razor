    private static double ParseDouble(object? value, double fallback)
    {
        if (value is string text && double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            return parsed;
        }

        return fallback;
    }

    private static bool TryParseDecimal(string text, out decimal value)
    {
        // HTML number inputs return an invariant decimal value in every UI locale.
        return decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);
    }

    private static double ClampDouble(double value, double min, double max) => Math.Min(Math.Max(value, min), max);

