                            <span>0.25</span>
                            <span>0.5</span>
                            <span>0.75</span>
                            <span>1</span>
                        </div>
                        <p class="text-xs mt-2 opacity-60">
                            @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersTopPDescription, "Controls nucleus sampling. Lower values limit token choices.")
                        </p>
                    </div>
                </section>

                @if (_config.Type != ModelProviderKeys.Anthropic)
                {
                <section class="grid gap-6 md:grid-cols-2">
                    <div class="form-control">
                        <div class="flex items-center justify-between">
                            <label class="label pl-0" for="frequency-penalty">
                                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersFrequencyPenaltyLabel, "Frequency Penalty")</span>
                                <span class="label-text-alt">@FormatNullable(_config.ChatOptions.FrequencyPenalty)</span>
                            </label>
                            <button type="button"
                                    class="btn btn-ghost btn-xs"
                                    disabled="@(_config.ChatOptions.FrequencyPenalty is null)"
