    private async Task FetchAvailableModelsAsync()
    {
        _availableModelsMessage = null;
        _availableModelsMessageIsError = false;
        _availableRemoteModels.Clear();
        _availableModelsSource = null;
        _selectedAvailableModel = string.Empty;

        _isFetchingAvailableModels = true;
        var requestConfig = _config.Clone();

        try
        {
            var result = await ManagementApiClient.GetAvailableModelsAsync(requestConfig);
            if (requestConfig.Type != _config.Type || requestConfig.BaseUrl != _config.BaseUrl)
            {
                return;
            }

            _availableRemoteModels = result.Models.ToList();

            if (!result.Success || _availableRemoteModels.Count == 0)
            {
                _availableModelsMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? Loc.GetOrDefault(SettingsTextKeys.ModelProvidersConnectedNoModelsMessage, "Connected successfully, but the provider returned no models. You can still type a model ID manually.")
                    : result.Message;
                _availableModelsMessageIsError = !result.Success;
                return;
            }

            _availableModelsSource = (requestConfig.Type, requestConfig.BaseUrl);
            _availableModelsMessage = FormatSettingsText(SettingsTextKeys.ModelProvidersModelsLoadedMessage, "Loaded {0} models.", _availableRemoteModels.Count);
        }
        catch (Exception ex)
        {
            _availableModelsMessage = ex.Message;
            _availableModelsMessageIsError = true;
        }
        finally
        {
            _isFetchingAvailableModels = false;
        }
    }

    private Task ApplySelectedAvailableModelAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedAvailableModel))
        {
            return Task.CompletedTask;
        }

        _config.ModelId = _selectedAvailableModel;
        _modelDownloadError = null;

        // Pre-fill the typed fields from the descriptor that already arrived with the fetch (no
        // second round-trip). Only non-null metadata is applied; the fields stay user-editable.
        var match = _availableRemoteModels.FirstOrDefault(model =>
            string.Equals(model.Id, _selectedAvailableModel, StringComparison.Ordinal));
        if (ModelProviderEditorDefaults.ApplyModelMetadata(_config, match))
        {
            _availableModelsMessage = Loc.GetOrDefault(
                SettingsTextKeys.ModelProvidersModelDetailsPrefilledMessage,
                "Auto-filled fields from the selected model. Review and adjust as needed.");
            _availableModelsMessageIsError = false;
        }

        return Task.CompletedTask;
    }

