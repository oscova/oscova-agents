                               @onchange="HandlePresencePenaltyChange" />
                        <div class="flex justify-between px-2.5 mt-2 text-xs select-none">
                            <span>-2</span>
                            <span>-1</span>
                            <span>0</span>
                            <span>1</span>
                            <span>2</span>
                        </div>
                        <p class="text-xs mt-2 opacity-60">
                            @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersPresencePenaltyDescription, "Encourages the model to introduce new topics when positive.")
                        </p>
                    </div>
                </section>
                }

                <section class="grid gap-6 md:grid-cols-2">
                    <div class="form-control">
                        <div class="flex items-center justify-between">
                            <label class="label pl-0" for="top-k">
                                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersTopKLabel, "Top K")</span>
                                <span class="label-text-alt">@FormatNullable(_config.ChatOptions.TopK)</span>
                            </label>
                            <button type="button"
                                    class="btn btn-ghost btn-xs"
                                    disabled="@(_config.ChatOptions.TopK is null)"
                                    @onclick="() => UpdateChatOptions(o => o.TopK = null)">
                                @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersClearButton, "Clear")
                            </button>
                        </div>
                        <input id="top-k" type="range"
                               min="0"
                               max="200"
                               step="1"
                               class="range range-info"
                               value="@BindConverter.FormatValue(_topKValue)"
                               @oninput="HandleTopKInput"
                               @onchange="HandleTopKChange" />
                        <div class="flex justify-between px-2.5 mt-2 text-xs select-none">
                            <span>0</span>
                            <span>50</span>
                            <span>100</span>
                            <span>150</span>
                            <span>200</span>
                        </div>
                        <p class="text-xs mt-2 opacity-60">
                            @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersTopKDescription, "Limits candidate tokens. Set to 0 to rely on the provider default.")
                        </p>
                    </div>

                    <div class="form-control">
                        <label class="label pl-0" for="max-output-tokens">
                            <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersMaxOutputTokensLabel, "Max Output Tokens")</span>
                            <span class="label-text-alt">@FormatNullable(_config.ChatOptions.MaxOutputTokens)</span>
                        </label>
                        <label class="@($"input w-full validator{(_maxTokensHasError ? " input-error" : string.Empty)}")">
                            <span class="iconify lucide--hash text-base-content/60 size-4.5"></span>
                            <input id="max-output-tokens" type="number"
                                   class="grow focus:outline-0"
                                   value="@_maxOutputTokensText"
                                   @oninput="HandleMaxOutputTokensInput" />
                        </label>
                        @if (_maxTokensHasError)
                        {
                            <p class="validator-hint">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersMaxOutputTokensInvalid, "Enter a positive number or leave blank.")</p>
                        }
                        <p class="text-xs mt-2 opacity-60">
                            @if (_config.Type == ModelProviderKeys.Anthropic)
                            {
                                @string.Format(CultureInfo.CurrentCulture, Loc.GetOrDefault(SettingsTextKeys.ModelProvidersAnthropicMaxOutputTokensDescription, "Leave blank to use {0} output tokens."), ModelProviderConfigPresets.AnthropicDefaultMaxOutputTokens)
                            }
                            else
                            {
                                @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersMaxOutputTokensDescription, "Leave blank to let the provider decide the response length.")
                            }
                        </p>
                    </div>
                </section>

                <section class="grid gap-6 md:grid-cols-2">
                    @if (_config.Type != ModelProviderKeys.Anthropic)
                    {
                    <div class="form-control">
                        <label class="label pl-0" for="seed">
                            <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSeedLabel, "Seed")</span>
                            <span class="label-text-alt">@FormatNullable(_config.ChatOptions.Seed)</span>
                        </label>
                        <label class="@($"input w-full validator{(_seedHasError ? " input-error" : string.Empty)}")">
                            <span class="iconify lucide--hash text-base-content/60 size-4.5"></span>
                            <input id="seed" type="number"
                                   class="grow focus:outline-0"
                                   value="@_seedText"
                                   @oninput="HandleSeedInput" />
                        </label>
                        @if (_seedHasError)
                        {
                            <p class="validator-hint">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSeedInvalid, "Enter a non-negative number or leave blank.")</p>
                        }
                        <p class="text-xs mt-2 opacity-60">
                            @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersSeedDescription, "Use for reproducible responses when supported by the model.")
                        </p>
                    </div>
                    }

                    <div class="form-control">
                        <label class="label pl-0" for="tool-call-behavior">
                            <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersToolCallBehaviorLabel, "Tool Call Behavior")</span>
                            <span class="label-text-alt">@FormatAllowMultipleToolCalls()</span>
                        </label>
                        <select id="tool-call-behavior" class="select select-bordered w-full"
                                @bind="AllowMultipleToolCallsSelection">
                            <option value="unset">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersToolCallBehaviorAuto, "Auto")</option>
                            <option value="true">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersToolCallBehaviorAllowMultiple, "Allow multiple tool calls")</option>
                            <option value="false">@Loc.GetOrDefault(SettingsTextKeys.ModelProvidersToolCallBehaviorSingle, "Single tool call only")</option>
                        </select>
                        <p class="text-xs mt-2 opacity-60">
                            @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersToolCallBehaviorDescription, "Choose how many tool calls the model may issue per request.")
                        </p>
                    </div>
                </section>

                <div class="flex justify-end">
                    <button type="button" class="btn btn-outline btn-sm" @onclick="ResetChatOptionsToDefaults">
                        @Loc.GetOrDefault(SettingsTextKeys.ModelProvidersResetToDefaultsButton, "Reset to defaults")
                    </button>
                </div>
            </div>
        }

        }
    </ChildContent>
    <FooterContent>
        @if (_managingCredentials)
        {
            <button class="btn" type="button" @onclick="CloseAsync">@CommonLoc.GetOrDefault(CommonTextKeys.Back, "Back")</button>
        }
        else
        {
        <button class="btn" type="button" @onclick="Cancel">@CommonLoc.GetOrDefault(CommonTextKeys.Cancel, "Cancel")</button>
        <button class="btn btn-primary" type="button" @onclick="Save">@CommonLoc.GetOrDefault(CommonTextKeys.Save, "Save")</button>
        }
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;
    private ModelProviderConfig _config = new();
    private HostHardwareSnapshot? _hardware;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }
        try
        {
            _hardware = await HardwareProbe.GetAsync(_lifetime.Token);
            if (!_lifetime.IsCancellationRequested) { StateHasChanged(); }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
    private ModelProviderConfig? _originalConfig;
    private IReadOnlyDictionary<string, string> _providerErrors = new Dictionary<string, string>();

    private PluginModelProviderSettingsContext GetModelProviderSettings() => new(_config, _providerErrors, ProviderOptionsChangedAsync);

    private Task ProviderOptionsChangedAsync()
    {
        _providerErrors = ModelProviderValidation.Validate(_config, Providers.Find(_config.Type), _originalConfig);
        return InvokeAsync(StateHasChanged);
    }
    private string _previousProviderType = ModelProviderKeys.Ollama;
    private bool _isEditing;
    private int _activeTab;
    private bool _managingCredentials;

    private string ReasoningEffortValue
    {
        get => _config.ChatOptions.Reasoning?.Effort?.ToString() ?? string.Empty;
        set => UpdateChatOptions(options => options.Reasoning = Enum.TryParse<ReasoningEffort>(value, out var effort)
            ? new ReasoningOptions { Effort = effort }
            : null);
    }

    private double _temperatureValue;
    private double _topPValue;
    private double _frequencyPenaltyValue;
    private double _presencePenaltyValue;
    private double _topKValue;

    private string _maxOutputTokensText = string.Empty;
    private string _seedText = string.Empty;
    private bool _maxTokensHasError;
    private bool _seedHasError;
    private string _inputCostText = string.Empty;
    private string _outputCostText = string.Empty;
    private bool _inputCostHasError;
    private bool _outputCostHasError;

    // Local provider fields
    private List<string> _availableLocalModels = [];
    private string _selectedLocalModel = string.Empty;
    private string _downloadUrl = string.Empty;
    private string? _downloadUrlError;
    private List<ModelDescriptor> _availableRemoteModels = [];
    private ModelSizing? _localModelSizing;
    private string? _localSizingModelId;
    private (string Type, string? BaseUrl)? _availableModelsSource;
    private string _selectedAvailableModel = string.Empty;
    private bool _isFetchingAvailableModels;
    private string? _availableModelsMessage;
    private bool _availableModelsMessageIsError;
    private string? _modelDownloadError;
    private List<CredentialListItem> _apiKeyCredentials = [];
    private List<string> _availableProviderTypes = [];
    private List<ProviderTypeDefault> _providerTypeDefaults = [];
    private ModelDescriptor? SelectedAvailableModel => _availableRemoteModels.FirstOrDefault(model =>
        string.Equals(model.Id, _selectedAvailableModel, StringComparison.Ordinal));
    private bool SupportsSelectedProviderDownload => FindProviderDefault(_config.Type)?.SupportsModelDownload == true;
    private bool IsCurrentModelInstalled => _availableModelsSource is { } source
        && source.Type == _config.Type && source.BaseUrl == _config.BaseUrl
        && _availableRemoteModels.Any(model => model.IsInstalled == true
            && string.Equals(model.Id, _config.ModelId?.Trim(), StringComparison.Ordinal));
    private bool SupportsFitIndicator => Providers.Find(_config.Type) is IModelHardwareProvider || _config.Type is ModelProviderKeys.Ollama or ModelProviderKeys.Local;
    private long? EstimatedFootprint
    {
        get
        {
            if (GetCurrentModelSizing() is not { } sizing) { return null; }

            try { return ModelFitEstimator.EstimateRequiredBytes(sizing, _config.ContextWindowSize); }
            catch (OverflowException) { return null; }
        }
    }
    private ModelFitVerdict? ModelFit
    {
        get
        {
            if (!SupportsFitIndicator || _config.ContextWindowSize <= 0)
            {
                return null;
            }

            var sizing = GetCurrentModelSizing();
            if (sizing is null)
            {
                return ModelFitVerdict.Unknown;
            }

            var profile = (Providers.Find(_config.Type) as IModelHardwareProvider)?.GetHardwareProfile(_config)
                ?? (_config.Type == ModelProviderKeys.Ollama ? new ModelHardwareProfile("managed", "managed") : new("unknown", "unknown"));
            return _hardware is null ? ModelFitVerdict.Unknown : ModelFitEstimator.Estimate(sizing, _config.ContextWindowSize, _hardware, profile);
        }
    }
    private string DialogTitle => _isEditing
        ? Loc.GetOrDefault(SettingsTextKeys.ModelProvidersEditProviderDialogTitle, "Edit Provider")
        : Loc.GetOrDefault(SettingsTextKeys.ModelProvidersAddProviderDialogTitle, "Add Provider");

    protected override async Task OnInitializedAsync()
    {
        _availableProviderTypes = DialogInstance.Get<List<string>?>("AvailableProviderTypes", null) ?? [];
        if (_availableProviderTypes.Count == 0)
        {
            _availableProviderTypes = [.. ModelProviderEditorDefaults.BuiltInProviderTypes];
        }

        _providerTypeDefaults = DialogInstance.Get<List<ProviderTypeDefault>?>("ProviderTypeDefaults", null) ?? [];
        var provider = DialogInstance.Get<ModelProviderConfig?>("Provider", null);
        _originalConfig = provider?.Clone();

        if (provider is not null)
        {
            _isEditing = true;
            _config = provider.Clone();
        }
        else
        {
            _isEditing = false;
            _config = new ModelProviderConfig { Id = Guid.NewGuid() };
            ApplyPresetForType(_config.Type, preserveCustomBaseUrl: false, clearModelId: true);
        }

        _config.ChatOptions ??= new ChatOptions();
        _previousProviderType = _config.Type;
        _selectedLocalModel = _config.ModelId ?? string.Empty;
        await LoadCredentialsAsync();
        SyncChatOptionsEditors();

        if (_config.Type == ModelProviderKeys.Local)
        {
            await RefreshLocalModelsAsync();
        }
        else
        {
            _selectedLocalModel = string.Empty;
        }
    }

    private async Task HandleProviderTypeChangedAsync()
    {
        _config.Options = null;
        _providerErrors = new Dictionary<string, string>();
        var previousBaseUrl = _config.BaseUrl;
        var previousDefaultBaseUrl = GetPresetBaseUrl(_previousProviderType);
        var preserveCustomBaseUrl = !string.IsNullOrWhiteSpace(previousBaseUrl)
            && !string.Equals(previousBaseUrl, previousDefaultBaseUrl, StringComparison.Ordinal);

        ApplyPresetForType(_config.Type, preserveCustomBaseUrl, clearModelId: true, previousBaseUrl);
        _previousProviderType = _config.Type;

        _availableRemoteModels.Clear();
        _availableModelsSource = null;
        _selectedAvailableModel = string.Empty;
        _modelDownloadError = null;
        _availableModelsMessage = null;
        _availableModelsMessageIsError = false;

        if (_config.Type == ModelProviderKeys.Local)
        {
            await RefreshLocalModelsAsync();
        }
        else
        {
            _selectedLocalModel = string.Empty;
        }
    }

    private void ApplyPresetForType(
        string type,
        bool preserveCustomBaseUrl,
        bool clearModelId,
        string? previousBaseUrl = null)
    {
        var hasPreset = ModelProviderEditorDefaults.TryGetPreset(type, out var preset);
        _config.Name = ModelProviderEditorDefaults.GetChatProviderName(type);

        if (!preserveCustomBaseUrl)
        {
            _config.BaseUrl = ModelProviderEditorDefaults.GetDefaultEndpoint(type, _providerTypeDefaults);
        }
        else
        {
            _config.BaseUrl = previousBaseUrl;
        }

        if (hasPreset && preset is not null)
        {
            _config.ContextWindowSize = preset.ContextWindowSize;
            _config.InputCostPerMillionTokens = null;
            _config.OutputCostPerMillionTokens = null;
            _config.SupportsImages = preset.SupportsImages;
            _config.SupportsThinking = preset.SupportsThinking;
            _config.ChatOptions = preset.ChatOptions?.Clone() ?? new ChatOptions();
        }
        else
        {
            _config.ContextWindowSize = 0;
            _config.InputCostPerMillionTokens = null;
            _config.OutputCostPerMillionTokens = null;
            _config.SupportsImages = false;
            _config.SupportsThinking = false;
            _config.ChatOptions = new ChatOptions();
        }

        if (clearModelId)
        {
            var providerDefault = FindProviderDefault(type);
            _config.ModelId = providerDefault?.DefaultModel ?? string.Empty;
            _selectedAvailableModel = string.Empty;
            _selectedLocalModel = string.Empty;
        }

        if (type != ModelProviderKeys.Ollama)
        {
            _config.OllamaKeepAlive = null;
        }

        SyncChatOptionsEditors();
    }

    private void Cancel()
    {
        DialogInstance.Close<ModelProviderConfig>(DialogResult.Cancel, null);
    }

    private async Task Save()
    {
        _providerErrors = ModelProviderValidation.Validate(_config, Providers.Find(_config.Type), _originalConfig);
        if (_providerErrors.Count > 0) { return; }

        if (string.IsNullOrWhiteSpace(_config.Name) || string.IsNullOrWhiteSpace(_config.ModelId))
        {
            return;
        }

        if (_config.Type != ModelProviderKeys.Local && !string.IsNullOrWhiteSpace(_config.BaseUrl) && !Uri.TryCreate(_config.BaseUrl, UriKind.Absolute, out _))
        {
            return;
        }

        if (_config.ContextWindowSize < 0)
        {
            return;
        }

        if (_maxTokensHasError || _seedHasError || _inputCostHasError || _outputCostHasError)
        {
            return;
        }

        if (_config.Type == ModelProviderKeys.Ollama)
        {
            _config.OllamaKeepAlive = NormalizeOptionalText(_config.OllamaKeepAlive);
        }
        else
        {
            _config.OllamaKeepAlive = null;
        }

        var config = _config.Clone();
        DialogInstance.Close(DialogResult.Ok, config);
    }

    private static string? NormalizeOptionalText(string? value)
    {
        var trimmed = value?.Trim();
        return string.IsNullOrWhiteSpace(trimmed) ? null : trimmed;
    }

    private void HandleTemperatureInput(ChangeEventArgs args)
    {
        _temperatureValue = ClampDouble(ParseDouble(args.Value, _temperatureValue), 0, 2);
    }

    private void HandleTemperatureChange(ChangeEventArgs args)
    {
        _temperatureValue = ClampDouble(ParseDouble(args.Value, _temperatureValue), 0, 2);
        UpdateChatOptions(o => o.Temperature = (float)_temperatureValue);
    }

    private void HandleTopPInput(ChangeEventArgs args)
    {
        _topPValue = ClampDouble(ParseDouble(args.Value, _topPValue), 0, 1);
    }

    private void HandleTopPChange(ChangeEventArgs args)
    {
        _topPValue = ClampDouble(ParseDouble(args.Value, _topPValue), 0, 1);
        UpdateChatOptions(o => o.TopP = (float)_topPValue);
    }

    private void HandleFrequencyPenaltyInput(ChangeEventArgs args)
    {
        _frequencyPenaltyValue = ClampDouble(ParseDouble(args.Value, _frequencyPenaltyValue), -2, 2);
    }

    private void HandleFrequencyPenaltyChange(ChangeEventArgs args)
    {
        _frequencyPenaltyValue = ClampDouble(ParseDouble(args.Value, _frequencyPenaltyValue), -2, 2);
        UpdateChatOptions(o => o.FrequencyPenalty = (float)_frequencyPenaltyValue);
    }

    private void HandlePresencePenaltyInput(ChangeEventArgs args)
    {
        _presencePenaltyValue = ClampDouble(ParseDouble(args.Value, _presencePenaltyValue), -2, 2);
    }

    private void HandlePresencePenaltyChange(ChangeEventArgs args)
    {
        _presencePenaltyValue = ClampDouble(ParseDouble(args.Value, _presencePenaltyValue), -2, 2);
        UpdateChatOptions(o => o.PresencePenalty = (float)_presencePenaltyValue);
    }

    private void HandleTopKInput(ChangeEventArgs args)
    {
        _topKValue = ClampDouble(ParseDouble(args.Value, _topKValue), 0, 200);
    }

    private void HandleTopKChange(ChangeEventArgs args)
    {
        _topKValue = ClampDouble(ParseDouble(args.Value, _topKValue), 0, 200);
        UpdateChatOptions(o => o.TopK = (int)Math.Round(_topKValue));
    }

    private string AllowMultipleToolCallsSelection
    {
        get => _config.ChatOptions.AllowMultipleToolCalls switch
        {
            true => "true",
            false => "false",
            _ => "unset"
        };
        set => UpdateChatOptions(opts => opts.AllowMultipleToolCalls = value switch
        {
            "true" => true,
            "false" => false,
            _ => (bool?)null
        });
    }

    private string LocalEndpointSelection
    {
        get => _config.IsLocalEndpoint switch
        {
            true => "local",
            false => "cloud",
            _ => "auto"
        };
        set => _config.IsLocalEndpoint = value switch
        {
            "local" => true,
            "cloud" => false,
            _ => (bool?)null
        };
    }

    private void HandleMaxOutputTokensInput(ChangeEventArgs args)
    {
        _maxOutputTokensText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_maxOutputTokensText))
        {
            _maxTokensHasError = false;
            UpdateChatOptions(opts => opts.MaxOutputTokens = null);
            return;
        }

        if (int.TryParse(_maxOutputTokensText, out var parsed) && parsed > 0)
        {
            _maxTokensHasError = false;
            UpdateChatOptions(opts => opts.MaxOutputTokens = parsed);
        }
        else
        {
            _maxTokensHasError = true;
        }
    }

    private void HandleSeedInput(ChangeEventArgs args)
    {
        _seedText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_seedText))
        {
            _seedHasError = false;
            UpdateChatOptions(opts => opts.Seed = null);
            return;
        }

        if (long.TryParse(_seedText, out var parsed) && parsed >= 0)
        {
            _seedHasError = false;
            UpdateChatOptions(opts => opts.Seed = parsed);
        }
        else
        {
            _seedHasError = true;
        }
    }

    private void HandleInputCostInput(ChangeEventArgs args)
    {
        _inputCostText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_inputCostText))
        {
            _inputCostHasError = false;
            _config.InputCostPerMillionTokens = null;
            return;
        }

        if (TryParseDecimal(_inputCostText, out var parsed) && parsed >= 0)
        {
            _inputCostHasError = false;
            _config.InputCostPerMillionTokens = parsed;
        }
        else
        {
            _inputCostHasError = true;
        }
    }

    private void HandleOutputCostInput(ChangeEventArgs args)
    {
        _outputCostText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_outputCostText))
        {
            _outputCostHasError = false;
            _config.OutputCostPerMillionTokens = null;
            return;
        }

        if (TryParseDecimal(_outputCostText, out var parsed) && parsed >= 0)
        {
            _outputCostHasError = false;
            _config.OutputCostPerMillionTokens = parsed;
        }
        else
        {
            _outputCostHasError = true;
        }
