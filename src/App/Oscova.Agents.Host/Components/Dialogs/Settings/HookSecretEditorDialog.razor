@using Oscova.Agents.Core.ApiContracts.Hooks
@inject IStringLocalizer<SettingsText> Loc
@inject IStringLocalizer<CommonText> CommonLoc

@* Edits a user-facing hook secret request while the Hooks settings page owns persistence. *@
<AppDialogShell Title="@DialogTitle"
                Icon="lucide:lock-keyhole"
                MaxWidthClass="max-w-xl"
                HelpTopic="@HelpTopics.HookSecretEditor"
                CloseResult="@DialogResult.Cancel"
                ShowBackdropClose="true">
    <ChildContent>
        <div class="space-y-3">
            <fieldset class="fieldset p-0">
                <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.HooksSecretNameLabel, "Secret name")</legend>
                <label class="input w-full">
                    <iconify-icon icon="lucide:tag" class="text-base-content/60"></iconify-icon>
                    <input id="secret-name" class="grow focus:outline-0" aria-label="@Loc.GetOrDefault(SettingsTextKeys.HooksSecretNameLabel, "Secret name")" @bind="_request.Alias" @bind:event="oninput" />
                </label>
            </fieldset>
            <fieldset class="fieldset p-0">
                <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.HooksSecretKeyLabel, "Secret reference key")</legend>
                <label class="input w-full">
                    <iconify-icon icon="lucide:key" class="text-base-content/60"></iconify-icon>
                    <input id="secret-key" class="grow focus:outline-0" aria-label="@Loc.GetOrDefault(SettingsTextKeys.HooksSecretKeyLabel, "Secret reference key")" @bind="_request.CredentialKey" @bind:event="oninput" />
                </label>
            </fieldset>
            <fieldset class="fieldset p-0">
                <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.HooksSecretValueLabel, "Secret value")</legend>
                <label class="input w-full">
                    <iconify-icon icon="lucide:lock-keyhole" class="text-base-content/60"></iconify-icon>
                    <input id="secret-value" type="password" class="grow focus:outline-0" aria-label="@Loc.GetOrDefault(SettingsTextKeys.HooksSecretValueLabel, "Secret value")" @bind="_request.SecretValue" @bind:event="oninput" />
                </label>
                @if (_isEditing)
                {
                    <p class="fieldset-label">@Loc.GetOrDefault(SettingsTextKeys.HooksSecretValueEditHint, "Leave blank to keep the current value.")</p>
                }
            </fieldset>
            <fieldset class="fieldset p-0">
                <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.HooksSecretDescriptionLabel, "Description")</legend>
                <textarea class="textarea textarea-bordered h-20 w-full" aria-label="@Loc.GetOrDefault(SettingsTextKeys.HooksSecretDescriptionLabel, "Description")" @bind="_request.Description"></textarea>
            </fieldset>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost btn-sm" @onclick="Cancel">@CommonLoc.GetOrDefault(CommonTextKeys.Cancel, "Cancel")</button>
        <button type="button" class="btn btn-primary btn-sm" @onclick="Save">
            <span class="iconify lucide--save size-4" aria-hidden="true"></span>
            @Loc.GetOrDefault(SettingsTextKeys.HooksSaveSecretButton, "Save secret")
        </button>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;

    private SaveHookSecretCredentialRequest _request = new();
    private bool _isEditing;

    private string DialogTitle => _isEditing
        ? Loc.GetOrDefault(SettingsTextKeys.HooksEditSecretDialogTitle, "Edit outbound HTTP hook secret")
        : Loc.GetOrDefault(SettingsTextKeys.HooksNewSecretDialogTitle, "New outbound HTTP hook secret");

    protected override void OnInitialized()
    {
        var secret = DialogInstance.Get<HookSecretCredentialSummary>("Secret");
        if (secret is not null)
        {
            _isEditing = true;
            _request = new SaveHookSecretCredentialRequest
            {
                CredentialKey = secret.CredentialKey,
                Alias = secret.Alias,
                Description = secret.Description,
                SecretValue = string.Empty
            };
        }
    }

    private void Save()
    {
        DialogInstance.Close(DialogResult.Ok, _request);
    }

    private void Cancel()
    {
        DialogInstance.Close<SaveHookSecretCredentialRequest>(DialogResult.Cancel, null);
    }
}
