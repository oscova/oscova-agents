@inject IDialogService Dialogs
@inject IStringLocalizer<ChatText> Loc
@inject IStringLocalizer<CommonText> CommonLoc

<AppDialogShell Title="@Loc[_conflict is null ? ChatTextKeys.WorkspaceUnsavedTitle : ChatTextKeys.WorkspaceConflictTitle]"
                HelpTopic="@HelpTopics.WorkspaceFileDecision" CloseResult="@DialogResult.Cancel" CanClose="@(!_busy)"
                ShowBackdropClose="@true" MaxWidthClass="max-w-lg" FooterClass="modal-action flex-wrap px-5 pb-5 pt-0">
    <ChildContent>
        <p class="text-sm text-base-content/70">@Loc[_conflict is null ? ChatTextKeys.WorkspaceUnsavedMessage : ChatTextKeys.WorkspaceConflictMessage]</p>
        @if (_conflict is not null)
        {
            <p class="mt-3 text-sm text-base-content/70">@Loc[ChatTextKeys.WorkspaceConflictActions]</p>
            <p class="mt-3 truncate text-sm font-medium" title="@_conflict.Name">@_conflict.Name</p>
        }
        @if (_error is not null)
        {
            <p class="mt-3 text-sm text-base-content/70 wrap-anywhere" role="alert">@Loc[_error]</p>
        }
    </ChildContent>
    <FooterContent>
        @if (_conflict is not null)
        {
            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="OverwriteAsync">@Loc[ChatTextKeys.WorkspaceOverwrite]</button>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="ReloadAsync">@Loc[ChatTextKeys.WorkspaceReloadLatest]</button>
        }
        else
        {
            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveAllAsync">@CommonLoc[CommonTextKeys.Save]</button>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="Discard">@Loc[ChatTextKeys.WorkspaceDiscard]</button>
        }
        <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="Cancel">@CommonLoc[CommonTextKeys.Cancel]</button>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter] public DialogInstance DialogInstance { get; set; } = default!;
    private WorkspaceEditingState _state = default!;
    private IReadOnlyList<WorkspaceFileDraft> _files = [];
    private WorkspaceFileDraft? _conflict;
    private string? _error;
    private bool _busy;
    private bool _conflictOnly;

    protected override void OnInitialized()
    {
        _state = DialogInstance.Get<WorkspaceEditingState>("State", default!);
        _files = DialogInstance.Get<IReadOnlyList<WorkspaceFileDraft>>("Files", []);
        _conflictOnly = DialogInstance.Get("ConflictOnly", false);
        if (_conflictOnly) { _conflict = _files.FirstOrDefault(); }
    }

    private async Task SaveAllAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            foreach (var file in _files.Where(file => file.IsDirty))
            {
                if (!await _state.SaveAsync(file))
                {
                    _conflict = file.ConflictRevision is not null ? file : null;
                    _error = _conflict is null ? file.ErrorKey : null;
                    return;
                }
            }
            DialogInstance.Close(DialogResult.Ok);
        }
        finally { _busy = false; }
    }

    private async Task OverwriteAsync()
    {
        if (_conflict is null) { return; }
        _busy = true;
        var saved = await _state.SaveAsync(_conflict, overwrite: true);
        _busy = false;
        _error = _conflict.ErrorKey == ChatTextKeys.WorkspaceConflictMessage ? null : _conflict.ErrorKey;
        if (!saved) { return; }
        _conflict = null;
        if (_conflictOnly) { DialogInstance.Close(DialogResult.Ok); }
        else { await SaveAllAsync(); }
    }

    private async Task ReloadAsync()
    {
        if (_conflict is null) { return; }
        var confirmed = await Dialogs.ShowAsync<ConfirmDialog>(
            CommonLoc[CommonTextKeys.UnsavedChangesTitle], Loc[ChatTextKeys.WorkspaceReloadConfirm]);
        if (confirmed != DialogResult.Ok) { return; }
        _busy = true;
        var reloaded = await _state.ReloadAsync(_conflict);
        _busy = false;
        _error = _conflict.ErrorKey;
        if (reloaded) { DialogInstance.Close(DialogResult.Cancel); }
    }

    private void Discard()
    {
        foreach (var file in _files) { file.Discard(); }
        DialogInstance.Close(DialogResult.Ok);
    }
    private void Cancel() => DialogInstance.Close(DialogResult.Cancel);
}
