@using Oscova.Agents.Core.ApiContracts.Agents
@using Oscova.Agents.Core.ApiContracts.Profile
@using Oscova.Agents.Core.ApiContracts.Tasks
@inject ManagementApiClient ManagementApiClient
@inject IToastService ToastService
@inject IStringLocalizer<CommonText> CommonLoc
@inject UserServiceScope UserScope

@* Owns replacement of the unreadable duress policy without exposing its current state. *@
<AppDialogShell Title="@(CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressTitle, "Duress credentials"))"
                Subtitle="@(CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressDescription, "Use a second password to sign in normally while permanently destroying your chosen private data."))"
                Icon="lucide:shield-alert"
                HelpTopic="@HelpTopics.DuressCredentials"
                MaxWidthClass="max-w-4xl"
                BodyClass="overflow-y-auto px-5 py-4"
                CanClose="@(!_isBusy)"
                CloseResult="@DialogResult.Cancel">
    <ChildContent>
        @* Keep the submitted values stable until the dialog finishes saving. *@
        <fieldset disabled="@_isBusy">
        <div class="space-y-4">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div role="alert" class="alert alert-error alert-soft">
                    <iconify-icon icon="lucide:alert-circle"></iconify-icon>
                    <span>@_errorMessage</span>
                </div>
            }

            <div role="alert" class="alert alert-warning alert-soft text-sm">
                <span>@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPriorSelections, "Saved choices cannot be shown. This form starts empty, and saving replaces the complete policy.")</span>
            </div>

            @if (_isLoading)
            {
                <div class="flex items-center gap-2 text-sm">
                    <span class="loading loading-spinner loading-sm"></span>
                    @CommonLoc.GetOrDefault(CommonTextKeys.Loading, "Loading")
                </div>
            }
            else if (_loadFailed)
            {
                <div role="alert" class="alert alert-error alert-soft text-sm">
                    @CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressLoadFailed, "Duress credential choices could not be loaded.")
                </div>
            }
            else if (_agentConfiguration is not null && _taskConfiguration is not null)
            {
                <label class="label cursor-pointer justify-start gap-3 rounded-box border border-base-300 px-4 py-3">
                    <input id="duress-delete-all-threads" type="checkbox" class="checkbox checkbox-sm checkbox-error" @bind="_deleteAllThreads" />
                    <span class="label-text">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressDeleteThreads, "Delete all conversations")</span>
                </label>

                @if (UserScope.IsInRole("Admin"))
                {
                    <label class="label cursor-pointer justify-start gap-3 rounded-box border border-base-300 px-4 py-3">
                        <input id="duress-clear-shared-folder" type="checkbox" class="checkbox checkbox-sm checkbox-error" @bind="_clearSharedFolder" />
                        <span class="label-text">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressClearSharedFolder, "Empty the shared folder for every user")</span>
                    </label>
                }

                @if (!HasTargets)
                {
                    <p class="text-base-content/50 text-sm">
                        @CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressNoTargets, "No selectable agents, tasks, or workspaces are available.")
                    </p>
                }
                else
                {
                    <div class="flex flex-wrap gap-4">
                        <DuressTargetList Title="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressAgents, "Agents to delete")"
                                         Items="@_agentConfiguration.CustomAgents.Where(agent => !agent.IsShared).Select(agent => (agent.Id, agent.Name))"
                                         SelectedIds="@_agentIds"
                                         OnToggle="@(id => ToggleSelection(_agentIds, id))" />
                        <DuressTargetList Title="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressTasks, "Tasks to delete")"
                                         Items="@_taskConfiguration.Tasks.Select(task => (task.Id, task.Name))"
                                         SelectedIds="@_taskIds"
                                         OnToggle="@(id => ToggleSelection(_taskIds, id))" />
                        <DuressTargetList Title="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressWorkspaces, "Workspaces to clear")"
                                         Items="@WorkspaceItems"
                                         SelectedIds="@_workspaces"
                                         OnToggle="@(id => ToggleSelection(_workspaces, id))" />
                    </div>
                }

                <div class="space-y-1 text-base-content/60 text-xs">
                    <p>@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressDefaultWorkspace, "The default workspace is always kept.")</p>
                    <p>@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressWorkspaceClearing, "Workspace contents are deleted, but the workspace itself remains.")</p>
                </div>

                <fieldset class="fieldset">
                    <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressAccountPassword, "Account password")</legend>
                    <input id="duress-account-password" aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressAccountPassword, "Account password")" class="input w-full" type="password" @bind="_accountPassword" autocomplete="current-password" />
                </fieldset>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPassword, "Duress password")</legend>
                        <input id="duress-password" aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPassword, "Duress password")" class="input w-full" type="password" @bind="_duressPassword" autocomplete="new-password" />
                    </fieldset>
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressConfirmation, "Confirm duress password")</legend>
                        <input id="duress-password-confirmation" aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressConfirmation, "Confirm duress password")" class="input w-full" type="password" @bind="_confirmation" autocomplete="new-password" />
                    </fieldset>
                </div>
                <p class="text-base-content/60 text-xs">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinHelp, "Optional. Requires a sign-in PIN. Leave both fields empty to save without a duress PIN. Saving replaces both duress credentials and all deletion choices.")</p>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPin, "Duress PIN (optional)")</legend>
                        <input id="duress-pin" class="input w-full" type="password" inputmode="numeric" minlength="@PinPolicy.MinimumLength" maxlength="@PinPolicy.MaximumLength" autocomplete="new-password"
                               aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPin, "Duress PIN (optional)")" @bind="_duressPin" />
                    </fieldset>
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinConfirmation, "Confirm duress PIN")</legend>
                        <input id="duress-pin-confirmation" class="input w-full" type="password" inputmode="numeric" minlength="@PinPolicy.MinimumLength" maxlength="@PinPolicy.MaximumLength" autocomplete="new-password"
                               aria-label="@CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinConfirmation, "Confirm duress PIN")" @bind="_pinConfirmation" />
                    </fieldset>
                </div>
            }
        </div>
            </fieldset>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost btn-sm" disabled="@_isBusy" @onclick="Cancel">
            @CommonLoc.GetOrDefault(CommonTextKeys.Cancel, "Cancel")
        </button>
        <button type="button" class="btn btn-error btn-sm" disabled="@(_isLoading || _loadFailed || _isBusy)" @onclick="SaveAsync">
            @if (_isBusy)
            {
                <span class="loading loading-spinner loading-sm"></span>
            }
            @CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressSave, "Save duress credentials")
        </button>
    </FooterContent>
</AppDialogShell>

@code {
    [CascadingParameter]
    public DialogInstance DialogInstance { get; set; } = default!;

    private AgentConfiguration? _agentConfiguration;
    private TaskConfiguration? _taskConfiguration;
    private readonly HashSet<string> _agentIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> _taskIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> _workspaces = new(StringComparer.Ordinal);
    private string _accountPassword = string.Empty;
    private string _duressPassword = string.Empty;
    private string _confirmation = string.Empty;
    private string _duressPin = string.Empty;
    private string _pinConfirmation = string.Empty;
    private string? _errorMessage;
    private bool _deleteAllThreads;
    private bool _clearSharedFolder;
    private bool _isBusy;
    private bool _isLoading;
    private bool _loadFailed;

    private bool HasTargets =>
        _agentConfiguration?.CustomAgents.Any(agent => !agent.IsShared) == true ||
        _taskConfiguration?.Tasks.Count > 0 ||
        _agentConfiguration?.AvailableWorkspaces.Any(workspace => !string.Equals(
            workspace,
            UserFileNames.DefaultWorkspaceDirectory,
            StringComparison.OrdinalIgnoreCase)) == true;

    private IEnumerable<(string Id, string Name)> WorkspaceItems =>
        _agentConfiguration?.AvailableWorkspaces
            .Where(workspace => !string.Equals(
                workspace,
                UserFileNames.DefaultWorkspaceDirectory,
                StringComparison.OrdinalIgnoreCase))
            .Select(workspace => (workspace, workspace)) ?? [];

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _agentConfiguration = await ManagementApiClient.GetAgentConfigurationAsync();
            _taskConfiguration = await ManagementApiClient.GetTaskConfigurationAsync(includeReservedTasks: false);
        }
        catch
        {
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static void ToggleSelection(HashSet<string> selected, string id)
    {
        if (!selected.Add(id))
        {
            selected.Remove(id);
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            if (_duressPassword.Length is < 12 or > 256)
            {
                _errorMessage = CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressLengthError, "The duress password must be between 12 and 256 characters.");
                return;
            }

            if (!string.Equals(_duressPassword, _confirmation, StringComparison.Ordinal))
            {
                _errorMessage = CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressConfirmationError, "The duress password confirmation does not match.");
                return;
            }

            if (string.Equals(_duressPassword, _accountPassword, StringComparison.Ordinal))
            {
                _errorMessage = CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressDifferentError, "The duress password must be different from your account password.");
                return;
            }

            if ((!string.IsNullOrEmpty(_duressPin) && !PinPolicy.IsValid(_duressPin)) ||
                !string.Equals(_duressPin, _pinConfirmation, StringComparison.Ordinal))
            {
                _errorMessage = CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinError, "Enter matching PINs of 6–64 digits, or leave both empty.");
                return;
            }
            var result = await ManagementApiClient.SaveDuressCredentialsAsync(new SaveDuressCredentialsRequest
            {
                AccountPassword = _accountPassword,
                DuressPassword = _duressPassword,
                ConfirmDuressPassword = _confirmation,
                DuressPin = _duressPin,
                ConfirmDuressPin = _pinConfirmation,
                DeleteAllThreads = _deleteAllThreads,
                AgentIds = [.. _agentIds],
                TaskIds = [.. _taskIds],
                Workspaces = [.. _workspaces],
                ClearSharedFolder = _clearSharedFolder
            });
            ToastService.Show(
                CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressSaveSuccess, result.Message),
                ToastType.Success);
            DialogInstance.Close(DialogResult.Ok);
        }
        catch (Exception ex)
        {
            _errorMessage = LocalizeError(ex.Message);
        }
        finally
        {
            _isBusy = false;
            ClearPasswordFields();
        }
    }

    private string LocalizeError(string message) => message switch
    {
        "PIN must be 6–64 digits." or "The duress PIN confirmation does not match." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinError, message),
        "Set a sign-in PIN before configuring a duress PIN." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinRequired, message),
        "Choose a PIN different from your sign-in PIN." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressPinDifferent, message),
        "Your account password is incorrect." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressAccountPasswordError, message),
        "The default workspace cannot be selected." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressDefaultWorkspaceError, message),
        "A shared agent cannot be selected." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressSharedAgentError, message),
        "A selected name is too long." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressTargetNameTooLong, message),
        "Your selection is too large. Remove some items and try again." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressSelectionTooLarge, message),
        "Duress credentials cannot be set while two-factor authentication is enabled." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressTwoFactorError, message),
        "One of the selected items is no longer available. Reopen the form and choose again." => CommonLoc.GetOrDefault(CommonTextKeys.DialogDuressUnavailable, message),
        _ => message
    };

    private void ClearPasswordFields()
    {
        _accountPassword = string.Empty;
        _duressPassword = string.Empty;
        _confirmation = string.Empty;
        _duressPin = string.Empty;
        _pinConfirmation = string.Empty;
    }

    private void Cancel() => DialogInstance.Close(DialogResult.Cancel);
}
