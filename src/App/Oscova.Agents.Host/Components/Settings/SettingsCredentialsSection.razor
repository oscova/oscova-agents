@inherits SettingsCredentialsSectionBase

<div class="space-y-6">
    <div class="card custom-settings-catalog-card custom-settings-credentials">
        <div class="card-body space-y-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="card-title">@Loc.GetOrDefault(SettingsTextKeys.CredentialsSavedCredentialsTitle, "Saved Credentials")</h2>
                    <p class="text-sm opacity-70">@Loc.GetOrDefault(SettingsTextKeys.CredentialsSavedCredentialsDescription, "Manage API keys and bot tokens centrally, then link them from provider and Discord settings.")</p>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="OpenCreateDialogAsync">
                    <span class="iconify lucide--plus size-4" aria-hidden="true"></span>@Loc.GetOrDefault(SettingsTextKeys.CredentialsAddCredentialButton, "Add Credential")
                </button>
            </div>

            <div class="alert alert-soft">
                <iconify-icon icon="lucide:info"></iconify-icon>
                <span>@Loc.GetOrDefault(SettingsTextKeys.CredentialsEncryptionDescription, "Secret values stay encrypted at rest and are never shown after save.")</span>
            </div>

            <section class="space-y-4">
                <h3 class="text-base font-semibold">@Loc.GetOrDefault(SettingsTextKeys.CredentialsIntegrationCredentialsHeading, "Integration credentials")</h3>
                @if (_view.Slots.Count == 0)
                {
                    <div class="rounded-box border border-dashed border-base-300 p-6 text-sm opacity-70">
                        @Loc.GetOrDefault(SettingsTextKeys.CredentialsNoIntegrationCredentialsMessage, "No integration credentials are required.")
                    </div>
                }
                else
                {
                    <div class="custom-settings-table-container overflow-x-auto">
                        <table class="table table-pin-rows custom-settings-adaptive-table">
                            <thead>
                                <tr>
                                    <th>@CommonLoc.GetOrDefault(CommonTextKeys.Name, "Name")</th>
                                    <th>@CommonLoc.GetOrDefault(CommonTextKeys.Description, "Description")</th>
                                    <th>@Loc.GetOrDefault(SettingsTextKeys.CredentialsColumnValue, "Value")</th>
                                    <th class="custom-settings-actions">@CommonLoc.GetOrDefault(CommonTextKeys.Actions, "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in _view.Slots)
                                {
                                    <tr class="hover:bg-base-200/40 align-top" @key="slot.Key">
                                        <td data-label="@CommonLoc.GetOrDefault(CommonTextKeys.Name, "Name")">
                                            <div class="min-w-0">
                                                <p class="min-w-0 break-words font-medium [overflow-wrap:anywhere]">@slot.Label</p>
                                                <code class="text-xs text-base-content/60">@slot.Key</code>
                                            </div>
                                        </td>
                                        <td class="text-sm text-base-content/70" data-label="@CommonLoc.GetOrDefault(CommonTextKeys.Description, "Description")">
                                            @if (!string.IsNullOrWhiteSpace(slot.Description))
                                            {
                                                <span dir="auto" class="min-w-0 break-words [overflow-wrap:anywhere]">@slot.Description</span>
                                            }
                                        </td>
                                        <td data-label="@Loc.GetOrDefault(SettingsTextKeys.CredentialsColumnValue, "Value")">
                                            <span class="badge @(IsConfigured(slot) ? "badge-success badge-soft" : "badge-warning badge-soft")">
                                                @(IsConfigured(slot)
                                                    ? Loc.GetOrDefault(SettingsTextKeys.CredentialsValueSetBadge, "Set")
                                                    : Loc.GetOrDefault(SettingsTextKeys.CredentialsValueNotSetBadge, "Not set"))
                                            </span>
                                        </td>
                                        <td class="custom-settings-actions text-right" data-label="@CommonLoc.GetOrDefault(CommonTextKeys.Actions, "Actions")">
                                            <button class="btn btn-sm" @onclick="() => OpenEditDialogAsync(slot.Key, false)">
                                                <span class="iconify lucide--pencil size-4" aria-hidden="true"></span>@CommonLoc.GetOrDefault(CommonTextKeys.Edit, "Edit")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="space-y-4">
                <h3 class="text-base font-semibold">@Loc.GetOrDefault(SettingsTextKeys.CredentialsUserCredentialsHeading, "Your credentials")</h3>
                @if (_view.FreeForm.Count == 0)
                {
                    <div class="rounded-box border border-dashed border-base-300 p-6 text-sm opacity-70">
                        @Loc.GetOrDefault(SettingsTextKeys.CredentialsNoCredentialsEmpty, "No credentials saved yet.")
                    </div>
                }
                else
                {
                    <div class="custom-settings-table-container overflow-x-auto">
                        <table class="table table-pin-rows custom-settings-adaptive-table">
                            <thead>
                                <tr>
                                    <th>@Loc.GetOrDefault(SettingsTextKeys.CredentialsColumnAlias, "Alias")</th>
                                    <th>@CommonLoc.GetOrDefault(CommonTextKeys.Description, "Description")</th>
                                    <th>@Loc.GetOrDefault(SettingsTextKeys.CredentialsColumnValue, "Value")</th>
                                    <th class="custom-settings-actions">@CommonLoc.GetOrDefault(CommonTextKeys.Actions, "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in _view.FreeForm)
                                {
                                    <tr class="hover:bg-base-200/40 align-top" @key="slot.Key">
                                        <td data-label="@Loc.GetOrDefault(SettingsTextKeys.CredentialsColumnAlias, "Alias")">
                                            <div class="min-w-0">
                                                <p class="min-w-0 break-words font-medium [overflow-wrap:anywhere]">@(slot.Alias ?? slot.Label)</p>
                                                <code class="text-xs text-base-content/60">@slot.Key</code>
                                            </div>
                                        </td>
                                        <td class="text-sm text-base-content/70" data-label="@CommonLoc.GetOrDefault(CommonTextKeys.Description, "Description")">
                                            @if (!string.IsNullOrWhiteSpace(slot.Description))
                                            {
                                                <span dir="auto" class="min-w-0 break-words [overflow-wrap:anywhere]">@slot.Description</span>
                                            }
                                        </td>
                                        <td data-label="@Loc.GetOrDefault(SettingsTextKeys.CredentialsColumnValue, "Value")">
                                            <span class="badge @(IsConfigured(slot) ? "badge-success badge-soft" : "badge-warning badge-soft")">
                                                @(IsConfigured(slot)
                                                    ? Loc.GetOrDefault(SettingsTextKeys.CredentialsValueSetBadge, "Set")
                                                    : Loc.GetOrDefault(SettingsTextKeys.CredentialsValueNotSetBadge, "Not set"))
                                            </span>
                                        </td>
                                        <td class="custom-settings-actions" data-label="@CommonLoc.GetOrDefault(CommonTextKeys.Actions, "Actions")">
                                            <div class="flex flex-wrap justify-end gap-2">
                                                <button class="btn btn-sm" @onclick="() => OpenEditDialogAsync(slot.Key, true)">
                                                    <span class="iconify lucide--pencil size-4" aria-hidden="true"></span>@CommonLoc.GetOrDefault(CommonTextKeys.Edit, "Edit")
                                                </button>
                                                <button class="btn btn-sm btn-outline btn-error" @onclick="() => DeleteAsync(slot.Key, slot.Alias ?? slot.Label)">
                                                    <span class="iconify lucide--trash-2 size-4" aria-hidden="true"></span>@CommonLoc.GetOrDefault(CommonTextKeys.Delete, "Delete")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>

</div>
