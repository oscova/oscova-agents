            [var root] when IsFolderName(root, UserFileNames.TasksDirectory) => LocalizeFolderPurpose(
                SettingsTextKeys.FilesTasksFolderTitle,
                "Managed tasks",
                SettingsTextKeys.FilesTasksFolderDescription,
                "Contains scheduled and externally triggered task definitions."),
            [var root, _] when IsFolderName(root, UserFileNames.TasksDirectory) => LocalizeFolderPurpose(
                SettingsTextKeys.FilesTaskFolderTitle,
                "Task folder",
                SettingsTextKeys.FilesTaskFolderDescription,
                "Stores one task definition and its run history."),
            [var root, _, var runs] when IsFolderName(root, UserFileNames.TasksDirectory) &&
                                              IsFolderName(runs, UserFileNames.RunsDirectory) => LocalizeFolderPurpose(
                SettingsTextKeys.FilesTaskRunsFolderTitle,
                "Task run history",
                SettingsTextKeys.FilesTaskRunsFolderDescription,
                "Stores managed run indexes, transcripts, and session artifacts for this task."),
            [var root] when IsFolderName(root, UserFileNames.MemoryDirectory) => LocalizeFolderPurpose(
