                "User memory",
                SettingsTextKeys.FilesMemoryFolderDescription,
                "Stores long-term, topic, daily, and conversation memory data."),
            [var root, var daily] when IsFolderName(root, UserFileNames.MemoryDirectory) &&
                                            IsFolderName(daily, "daily") => LocalizeFolderPurpose(
                SettingsTextKeys.FilesDailyMemoryFolderTitle,
                "Daily memory",
                SettingsTextKeys.FilesDailyMemoryFolderDescription,
                "Stores dated Markdown memory logs used by memory routines."),
            [var root] when IsFolderName(root, UserFileNames.ChatDirectory) => LocalizeFolderPurpose(
