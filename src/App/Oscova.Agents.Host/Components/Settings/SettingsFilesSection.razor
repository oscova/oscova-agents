            [var root, var attachments] when IsFolderName(root, UserFileNames.ChatDirectory) &&
                                                  IsFolderName(attachments, "attachments") => LocalizeFolderPurpose(
                SettingsTextKeys.FilesChatAttachmentsFolderTitle,
                "Chat attachments",
                SettingsTextKeys.FilesChatAttachmentsFolderDescription,
                "Stores uploaded attachments in folders grouped by conversation."),
            [var root] when IsFolderName(root, UserFileNames.LogsDirectory) => LocalizeFolderPurpose(
                SettingsTextKeys.FilesLogsFolderTitle,
