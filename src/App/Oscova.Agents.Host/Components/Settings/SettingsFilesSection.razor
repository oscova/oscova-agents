                "Tool usage state",
                SettingsTextKeys.FilesToolGovernanceFolderDescription,
                "Stores quota counters used by governed tool-call limits."),
            _ => null
        };
    }

    private (string Title, string Description) LocalizeFolderPurpose(
        string titleKey,
        string titleFallback,
        string descriptionKey,
        string descriptionFallback) =>
        (
            Loc.GetOrDefault(titleKey, titleFallback),
            Loc.GetOrDefault(descriptionKey, descriptionFallback)
        );

    private static bool IsFolderName(string actual, string expected) =>
        string.Equals(actual, expected, StringComparison.OrdinalIgnoreCase);

    private static string CombinePath(string? parentPath, string name)
    {
        var path = string.IsNullOrWhiteSpace(parentPath)
            ? name
            : Path.Combine(parentPath, name);
        return PathHelper.ToSlashSeparatedRelativePath(path);
    }

    private string FormatSettingsText(string key, string fallback, params object?[] args)
    {
        return string.Format(
            CultureInfo.CurrentCulture,
            Loc.GetOrDefault(key, fallback),
            args);
    }

    private string FormatLibraryStatus(string key, string fallback, string? reason)
    {
        var status = Loc.GetOrDefault(key, fallback);
        return string.IsNullOrWhiteSpace(reason)
            ? status
            : $"{status}: {reason}";
    }

    public void Dispose()
    {
        StopLibraryIndexRefresh();
    }
}

