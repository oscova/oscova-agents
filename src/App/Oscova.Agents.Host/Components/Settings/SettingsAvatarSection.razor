@using Oscova.Agents.Avatar.Contracts
@using Oscova.Agents.Core.Avatar.Contracts
@using Oscova.Agents.Core.Settings
@using Oscova.Agents.Host
@using Oscova.Agents.Host.Components
@using Oscova.Agents.Host.Constants
@using System.Net
@implements IDisposable
@inject HttpClient Http
@inject IToastService ToastService
@inject IDialogService DialogService
@inject ILogger<SettingsAvatarSection> Logger
@inject AvatarUpdateService AvatarUpdates
@inject IStringLocalizer<SettingsText> Loc
@inject IStringLocalizer<CommonText> CommonLoc

<UnsavedChangesGuard IsDirty="@IsDirty" />

<div class="custom-settings-avatar space-y-6">
    <fieldset class="fieldset custom-settings-group custom-settings-form">
        <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.AvatarConnectionHeading, "Connection")</legend>
        <div class="form-control">
            <label class="label pl-0" for="avatar-bridge-url">
                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarBridgeUrlLabel, "Bridge URL")</span>
            </label>
            <div class="custom-settings-connection">
                <label class="input w-full max-w-md">
                    <span class="iconify lucide--link text-base-content/60 size-4.5"></span>
                    <input id="avatar-bridge-url" class="grow focus:outline-0"
                           placeholder="http://127.0.0.1:11318"
                           @bind="_draft.BridgeUrl"
                           @bind:event="oninput"
                           @bind:after="MarkEngineUnchecked" />
                </label>
                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsDirty || !IsEngineReachable)"
                        title="@(Loc.GetOrDefault(SettingsTextKeys.AvatarApplySavedAvatarSettingsTitle, "Apply to Live Avatar"))"
                        @onclick="ApplySavedSettingsAsync">
                    <span class="iconify lucide--refresh-cw size-4" aria-hidden="true"></span>
                    <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarApplySavedAvatarSettingsButton, "Apply to Live Avatar")</span>
                </button>
                <button type="button"
                        @ref="_connectButton"
                        class="btn btn-ghost btn-sm"
                        disabled="@IsEngineChecking"
                        title="@(Loc.GetOrDefault(SettingsTextKeys.AvatarConnectEngineTitle, "Connect to Avatar Engine"))"
                        @onclick="HandleConnectAsync">
                    <iconify-icon icon="lucide:radar"></iconify-icon>
                    <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarConnectEngineButton, "Connect")</span>
                </button>
                @if (ShowLocalEngineStart)
                {
                    <button type="button"
                            class="btn btn-outline btn-sm"
                            disabled="@_isStartingLocalEngine"
                            @onclick="StartLocalEngineAsync">
                        <span class="iconify lucide--play size-4" aria-hidden="true"></span>
                        <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarStartEngineButton, "Start Avatar Engine")</span>
                    </button>
                }
            </div>
            <div class="form-control mt-3 max-w-md">
                <label class="label pl-0" for="avatar-access-mode">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarAccessModeLabel, "Access mode")</span>
                </label>
                <select id="avatar-access-mode" class="select select-bordered w-full" @bind="_draft.PreferredAccessMode" @bind:after="MarkEngineUnchecked">
                    <option value="@AvatarAccessMode.Shared">@Loc.GetOrDefault(SettingsTextKeys.AvatarAccessModeShared, "Shared")</option>
                    <option value="@AvatarAccessMode.Exclusive">@Loc.GetOrDefault(SettingsTextKeys.AvatarAccessModeExclusive, "Exclusive")</option>
                </select>
                <p class="text-xs mt-2 opacity-60">@Loc.GetOrDefault(SettingsTextKeys.AvatarAccessModeHelp, "Shared allows other paired clients. Exclusive blocks them until the Engine restarts.")</p>
            </div>
            <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                <span class="@EngineStatusBadgeClass">
                    <span class="@EngineStatusDotClass"></span>
                    @EngineStatusLabel
                </span>
                <p class="text-xs opacity-70">@EngineStatusDescription</p>
            </div>
            <p class="text-xs mt-2 opacity-60">@Loc.GetOrDefault(SettingsTextKeys.AvatarBridgeUrlDescription, "Saved bridge endpoint used by the shared avatar runtime.")</p>
            @if (IsDirty)
            {
                <p class="text-xs mt-2 text-warning">@Loc.GetOrDefault(SettingsTextKeys.AvatarSaveChangesWarning, "Save changes before applying them to the avatar engine.")</p>
            }
        </div>
    </fieldset>

    <fieldset class="fieldset custom-settings-group custom-settings-form">
        <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.AvatarAvatarHeading, "Avatar")</legend>
        <div class="form-control">
            <label class="label pl-0" for="avatar-selected-avatar">
                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarSelectedAvatarLabel, "Selected Avatar")</span>
            </label>
            <div class="flex items-center gap-2">
                <select id="avatar-selected-avatar" class="select select-bordered w-full max-w-md"
                        disabled="@(!CanSelectAvatar)"
                        value="@SelectedAvatarValue"
                        @onchange="OnAvatarSelectionChanged">
                    @foreach (var option in GetAvatarOptions())
                    {
                        <option @key="option.Value" value="@option.Value">@option.Label</option>
                    }
                </select>
                <button type="button"
                        class="btn btn-ghost btn-sm btn-square"
                        title="@(Loc.GetOrDefault(SettingsTextKeys.AvatarRefreshAvatarsTitle, "Refresh Avatars"))"
                        disabled="@(!IsEngineReachable)"
                        @onclick="RefreshEngineAsync">
                    <iconify-icon icon="lucide:refresh-cw"></iconify-icon>
                </button>
            </div>
            <p class="text-xs mt-2 opacity-60">@AvatarCatalogHint</p>
        </div>
        <div class="form-control mt-3 max-w-md">
            <label class="label pl-0" for="avatar-selected-hair">
                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarHairLabel, "Hair")</span>
            </label>
            <select id="avatar-selected-hair" class="select select-bordered w-full"
                    disabled="@(!CanSelectHair)"
                    value="@(_draft.SelectedHairId ?? string.Empty)"
                    @onchange="OnHairSelectionChanged">
                @foreach (var option in GetHairOptions())
                {
                    <option @key="option.Value" value="@option.Value">@option.Label</option>
                }
            </select>
            <p class="text-xs mt-2 opacity-60">@GetAppearanceHint(_hairCatalogLoaded, _draft.SelectedHairId, _availableHairOptions, SettingsTextKeys.AvatarChooseHairDescription, "Choose hair for the selected avatar.")</p>
        </div>
        <div class="form-control mt-3 max-w-md">
            <label class="label pl-0" for="avatar-selected-top">
                <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarTopClothingLabel, "Top")</span>
            </label>
            <select id="avatar-selected-top" class="select select-bordered w-full"
                    disabled="@(!CanSelectTopClothing)"
                    value="@(_draft.SelectedTopClothingId ?? string.Empty)"
                    @onchange="OnTopClothingSelectionChanged">
                @foreach (var option in GetTopClothingOptions())
                {
                    <option @key="option.Value" value="@option.Value">@option.Label</option>
                }
            </select>
            <p class="text-xs mt-2 opacity-60">@GetAppearanceHint(_topClothingCatalogLoaded, _draft.SelectedTopClothingId, _availableTopClothingOptions, SettingsTextKeys.AvatarChooseTopClothingDescription, "Choose a top for the selected avatar.")</p>
        </div>
        <div class="mt-4 flex">
            <button type="button"
                    class="btn btn-primary btn-sm"
                    disabled="@(!CanApplyAvatar)"
                    @onclick="ApplyAvatarAsync">
                <span class="iconify lucide--check size-4" aria-hidden="true"></span>
                <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarApplyAvatarButton, "Apply Appearance")</span>
            </button>
        </div>
    </fieldset>

    <fieldset class="fieldset custom-settings-group custom-settings-form">
        <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.AvatarExpressionHeading, "Expression")</legend>
        <div class="space-y-4">
            <div class="form-control">
                <label class="label pl-0" for="avatar-selected-emotion">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarSelectedEmotionLabel, "Selected Emotion")</span>
                </label>
                <div class="flex items-center gap-2">
                    <select id="avatar-selected-emotion" class="select select-bordered w-full max-w-md"
                            disabled="@(!CanSelectEmotion)"
                            value="@SelectedEmotionValue"
                            @onchange="OnEmotionSelectionChanged">
                        @foreach (var option in GetEmotionOptions())
                        {
                            <option @key="option.Value" value="@option.Value">@option.Label</option>
                        }
                    </select>
                    <button type="button"
                            class="btn btn-ghost btn-sm btn-square"
                            title="@(Loc.GetOrDefault(SettingsTextKeys.AvatarRefreshEmotionsTitle, "Refresh Emotions"))"
                            disabled="@(!IsEngineReachable)"
                            @onclick="RefreshEngineAsync">
                        <iconify-icon icon="lucide:refresh-cw"></iconify-icon>
                    </button>
                </div>
                <p class="text-xs mt-2 opacity-60">@EmotionCatalogHint</p>
            </div>

            <div class="form-control">
                <label class="label pl-0" for="avatar-blend-speed">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarBlendSpeedLabel, "Blend Speed")</span>
                </label>
                <div class="flex max-w-md items-center gap-3">
                    <input id="avatar-blend-speed" type="range"
                           min="0"
                           max="5"
                           step="0.1"
                           class="range range-primary min-w-0 w-full"
                           @bind="_draft.EmotionBlendSpeed"
                           @bind:culture="CultureInfo.InvariantCulture"
                           @bind:event="oninput" />
                    <div class="flex items-center gap-2" style="flex: 0 0 auto;">
                        <input id="avatar-blend-speed-value" type="number"
                               min="0"
                               max="5"
                               step="0.1"
                               class="input input-bordered input-sm w-24"
                               aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarBlendSpeedLabel, "Blend Speed")"
                               value="@_draft.EmotionBlendSpeed.ToString(CultureInfo.InvariantCulture)"
                               @oninput="HandleBlendSpeedChange" />
                    </div>
                </div>
            </div>
            <div class="form-control">
                <label class="label pl-0" for="avatar-cue-blend-in">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarCueBlendInLabel, "Cue Blend-In Seconds")</span>
                </label>
                <div class="flex max-w-md items-center gap-3">
                    <input id="avatar-cue-blend-in" type="range"
                           min="0.1" max="2" step="0.1"
                           class="range range-primary min-w-0 w-full"
                           @bind="_draft.EmotionCueBlendInSeconds"
                           @bind:culture="CultureInfo.InvariantCulture"
                           @bind:event="oninput" />
                    <div class="flex items-center gap-2" style="flex: 0 0 auto;">
                        <input id="avatar-cue-blend-in-value" type="number"
                               min="0.1" max="2" step="0.1"
                               class="input input-bordered input-sm w-24"
                               aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarCueBlendInLabel, "Cue Blend-In Seconds")"
                               value="@_draft.EmotionCueBlendInSeconds.ToString(CultureInfo.InvariantCulture)"
                               @oninput="HandleCueBlendInChange" />
                    </div>
                </div>
            </div>
            <div class="form-control">
                <label class="label pl-0" for="avatar-cue-restore-after">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarCueRestoreAfterLabel, "Cue Restore After Seconds")</span>
                </label>
                <div class="flex max-w-md items-center gap-3">
                    <input id="avatar-cue-restore-after" type="range"
                           min="1" max="10" step="0.5"
                           class="range range-primary min-w-0 w-full"
                           @bind="_draft.EmotionCueRestoreAfterSeconds"
                           @bind:culture="CultureInfo.InvariantCulture"
                           @bind:event="oninput" />
                    <div class="flex items-center gap-2" style="flex: 0 0 auto;">
                        <input id="avatar-cue-restore-after-value" type="number"
                               min="1" max="10" step="0.5"
                               class="input input-bordered input-sm w-24"
                               aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarCueRestoreAfterLabel, "Cue Restore After Seconds")"
                               value="@_draft.EmotionCueRestoreAfterSeconds.ToString(CultureInfo.InvariantCulture)"
                               @oninput="HandleCueRestoreAfterChange" />
                    </div>
                </div>
            </div>
            <p class="text-sm opacity-70">@Loc.GetOrDefault(SettingsTextKeys.AvatarCueTimingDescription, "Emotions from spoken replies blend in, hold, then return to the selected emotion at the blend speed above.")</p>
        </div>
        <div class="mt-4 flex">
            <button type="button"
                    class="btn btn-primary btn-sm"
                    disabled="@(!CanApplyExpression)"
                    @onclick="ApplyExpressionAsync">
                <span class="iconify lucide--check size-4" aria-hidden="true"></span>
                <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarApplyExpressionButton, "Apply Expression")</span>
            </button>
        </div>
    </fieldset>

    <fieldset class="fieldset custom-settings-group custom-settings-form">
        <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.AvatarWindowHeading, "Window")</legend>
        <div class="grid gap-4 lg:grid-cols-2">
            <div class="form-control">
                <label class="label pl-0" for="avatar-resolution">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolutionLabel, "Resolution")</span>
                </label>
                <select id="avatar-resolution" class="select select-bordered w-full"
                        value="@CurrentResolutionValue"
                        @onchange="HandleResolutionChange">
                    <option value="1920x1080">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution1920x1080, "1920x1080 (16:9)")</option>
                    <option value="2560x1440">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution2560x1440, "2560x1440 (16:9)")</option>
                    <option value="3840x2160">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution3840x2160, "3840x2160 (16:9)")</option>
                    <option value="2560x1080">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution2560x1080, "2560x1080 (21:9)")</option>
                    <option value="3440x1440">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution3440x1440, "3440x1440 (21:9)")</option>
                    <option value="5120x2160">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution5120x2160, "5120x2160 (21:9)")</option>
                    <option value="1280x720">@Loc.GetOrDefault(SettingsTextKeys.AvatarResolution1280x720, "1280x720 (16:9)")</option>
                </select>
            </div>

            <div class="form-control">
                <label class="label pl-0" for="avatar-graphics-preset">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarGraphicsPresetLabel, "Graphics Preset")</span>
                </label>
                <select id="avatar-graphics-preset" class="select select-bordered w-full"
                        @bind="_draft.GraphicsPresetLevel">
                    <option value="0">@Loc.GetOrDefault(SettingsTextKeys.AvatarGraphicsPresetLow, "Low")</option>
                    <option value="1">@Loc.GetOrDefault(SettingsTextKeys.AvatarGraphicsPresetMedium, "Medium")</option>
                    <option value="2">@Loc.GetOrDefault(SettingsTextKeys.AvatarGraphicsPresetHigh, "High")</option>
                    <option value="3">@Loc.GetOrDefault(SettingsTextKeys.AvatarGraphicsPresetEpic, "Epic")</option>
                    <option value="4">@Loc.GetOrDefault(SettingsTextKeys.AvatarGraphicsPresetCinematic, "Cinematic")</option>
                </select>
            </div>

            <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3 pl-0">
                    <input type="checkbox" class="checkbox checkbox-primary" @bind="_draft.IsFullscreen" />
                    <span class="label-text">@Loc.GetOrDefault(SettingsTextKeys.AvatarFullscreenLabel, "Fullscreen")</span>
                </label>
            </div>

            <div class="form-control">
                <label class="flex cursor-pointer items-start gap-3">
                    <input type="checkbox" name="avatar-ray-tracing" class="checkbox checkbox-primary mt-1" @bind="_draft.IsRayTracingEnabled" />
                    <span class="min-w-0">
                        <span class="label-text block">@Loc.GetOrDefault(SettingsTextKeys.AvatarRayTracingLabel, "Ray Tracing")</span>
                        <span class="mt-1 block text-xs opacity-70">@Loc.GetOrDefault(SettingsTextKeys.AvatarRayTracingDescription, "Enables supported ray-traced effects independently of the quality preset. Off by default and may reduce performance.")</span>
                    </span>
                </label>
            </div>

            <div class="form-control">
                <label class="label pl-0" for="avatar-background-color">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarBackgroundColorLabel, "Background Color")</span>
                </label>
                <div class="flex items-center gap-3">
                    <input id="avatar-background-color" type="color"
                           class="input input-bordered input-sm h-10 w-16 p-1"
                           @bind="BackgroundColorHex"
                           @bind:event="oninput" />
                    <span class="text-sm opacity-70">@BackgroundColorHex</span>
                </div>
            </div>
        </div>
        <div class="mt-4 flex">
            <button type="button"
                    class="btn btn-primary btn-sm"
                    disabled="@(!IsEngineReachable)"
                    @onclick="ApplyWindowAsync">
                <span class="iconify lucide--check size-4" aria-hidden="true"></span>
                <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarApplyWindowButton, "Apply Window")</span>
            </button>
        </div>
    </fieldset>

    <fieldset class="fieldset custom-settings-group custom-settings-form" disabled="@(_presentationTest is not null)">
        <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationHeading, "Presentation")</legend>
        <div class="form-control max-w-md">
            <label for="avatar-presentation-mode" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationModeLabel, "Layout mode")</label>
            <select id="avatar-presentation-mode" class="select select-bordered" @bind="_draft.Presentation.Mode">
                <option value="Auto">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationAutoLabel, "Auto")</option>
                <option value="Subtitle">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationSubtitleLabel, "Subtitle")</option>
                <option value="Side">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationSideLabel, "Side")</option>
            </select>
        </div>
        <div class="form-control max-w-md mt-3">
            <label for="avatar-message-display-duration" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageDisplayDurationLabel, "Display Duration")</label>
            <div class="flex items-center gap-2">
                <input id="avatar-message-display-duration" type="number" min="0" step="0.1" class="input input-bordered input-sm w-24" @bind="_draft.Presentation.DurationSeconds" @bind:event="oninput" />
                <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarSecondsUnit, "seconds")</span>
            </div>
        </div>
        <div class="grid gap-4 lg:grid-cols-2 mt-4">
            @foreach (var (layoutName, layout) in new[] { ("Subtitle", _draft.Presentation.Subtitle), ("Side", _draft.Presentation.Side) })
            {
                var prefix = $"avatar-{layoutName.ToLowerInvariant()}";
                <fieldset class="fieldset border border-base-300 rounded p-4 space-y-3">
                    <legend class="fieldset-legend">@(layoutName == "Subtitle" ? Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationSubtitleLabel, "Subtitle") : Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationSideLabel, "Side"))</legend>
                    <div class="form-control">
                        <label for="@(prefix + "-font")" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageFontSizeLabel, "Message Font Size")</label>
                        <div class="flex items-center gap-3 max-w-md">
                            <input id="@(prefix + "-font")" type="range" min="8" max="120" step="1" class="range range-primary" @bind="layout.FontSize" @bind:event="oninput" />
                            <input id="@(prefix + "-font-value")" type="number" min="8" max="120" class="input input-bordered input-sm w-24" aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageFontSizeLabel, "Message Font Size")" value="@(layout.FontSize)" @oninput="args => HandleMessageFontSizeChange(layout, args)" />
                        </div>
                    </div>
                    <div class="form-control">
                        <label for="@(prefix + "-color")" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageColorLabel, "Color")</label>
                        <input id="@(prefix + "-color")" type="color" class="input input-bordered input-sm h-10 w-16 p-1" value="@ToHexColor(layout.Red, layout.Green, layout.Blue)" @oninput="args => HandleMessageColorChange(layout, args)" />
                    </div>
                    <div class="form-control">
                        <label for="@(prefix + "-opacity")" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageColorOpacityLabel, "Opacity")</label>
                        <div class="flex items-center gap-3 max-w-md">
                            <input id="@(prefix + "-opacity")" type="range" min="0" max="1" step="0.01" class="range range-primary" @bind="layout.Alpha" @bind:culture="CultureInfo.InvariantCulture" @bind:event="oninput" />
                            <input id="@(prefix + "-opacity-value")" type="number" min="0" max="100" class="input input-bordered input-sm w-24" aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageColorOpacityLabel, "Opacity")" value="@((layout.Alpha * PercentDisplayRatio).ToString(CultureInfo.InvariantCulture))" @oninput="args => HandleMessageOpacityChange(layout, args)" />
                            <span>%</span>
                        </div>
                    </div>
                    <div class="form-control">
                        <label for="@(prefix + "-yaw")" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarCameraYawLabel, "Camera Yaw")</label>
                        <div class="flex items-center gap-3 max-w-md">
                            <input id="@(prefix + "-yaw")" type="range" min="-45" max="45" step="0.1" class="range range-primary" value="@GetDisplayYaw(layout).ToString(CultureInfo.InvariantCulture)" @oninput="args => HandleCameraYawChange(layout, args)" />
                            <input id="@(prefix + "-yaw-value")" type="number" min="-45" max="45" step="0.1" class="input input-bordered input-sm w-24" aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarCameraYawLabel, "Camera Yaw")" value="@GetDisplayYaw(layout).ToString(CultureInfo.InvariantCulture)" @oninput="args => HandleCameraYawChange(layout, args)" />
                            <span>&deg;</span>
                        </div>
                    </div>
                    <dl class="grid grid-cols-2 gap-3 text-sm">
                        <div><dt>@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageLayoutLeftLabel, "Left")</dt><dd>@FormatPercent(layout.PositionX)</dd></div>
                        <div><dt>@Loc.GetOrDefault(SettingsTextKeys.AvatarMessageLayoutTopLabel, "Top")</dt><dd>@FormatPercent(layout.PositionY)</dd></div>
                        <div><dt>@Loc.GetOrDefault(SettingsTextKeys.AvatarTransformWidthLabel, "Width (%)")</dt><dd>@FormatPercent(layout.Width)</dd></div>
                        <div><dt>@Loc.GetOrDefault(SettingsTextKeys.AvatarTransformHeightLabel, "Height (%)")</dt><dd>@FormatPercent(layout.Height)</dd></div>
                    </dl>
                    <div class="flex flex-wrap gap-2">
                        <button id="@(prefix + "-edit")" type="button" class="btn btn-outline btn-sm" @onclick="() => OpenMessageLayoutEditorAsync(layout)">@Loc.GetOrDefault(SettingsTextKeys.AvatarEditMessageLayoutButton, "Edit layout")</button>
                        <button id="@(prefix + "-test")" type="button" class="btn btn-outline btn-sm" disabled="@(!IsEngineReachable || _draft.Presentation.DurationSeconds <= 0 || string.IsNullOrWhiteSpace(_testMessage))" @onclick="() => TestPresentationAsync(layoutName)">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationTestButton, "Test layout")</button>
                    </div>
                </fieldset>
            }
        </div>
        <div class="form-control mt-4">
            <label for="avatar-message-test" class="label pl-0">@Loc.GetOrDefault(SettingsTextKeys.AvatarPreviewTextLabel, "Preview Text")</label>
            <textarea id="avatar-message-test" class="textarea textarea-bordered w-full" rows="3" @bind="_testMessage" @bind:event="oninput"></textarea>
            <p class="text-xs mt-2 opacity-60">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationTestDescription, "Testing uses the display duration above, then restores the selected layout mode. Set a duration greater than zero to test.")</p>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
            <button id="avatar-presentation-apply" type="button" class="btn btn-primary btn-sm" disabled="@(!IsEngineReachable)" @onclick="ApplyPresentationAsync">@Loc.GetOrDefault(SettingsTextKeys.AvatarApplyPresentationButton, "Apply Presentation")</button>
            <button type="button" class="btn btn-outline btn-sm" disabled="@(!IsEngineReachable)" @onclick="ClearMessageDisplayAsync">@Loc.GetOrDefault(SettingsTextKeys.AvatarClearPreviewButton, "Clear")</button>
            <button type="button" class="btn btn-outline btn-sm" disabled="@(!IsEngineReachable || string.IsNullOrWhiteSpace(_testMessage))" @onclick="TestMessageDisplayAsync">@Loc.GetOrDefault(SettingsTextKeys.AvatarSendPreviewButton, "Send Preview")</button>
        </div>
    </fieldset>
    @if (_presentationTest is not null)
    {
        <button id="avatar-presentation-end-test" type="button" class="btn btn-outline btn-sm" @onclick="EndPresentationTestAsync">@Loc.GetOrDefault(SettingsTextKeys.AvatarPresentationEndTestButton, "End Test")</button>
    }

    <fieldset class="fieldset custom-settings-group custom-settings-form">
        <legend class="fieldset-legend">@Loc.GetOrDefault(SettingsTextKeys.AvatarAudioHeading, "Audio")</legend>
        <div class="grid gap-4 lg:grid-cols-2">
            <div class="form-control">
                <label class="label pl-0" for="avatar-speech-volume">
                    <span class="label-text font-medium">@Loc.GetOrDefault(SettingsTextKeys.AvatarSpeechVolumeLabel, "Speech Volume")</span>
                </label>
                <div class="flex max-w-md items-center gap-3">
                    <input id="avatar-speech-volume" type="range"
                           min="0"
                           max="1"
                           step="0.01"
                           class="range range-primary min-w-0 w-full"
                           @bind="_draft.SpeechVolume"
                           @bind:culture="CultureInfo.InvariantCulture"
                           @bind:event="oninput" />
                    <div class="flex items-center gap-2" style="flex: 0 0 auto;">
                        <input id="avatar-speech-volume-value" type="number"
                               min="0"
                               max="100"
                               step="1"
                               class="input input-bordered input-sm w-24"
                               aria-label="@Loc.GetOrDefault(SettingsTextKeys.AvatarSpeechVolumeLabel, "Speech Volume")"
                               value="@SpeechVolumePercent.ToString(CultureInfo.InvariantCulture)"
                               @oninput="HandleSpeechVolumeChange" />
                        <span class="text-sm text-base-content/70">%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4 flex">
            <button type="button"
                    class="btn btn-primary btn-sm"
                    disabled="@(!IsEngineReachable)"
                    @onclick="ApplyAudioAsync">
                <span class="iconify lucide--check size-4" aria-hidden="true"></span>
                <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarApplyAudioButton, "Apply Audio")</span>
            </button>
        </div>
    </fieldset>

    <div class="flex flex-wrap items-center justify-between gap-2">
        <button type="button"
                class="btn btn-warning btn-sm"
                title="@(Loc.GetOrDefault(SettingsTextKeys.AvatarShutdownAvatarTitle, "Shutdown Avatar"))"
                disabled="@(!IsEngineReachable)"
                @onclick="ConfirmShutdownAvatarAsync">
            <iconify-icon icon="lucide:power"></iconify-icon>
            <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarShutdownAvatarButton, "Shutdown Avatar")</span>
        </button>

        <div class="flex flex-wrap justify-end gap-2">
            <button type="button"
                    class="btn btn-outline btn-sm"
                    @onclick="ResetToDefaults">
                @Loc.GetOrDefault(SettingsTextKeys.AvatarResetToDefaultsButton, "Reset to defaults")
            </button>
            <button type="button"
                    class="btn btn-primary btn-sm"
                    disabled="@(!IsDirty)"
                    @onclick="SaveSettingsAsync">
                <span class="iconify lucide--save size-4" aria-hidden="true"></span>
                <span>@Loc.GetOrDefault(SettingsTextKeys.AvatarSaveSettingsButton, "Save Settings")</span>
            </button>
        </div>
    </div>
</div>

@code {
    private const float DisplayToServerRatio = 9.0f;
    private const float PercentDisplayRatio = 100.0f;
    private AvatarSettings.Snapshot _saved = new();
    private AvatarSettings.Snapshot _draft = new();
    private List<string> _availableAvatars = new();
    private List<string> _availableEmotions = new();
    private List<SelectOption> _availableHairOptions = new();
    private List<SelectOption> _availableTopClothingOptions = new();
    private string _testMessage = string.Empty;
    private CancellationTokenSource? _presentationTest;
    private bool _disposed;
    private AvatarEngineState _engineState = AvatarEngineState.Unknown;
    private bool _avatarCatalogLoaded;
    private bool _emotionCatalogLoaded;
    private bool _hairCatalogLoaded;
    private bool _topClothingCatalogLoaded;
    private bool _isLocalEngineInstalled;
    private bool _isStartingLocalEngine;
    private bool _localEngineStartRequested;
    private int _engineRefreshVersion;
    private int _appearanceCatalogVersion;
    private string? _engineStatusDetail;
    private ElementReference _connectButton;
    private bool _restoreConnectFocus;

    private bool IsDirty => !AreSettingsEqual(_saved, _draft);
    private string CurrentResolutionValue => $"{_draft.ResolutionWidth}x{_draft.ResolutionHeight}";
    private bool IsEngineChecking => _engineState == AvatarEngineState.Checking;
    private bool IsEngineReachable => _engineState is AvatarEngineState.Connected or AvatarEngineState.CatalogError;
    private bool ShowLocalEngineStart =>
        _isLocalEngineInstalled &&
        !_localEngineStartRequested &&
        !IsEngineChecking &&
        _engineState == AvatarEngineState.Offline;
    private bool CanSelectAvatar => _avatarCatalogLoaded && !IsEngineChecking;
    private bool CanSelectEmotion => _emotionCatalogLoaded && !IsEngineChecking;
    private bool CanSelectHair => _hairCatalogLoaded && !IsEngineChecking;
    private bool CanSelectTopClothing => _topClothingCatalogLoaded && !IsEngineChecking;
    private bool CanApplyAvatar =>
        IsEngineReachable &&
        _avatarCatalogLoaded &&
        !string.IsNullOrWhiteSpace(_draft.SelectedAvatar) &&
        _availableAvatars.Contains(_draft.SelectedAvatar, StringComparer.Ordinal);
    private bool CanApplyExpression =>
        IsEngineReachable &&
        _emotionCatalogLoaded &&
        !string.IsNullOrWhiteSpace(_draft.SelectedEmotion) &&
        _availableEmotions.Contains(_draft.SelectedEmotion, StringComparer.Ordinal);

    private string EngineStatusLabel => _engineState switch
    {
        AvatarEngineState.Checking => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineCheckingStatus, "Checking"),
        AvatarEngineState.Connected => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineConnectedStatus, "Connected"),
        AvatarEngineState.Offline => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineOfflineStatus, "Offline"),
        AvatarEngineState.PairingRequired => Loc.GetOrDefault(SettingsTextKeys.AvatarEnginePairingRequiredStatus, "Pairing required"),
        AvatarEngineState.AccessConflict => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineAccessConflictStatus, "Access conflict"),
        AvatarEngineState.RateLimited => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineRateLimitedStatus, "Rate limited"),
        AvatarEngineState.ConfigurationError => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineConfigurationErrorStatus, "Configuration issue"),
        AvatarEngineState.EngineError => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineErrorStatus, "Engine error"),
        AvatarEngineState.CatalogError => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineCatalogErrorStatus, "Catalog issue"),
        _ => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineNotCheckedStatus, "Not checked")
    };

    private string EngineStatusDescription => _engineState switch
    {
        AvatarEngineState.Checking => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineCheckingDescription, "Connecting to the Avatar Engine and loading live choices."),
        AvatarEngineState.Connected => FormatSettingsText(SettingsTextKeys.AvatarEngineConnectedDescription, "Avatar Engine is reachable at {0}.", _draft.BridgeUrl),
        AvatarEngineState.Offline => FormatSettingsText(SettingsTextKeys.AvatarEngineOfflineDescription, "Could not reach the Avatar Engine at {0}. Saved settings remain editable.", _draft.BridgeUrl),
        AvatarEngineState.PairingRequired => _engineStatusDetail ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEnginePairingRequiredDescription, "Select Connect to pair this Oscova installation."),
        AvatarEngineState.AccessConflict => _engineStatusDetail ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEngineAccessConflictDescription, "Another client currently owns incompatible runtime access."),
        AvatarEngineState.RateLimited => _engineStatusDetail ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEngineRateLimitedDescription, "Wait before selecting Connect again."),
        AvatarEngineState.ConfigurationError => _engineStatusDetail ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEngineConfigurationErrorDescription, "Fix local settings storage, then select Connect again."),
        AvatarEngineState.EngineError => _engineStatusDetail ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEngineErrorDescription, "The Avatar Engine returned an unexpected response. Select Connect to try again."),
        AvatarEngineState.CatalogError => _engineStatusDetail ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEngineCatalogErrorDescription, "The engine is reachable, but one or more live choice lists could not be loaded."),
        _ => Loc.GetOrDefault(SettingsTextKeys.AvatarEngineNotCheckedDescription, "Select Connect to load live avatars and expressions.")
    };

    private string EngineStatusBadgeClass => _engineState switch
    {
        AvatarEngineState.Connected => "badge badge-success badge-soft gap-2",
        AvatarEngineState.Offline => "badge badge-error badge-soft gap-2",
        AvatarEngineState.CatalogError or AvatarEngineState.PairingRequired or AvatarEngineState.AccessConflict or AvatarEngineState.RateLimited or AvatarEngineState.ConfigurationError or AvatarEngineState.EngineError => "badge badge-warning badge-soft gap-2",
        AvatarEngineState.Checking => "badge badge-info badge-soft gap-2",
        _ => "badge badge-ghost gap-2"
    };

    private string EngineStatusDotClass => _engineState switch
    {
        AvatarEngineState.Connected => "status status-success status-sm",
        AvatarEngineState.Offline => "status status-error status-sm",
        AvatarEngineState.CatalogError or AvatarEngineState.PairingRequired or AvatarEngineState.AccessConflict or AvatarEngineState.RateLimited or AvatarEngineState.ConfigurationError or AvatarEngineState.EngineError => "status status-warning status-sm",
        AvatarEngineState.Checking => "loading loading-spinner loading-xs",
        _ => "status status-neutral status-sm"
    };

    private string AvatarCatalogHint =>
        GetCatalogHint(_avatarCatalogLoaded, _draft.SelectedAvatar, _availableAvatars, SettingsTextKeys.AvatarChooseAvatarDescription, "Choose an avatar to display");

    private string EmotionCatalogHint =>
        GetCatalogHint(_emotionCatalogLoaded, _draft.SelectedEmotion, _availableEmotions, SettingsTextKeys.AvatarChooseEmotionDescription, "Choose an expression from the running engine.");

    private string SelectedAvatarValue => _draft.SelectedAvatar ?? string.Empty;
    private string SelectedEmotionValue => _draft.SelectedEmotion ?? string.Empty;

    private enum AvatarEngineState
    {
        Unknown,
        Checking,
        Connected,
        Offline,
        CatalogError,
        PairingRequired,
        AccessConflict,
        RateLimited,
        ConfigurationError,
        EngineError
    }

    private sealed record SelectOption(string Value, string Label);

    private string BackgroundColorHex
    {
        get => ToHexColor(_draft.BackgroundColorRed, _draft.BackgroundColorGreen, _draft.BackgroundColorBlue);
        set
        {
            if (TryParseHexColorBytes(value, out var red, out var green, out var blue))
            {
                _draft.BackgroundColorRed = red;
                _draft.BackgroundColorGreen = green;
                _draft.BackgroundColorBlue = blue;
            }
        }
    }

    private void HandleMessageColorChange(AvatarPresentationLayout layout, ChangeEventArgs args)
    {
        if (TryParseHexColor(args.Value?.ToString() ?? string.Empty, out var red, out var green, out var blue))
        {
            layout.Red = red;
            layout.Green = green;
            layout.Blue = blue;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AvatarUpdates.InstallationChanged += OnInstallationChanged;
        _testMessage = Loc.GetOrDefault(SettingsTextKeys.AvatarDefaultPreviewMessage, "This is a test message.");
        await LoadSettingsAsync();
        await LoadLocalEngineInstalledAsync();
        await RefreshEngineAsync(showToasts: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreConnectFocus && !IsEngineChecking)
        {
            // Connecting disables the trigger before the pairing dialog can remember it.
            _restoreConnectFocus = false;
            await _connectButton.FocusAsync();
        }
    }

    private async Task LoadLocalEngineInstalledAsync()
    {
        try
        {
            _isLocalEngineInstalled = await Http.GetFromJsonAsync<bool>(ApiRoutes.AvatarBridge.LocalEngineInstalled);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to check local Avatar Engine installation.");
            _isLocalEngineInstalled = false;
        }
    }

    private void OnInstallationChanged(object? sender, EventArgs args) => _ = RefreshLocalInstallationAsync();

    private async Task RefreshLocalInstallationAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) { return; }
                await LoadLocalEngineInstalledAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex) when (_disposed || ex is ObjectDisposedException) { }
    }

    private async Task StartLocalEngineAsync()
    {
        _isStartingLocalEngine = true;
        try
        {
            using var response = await Http.PostAsync(
                ApiRoutes.AvatarBridge.StartLocalEngine(Uri.EscapeDataString(_draft.BridgeUrl ?? string.Empty)),
                null);
            if (response.IsSuccessStatusCode)
            {
                _localEngineStartRequested = true;
                ToastService.Show(
                    Loc.GetOrDefault(SettingsTextKeys.AvatarStartEngineStartedToast, "Avatar Engine started. Wait for its window, then select Connect."),
                    ToastType.Success);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                ToastService.Show(
                    Loc.GetOrDefault(SettingsTextKeys.AvatarStartEngineLocalUrlToast, "Use an http://localhost or http://127.0.0.1 Bridge URL to start the local Avatar Engine."),
                    ToastType.Error);
            }
            else
            {
                ToastService.Show(
                    Loc.GetOrDefault(SettingsTextKeys.AvatarStartEngineFailedToast, "Avatar Engine could not be started."),
                    ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start local Avatar Engine.");
            ToastService.Show(
                Loc.GetOrDefault(SettingsTextKeys.AvatarStartEngineFailedToast, "Avatar Engine could not be started."),
                ToastType.Error);
        }
        finally
        {
            _isStartingLocalEngine = false;
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<AvatarSettings.Snapshot>(ApiRoutes.AvatarBridge.Settings);
            _saved = settings?.Clone() ?? new AvatarSettings.Snapshot();
            _draft = _saved.Clone();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load avatar settings.");
            ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarSettingsLoadErrorToast, "Avatar settings load error: {0}", ex.Message), ToastType.Error);
        }
    }

    private void MarkEngineUnchecked()
    {
        unchecked
        {
            _engineRefreshVersion++;
        }

        _engineState = AvatarEngineState.Unknown;
        _engineStatusDetail = null;
        _avatarCatalogLoaded = false;
        _emotionCatalogLoaded = false;
        ClearAppearanceCatalogs();
        _availableAvatars = [];
        _availableEmotions = [];
    }

    private float GetDisplayYaw(AvatarPresentationLayout layout)
    {
        return layout.Yaw * DisplayToServerRatio;
    }

    private float SpeechVolumePercent => _draft.SpeechVolume * PercentDisplayRatio;

    private static string FormatPercent(float value) =>
        string.Format(CultureInfo.CurrentCulture, "{0:0.#}%", value * PercentDisplayRatio);

    private void HandleCameraYawChange(AvatarPresentationLayout layout, ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var displayValue))
        {
            layout.Yaw = Math.Clamp(displayValue / DisplayToServerRatio, -5.0f, 5.0f);
        }
    }

    private void HandleBlendSpeedChange(ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var value))
        {
            _draft.EmotionBlendSpeed = Math.Clamp(value, 0.0f, 5.0f);
        }
    }

    private void HandleCueBlendInChange(ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var value))
        {
            _draft.EmotionCueBlendInSeconds = Math.Clamp(value, 0.1f, 2.0f);
        }
    }

    private void HandleCueRestoreAfterChange(ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var value))
        {
            _draft.EmotionCueRestoreAfterSeconds = Math.Clamp(value, 1.0f, 10.0f);
        }
    }

    private void HandleMessageFontSizeChange(AvatarPresentationLayout layout, ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var value))
        {
            layout.FontSize = (int)MathF.Round(Math.Clamp(value, 8.0f, 120.0f));
        }
    }

    private void HandleMessageOpacityChange(AvatarPresentationLayout layout, ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var displayValue))
        {
            layout.Alpha = Math.Clamp(displayValue / PercentDisplayRatio, 0.0f, 1.0f);
        }
    }

    private void HandleSpeechVolumeChange(ChangeEventArgs args)
    {
        if (TryParseDisplayValue(args, out var displayValue))
        {
            _draft.SpeechVolume = Math.Clamp(displayValue / PercentDisplayRatio, 0.0f, 1.0f);
        }
    }

    private static bool TryParseDisplayValue(ChangeEventArgs args, out float displayValue)
    {
        displayValue = 0.0f;
        return args.Value != null &&
               float.TryParse(args.Value.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out displayValue);
    }

    private async Task OpenMessageLayoutEditorAsync(AvatarPresentationLayout layout)
    {
        var input = new AvatarMessageLayoutDialog.Input(
            _draft.ResolutionWidth,
            _draft.ResolutionHeight,
            new AvatarMessageLayoutDialog.Layout(
                layout.PositionX,
                layout.PositionY,
                layout.Width,
                layout.Height));
        var result = await DialogService.ShowAsync<AvatarMessageLayoutDialog, AvatarMessageLayoutDialog.Layout>(
            new Dictionary<string, object?> { [nameof(AvatarMessageLayoutDialog.Input)] = input });

        if (result is { IsOk: true, Data: not null })
        {
            layout.PositionX = result.Data.Left;
            layout.PositionY = result.Data.Top;
            layout.Width = result.Data.Width;
            layout.Height = result.Data.Height;
        }
    }

    private void HandleResolutionChange(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        var parts = value.Split('x');
        if (parts.Length == 2 && int.TryParse(parts[0], out var width) && int.TryParse(parts[1], out var height))
        {
            _draft.ResolutionWidth = width;
            _draft.ResolutionHeight = height;
        }
    }

    private async Task ApplySavedSettingsAsync()
    {
        try
        {
            using var httpResponse = await Http.PostAsync(ApiRoutes.AvatarBridge.Sync, null);
            var response = await httpResponse.Content.ReadFromJsonAsync<AvatarRuntimeSyncResponse>();
            if (httpResponse.IsSuccessStatusCode && response?.Success == true)
            {
                ToastService.Show(Loc.GetOrDefault(SettingsTextKeys.AvatarSavedSettingsAppliedToast, "Saved avatar settings applied"), ToastType.Success);
                var refreshVersion = ++_engineRefreshVersion;
                await LoadEngineCatalogsAfterConnectedAsync(refreshVersion, showToasts: false);
                return;
            }

            SetEngineFailure(response?.ErrorCode, response?.Description);
            ToastService.Show(response?.Description ?? Loc.GetOrDefault(SettingsTextKeys.AvatarApplySavedSettingsFailedToast, "Avatar settings could not be applied."), ToastType.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply saved avatar settings.");
            ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarSyncErrorToast, "Avatar sync error: {0}", ex.Message), ToastType.Error);
        }
    }

    private Task RefreshEngineAsync()
    {
        return RefreshEngineAsync(showToasts: true);
    }

    private Task RefreshEngineAsync(bool showToasts) =>
        SyncAndLoadEngineAsync(_saved.BridgeUrl, showToasts, allowPairing: false);

    private async Task HandleConnectAsync()
    {
        var bridgeUrl = _draft.BridgeUrl?.Trim() ?? string.Empty;
        if (!await SaveConnectionPreferenceAsync(bridgeUrl, _draft.PreferredAccessMode))
        {
            return;
        }

        await SyncAndLoadEngineAsync(bridgeUrl, showToasts: true, allowPairing: true);
    }

    private async Task<bool> SaveConnectionPreferenceAsync(string bridgeUrl, AvatarAccessMode accessMode)
    {
        try
        {
            using var response = await Http.PutAsync(
                ApiRoutes.AvatarBridge.ConnectionSettings(
                    Uri.EscapeDataString(bridgeUrl),
                    Uri.EscapeDataString(accessMode.ToString())),
                null);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == HttpStatusCode.BadRequest)
                {
                    _engineState = AvatarEngineState.ConfigurationError;
                    _engineStatusDetail = await response.Content.ReadAsStringAsync();
                    if (string.IsNullOrWhiteSpace(_engineStatusDetail))
                    {
                        _engineStatusDetail = "BaseUrl and a valid accessMode are required.";
                    }
                    ToastService.Show(_engineStatusDetail, ToastType.Error);
                    return false;
                }

                throw new HttpRequestException(await response.Content.ReadAsStringAsync());
            }

            _saved.BridgeUrl = bridgeUrl;
            _saved.PreferredAccessMode = accessMode;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save Avatar Engine connection settings.");
            _engineState = AvatarEngineState.ConfigurationError;
            _engineStatusDetail = Loc.GetOrDefault(
                SettingsTextKeys.AvatarEngineConfigurationErrorDescription,
                "Fix local settings storage, then select Connect again.");
            ToastService.Show(_engineStatusDetail, ToastType.Error);
            return false;
        }
    }

    private async Task SyncAndLoadEngineAsync(string bridgeUrl, bool showToasts, bool allowPairing)
    {
        unchecked
        {
            _engineRefreshVersion++;
        }

        var refreshVersion = _engineRefreshVersion;
        _engineStatusDetail = null;
        _avatarCatalogLoaded = false;
        _emotionCatalogLoaded = false;
        ClearAppearanceCatalogs();
        _availableAvatars = [];
        _availableEmotions = [];

        if (string.IsNullOrWhiteSpace(bridgeUrl))
        {
            _engineState = AvatarEngineState.Unknown;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _engineState = AvatarEngineState.Checking;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var httpResponse = await Http.PostAsync(ApiRoutes.AvatarBridge.Sync, null);
            var sync = await httpResponse.Content.ReadFromJsonAsync<AvatarRuntimeSyncResponse>();

            if (!IsCurrentEngineRefresh(refreshVersion))
            {
                return;
            }

            if (sync?.Success != true)
            {
                SetEngineFailure(sync?.ErrorCode, sync?.Description, sync?.RetryAfterSeconds);
                if (showToasts && !(allowPairing && sync?.ErrorCode == "pairing_required"))
                {
                    ToastService.Show(
                        _engineStatusDetail ?? sync?.Description ?? Loc.GetOrDefault(SettingsTextKeys.AvatarEngineOfflineToast, "Avatar Engine is not reachable."),
                        ToastType.Warning);
                }

                if (allowPairing && sync?.ErrorCode == "pairing_required")
                {
                    await StartPairingAsync(refreshVersion, bridgeUrl);
                }
                return;
            }

            await LoadEngineCatalogsAfterConnectedAsync(refreshVersion, showToasts);
        }
        catch (Exception ex)
        {
            if (!IsCurrentEngineRefresh(refreshVersion))
            {
                return;
            }

            Logger.LogWarning(ex, "Failed to refresh Avatar Engine state.");
            _engineState = AvatarEngineState.Offline;
            _localEngineStartRequested = false;
            _engineStatusDetail = ex.Message;
            if (showToasts)
            {
                ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarEngineRefreshFailedToast, "Avatar Engine refresh failed: {0}", ex.Message), ToastType.Error);
            }
        }
    }

    private bool IsCurrentEngineRefresh(int refreshVersion) => refreshVersion == _engineRefreshVersion;

    private async Task StartPairingAsync(int refreshVersion, string bridgeUrl)
    {
        using var startResponse = await Http.PostAsync(
            ApiRoutes.AvatarBridge.PairingStart(Uri.EscapeDataString(bridgeUrl)),
            null);
        var start = await startResponse.Content.ReadFromJsonAsync<AvatarPairingStartResult>();
        if (!IsCurrentEngineRefresh(refreshVersion))
        {
            return;
        }

        if (start?.Success != true || start.ExpiresInSeconds is null)
        {
            SetEngineFailure(start?.ErrorCode, start?.Description, start?.RetryAfterSeconds);
            ToastService.Show(
                _engineStatusDetail ?? start?.Description ?? Loc.GetOrDefault(SettingsTextKeys.AvatarPairingFailed, "Pairing failed. Request a new code and try again."),
                ToastType.Error);
            return;
        }

        var result = await DialogService.ShowAsync<PairAvatarEngineDialog>(
            new Dictionary<string, object?>
            {
                ["BaseUrl"] = bridgeUrl,
                ["ExpiresInSeconds"] = start.ExpiresInSeconds.Value,
                ["AccessMode"] = _draft.PreferredAccessMode
            });
        if (result != DialogResult.Ok)
        {
            _restoreConnectFocus = true;
            return;
        }

        await SyncAndLoadEngineAsync(bridgeUrl, showToasts: true, allowPairing: false);
    }

    private void SetEngineFailure(string? errorCode, string? description, int? retryAfterSeconds = null)
    {
        _engineStatusDetail = errorCode == "rate_limited" && retryAfterSeconds is { } seconds
            ? FormatSettingsText(
                SettingsTextKeys.AvatarEngineRateLimitedRetryDescription,
                "Wait {0} seconds before selecting Connect again.",
                seconds)
            : description;
        _engineState = errorCode switch
        {
            "pairing_required" => AvatarEngineState.PairingRequired,
            "exclusive_unavailable" or "exclusive_access_denied" or "access_mode_conflict" => AvatarEngineState.AccessConflict,
            "rate_limited" => AvatarEngineState.RateLimited,
            "unreachable" => AvatarEngineState.Offline,
            "credential_persistence_failed" => AvatarEngineState.ConfigurationError,
            _ => AvatarEngineState.EngineError
        };
        _localEngineStartRequested = _engineState != AvatarEngineState.Offline;
    }

    private async Task LoadEngineCatalogsAfterConnectedAsync(int refreshVersion, bool showToasts)
    {
        var avatarCatalog = await LoadAvatarsAsync(showToasts);
        var emotionCatalog = await LoadEmotionsAsync(showToasts);

        if (!IsCurrentEngineRefresh(refreshVersion))
        {
            return;
        }

        _availableAvatars = avatarCatalog.Values;
        _availableEmotions = emotionCatalog.Values;
        _avatarCatalogLoaded = avatarCatalog.Loaded;
        _emotionCatalogLoaded = emotionCatalog.Loaded;
        var appearanceLoaded = await LoadAppearanceCatalogsAsync(_draft.SelectedAvatar, refreshVersion, showToasts);
        if (!IsCurrentEngineRefresh(refreshVersion) || appearanceLoaded is null)
        {
            return;
        }

        _engineState = avatarCatalog.Loaded && emotionCatalog.Loaded && appearanceLoaded.Value
            ? AvatarEngineState.Connected
            : AvatarEngineState.CatalogError;

        if (_engineState == AvatarEngineState.CatalogError)
        {
            _engineStatusDetail = Loc.GetOrDefault(
                SettingsTextKeys.AvatarEngineCatalogErrorDescription,
                "The engine is reachable, but one or more live choice lists could not be loaded.");
        }
        else if (showToasts)
        {
            ToastService.Show(Loc.GetOrDefault(SettingsTextKeys.AvatarEngineConnectedToast, "Avatar Engine connected and live choices loaded."), ToastType.Success);
        }
    }

