    private string GetAppearanceHint(bool loaded, string? selectedId, IReadOnlyList<SelectOption> options, string key, string text)
    {
        if (string.IsNullOrWhiteSpace(_draft.SelectedAvatar))
        {
            return Loc.GetOrDefault(SettingsTextKeys.AvatarChooseAvatarDescription, "Choose an avatar to display");
        }

        return GetCatalogHint(loaded, selectedId, options.Select(option => option.Value).ToList(), key, text);
    }

    private IReadOnlyList<SelectOption> GetCatalogOptions(
        bool catalogLoaded,
        string? savedValue,
        IReadOnlyList<SelectOption> liveValues,
        string loadingText)
    {
        if (IsEngineChecking)
        {
            return [new SelectOption(savedValue ?? string.Empty, loadingText)];
        }

        if (!catalogLoaded)
        {
            if (string.IsNullOrWhiteSpace(savedValue))
            {
                return [new SelectOption(string.Empty, CommonLoc.GetOrDefault(CommonTextKeys.NoneOption, "None"))];
            }

            return [new SelectOption(
                savedValue,
                FormatSettingsText(SettingsTextKeys.AvatarSavedUnverifiedOption, "Saved: {0} (not verified)", savedValue))];
        }

        var options = new List<SelectOption>
        {
            new(string.Empty, CommonLoc.GetOrDefault(CommonTextKeys.NoneOption, "None"))
        };

        if (!string.IsNullOrWhiteSpace(savedValue) &&
            !liveValues.Any(option => string.Equals(option.Value, savedValue, StringComparison.Ordinal)))
        {
            options.Add(new SelectOption(
                savedValue,
                FormatSettingsText(SettingsTextKeys.AvatarSavedUnavailableOption, "Saved: {0} (not available)", savedValue)));
        }

        options.AddRange(liveValues);
        return options;
    }

    private string GetCatalogHint(
        bool catalogLoaded,
        string? selectedValue,
        IReadOnlyList<string> liveValues,
        string defaultKey,
        string defaultText)
    {
        if (IsEngineChecking)
        {
            return Loc.GetOrDefault(SettingsTextKeys.AvatarCatalogCheckingHint, "Loading live choices from the Avatar Engine.");
        }

        if (!catalogLoaded)
        {
            return string.IsNullOrWhiteSpace(selectedValue)
                ? Loc.GetOrDefault(SettingsTextKeys.AvatarCatalogOfflineHint, "Live choices are available after the Avatar Engine connects.")
                : FormatSettingsText(SettingsTextKeys.AvatarSavedValueUnverifiedHint, "Saved value '{0}' is shown but has not been verified with the running engine.", selectedValue);
        }

        if (!string.IsNullOrWhiteSpace(selectedValue) &&
            !liveValues.Contains(selectedValue, StringComparer.Ordinal))
        {
            return FormatSettingsText(SettingsTextKeys.AvatarSavedValueUnavailableHint, "Saved value '{0}' is not available in the running engine.", selectedValue);
        }

        return Loc.GetOrDefault(defaultKey, defaultText);
    }

    private async Task ApplyAvatarAsync()
    {
        var avatarName = _draft.SelectedAvatar;
        if (string.IsNullOrWhiteSpace(avatarName))
        {
            return;
        }

        var hairId = _draft.SelectedHairId;
        var topClothingId = _draft.SelectedTopClothingId;
        try
        {
            using var httpResponse = await Http.PostAsJsonAsync(ApiRoutes.AvatarBridge.AvatarsSelect, new AvatarSelectRequest { AvatarName = avatarName });
            var response = await httpResponse.Content.ReadFromJsonAsync<AvatarSelectResponse>();
            if (response is not null && response.Success)
            {
                var hairApplied = await ApplyHairAsync(avatarName, hairId);
                var topApplied = await ApplyTopClothingAsync(avatarName, topClothingId);
                if (hairApplied && topApplied)
                {
                    ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarAppliedToast,
                        "Appearance applied to '{0}'", response.SelectedAvatar), ToastType.Success);
                }
            }
            else
            {
                ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarApplyFailedToast, "Failed to apply avatar: {0}", response?.Description), ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply avatar");
            ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarApplyErrorToast, "Error applying avatar: {0}", ex.Message), ToastType.Error);
        }
    }

