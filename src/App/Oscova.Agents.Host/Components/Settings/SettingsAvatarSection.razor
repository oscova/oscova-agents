    private void ClearAppearanceCatalogs()
    {
        _appearanceCatalogVersion++;
        _hairCatalogLoaded = false;
        _topClothingCatalogLoaded = false;
        _availableHairOptions = [];
        _availableTopClothingOptions = [];
    }

    private async Task<bool?> LoadAppearanceCatalogsAsync(string? avatarName, int refreshVersion, bool showToasts)
    {
        ClearAppearanceCatalogs();
        if (string.IsNullOrWhiteSpace(avatarName) || !_availableAvatars.Contains(avatarName, StringComparer.Ordinal))
        {
            return true;
        }

        var appearanceVersion = _appearanceCatalogVersion;
        AvatarHairListResponse? hair = null;
        AvatarClothingListResponse? clothing = null;
        try
        {
            hair = await Http.GetFromJsonAsync<AvatarHairListResponse>(
                $"{ApiRoutes.AvatarBridge.Hair}?avatarName={Uri.EscapeDataString(avatarName)}");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load hair choices for avatar {AvatarName}.", avatarName);
        }

        try
        {
            clothing = await Http.GetFromJsonAsync<AvatarClothingListResponse>(
                $"{ApiRoutes.AvatarBridge.Clothing}?avatarName={Uri.EscapeDataString(avatarName)}");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load clothing choices for avatar {AvatarName}.", avatarName);
        }

        // Keep a late catalog response from replacing choices for a newly selected avatar.
        if (!IsCurrentEngineRefresh(refreshVersion) || appearanceVersion != _appearanceCatalogVersion ||
            !string.Equals(_draft.SelectedAvatar, avatarName, StringComparison.Ordinal))
        {
            return null;
        }

        if (hair?.Success == true && hair.HairOptions is { } hairOptions)
        {
            _hairCatalogLoaded = true;
            _availableHairOptions = hairOptions.Select(option => new SelectOption(option.HairId, option.DisplayName)).ToList();
        }
        if (clothing?.Success == true && clothing.ClothingOptions is { } clothingOptions)
        {
            _topClothingCatalogLoaded = true;
            _availableTopClothingOptions = clothingOptions
                .Where(option => string.Equals(option.Slot, "top", StringComparison.Ordinal))
                .Select(option => new SelectOption(option.ClothingId, option.DisplayName))
                .ToList();
        }

        if (showToasts && (!_hairCatalogLoaded || !_topClothingCatalogLoaded))
        {
            ToastService.Show(Loc.GetOrDefault(SettingsTextKeys.AvatarAppearanceCatalogFailedToast,
                "Some appearance choices could not be loaded. Check the Engine connection and refresh."), ToastType.Warning);
        }

        await InvokeAsync(StateHasChanged);
        return _hairCatalogLoaded && _topClothingCatalogLoaded;
    }

    private async Task OnAvatarSelectionChanged(ChangeEventArgs args)
    {
        var selectedAvatar = NormalizeOptionalSelection(args.Value?.ToString());
        if (string.Equals(_draft.SelectedAvatar, selectedAvatar, StringComparison.Ordinal))
        {
            return;
        }

        _draft.SelectedAvatar = selectedAvatar;
        _draft.SelectedHairId = null;
        _draft.SelectedTopClothingId = null;
        ClearAppearanceCatalogs();
        if (selectedAvatar is not null && IsEngineReachable)
        {
            await InvokeAsync(StateHasChanged);
            var appearanceLoaded = await LoadAppearanceCatalogsAsync(selectedAvatar, _engineRefreshVersion, showToasts: true);
            if (appearanceLoaded.HasValue)
            {
                _engineState = _avatarCatalogLoaded && _emotionCatalogLoaded && appearanceLoaded.Value
                    ? AvatarEngineState.Connected
                    : AvatarEngineState.CatalogError;
            }
        }
    }

