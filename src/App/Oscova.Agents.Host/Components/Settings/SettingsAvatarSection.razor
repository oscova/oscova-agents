    {
        _draft = new AvatarSettings.Snapshot();
        ClearAppearanceCatalogs();
        _ = InvokeAsync(StateHasChanged);
    }

    private string FormatSettingsText(string key, string fallback, params object?[] args)
    {
        return string.Format(CultureInfo.CurrentCulture, Loc.GetOrDefault(key, fallback), args);
    }

    private static string ToHexColor(float red, float green, float blue)
    {
        return $"#{ToByte(red):X2}{ToByte(green):X2}{ToByte(blue):X2}";
    }

    private static string ToHexColor(int red, int green, int blue)
    {
        return $"#{Math.Clamp(red, 0, 255):X2}{Math.Clamp(green, 0, 255):X2}{Math.Clamp(blue, 0, 255):X2}";
    }

    private static int ToByte(float channel)
    {
        return (int)Math.Round(Math.Clamp(channel, 0.0f, 1.0f) * 255);
    }

    private static bool TryParseHexColor(string? value, out float red, out float green, out float blue)
    {
        red = 0.0f;
        green = 0.0f;
        blue = 0.0f;

        if (!TryParseHexColorBytes(value, out var redByte, out var greenByte, out var blueByte))
        {
            return false;
        }

        red = redByte / 255.0f;
        green = greenByte / 255.0f;
        blue = blueByte / 255.0f;
        return true;
    }

    private static bool TryParseHexColorBytes(string? value, out int red, out int green, out int blue)
    {
        red = 0;
        green = 0;
        blue = 0;

        var hex = value?.Trim();
        if (string.IsNullOrWhiteSpace(hex))
        {
            return false;
        }

        if (hex.StartsWith('#'))
        {
            hex = hex[1..];
        }

        if (hex.Length != 6)
        {
            return false;
        }

        return int.TryParse(hex[..2], NumberStyles.HexNumber, CultureInfo.InvariantCulture, out red) &&
               int.TryParse(hex.Substring(2, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out green) &&
               int.TryParse(hex.Substring(4, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out blue);
    }

    private static bool ArePresentationSettingsEqual(AvatarPresentationSettingsRequest a, AvatarPresentationSettingsRequest b) =>
        a.Mode == b.Mode && Math.Abs(a.DurationSeconds - b.DurationSeconds) < 0.01f &&
        ArePresentationLayoutsEqual(a.Subtitle, b.Subtitle) && ArePresentationLayoutsEqual(a.Side, b.Side);

    private static bool ArePresentationLayoutsEqual(AvatarPresentationLayout a, AvatarPresentationLayout b) =>
        Math.Abs(a.Yaw - b.Yaw) < 0.01f && a.PositionX == b.PositionX && a.PositionY == b.PositionY &&
        a.Width == b.Width && a.Height == b.Height && a.FontSize == b.FontSize &&
        a.Red == b.Red && a.Green == b.Green && a.Blue == b.Blue && a.Alpha == b.Alpha;

    private static bool AreSettingsEqual(AvatarSettings.Snapshot a, AvatarSettings.Snapshot b)
    {
        return a.BridgeUrl == b.BridgeUrl &&
               a.PreferredAccessMode == b.PreferredAccessMode &&
               a.SelectedAvatar == b.SelectedAvatar &&
               a.SelectedHairId == b.SelectedHairId &&
               a.SelectedTopClothingId == b.SelectedTopClothingId &&
               a.SelectedEmotion == b.SelectedEmotion &&
               Math.Abs(a.EmotionBlendSpeed - b.EmotionBlendSpeed) < 0.01f &&
               Math.Abs(a.EmotionCueBlendInSeconds - b.EmotionCueBlendInSeconds) < 0.01f &&
               Math.Abs(a.EmotionCueRestoreAfterSeconds - b.EmotionCueRestoreAfterSeconds) < 0.01f &&
               a.BackgroundColorRed == b.BackgroundColorRed &&
               a.BackgroundColorGreen == b.BackgroundColorGreen &&
               a.BackgroundColorBlue == b.BackgroundColorBlue &&
               a.GraphicsPresetLevel == b.GraphicsPresetLevel &&
               a.IsRayTracingEnabled == b.IsRayTracingEnabled &&
               a.ResolutionWidth == b.ResolutionWidth &&
               a.ResolutionHeight == b.ResolutionHeight &&
               a.IsFullscreen == b.IsFullscreen &&
               ArePresentationSettingsEqual(a.Presentation, b.Presentation) &&
               Math.Abs(a.SpeechVolume - b.SpeechVolume) < 0.01f;
    }
}
