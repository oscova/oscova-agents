            // Send the displayed target through confirmation to the shared shutdown owner.
            using var httpResponse = await Http.PostAsJsonAsync($"{ApiRoutes.AvatarBridge.Shutdown}?expectedBaseUrl={Uri.EscapeDataString(confirmedTarget)}", new AvatarShutdownRequest());
            var response = await httpResponse.Content.ReadFromJsonAsync<AvatarShutdownResponse>();
            if (response is not null && response.Success && response.ShutdownInitiated)
            {
                _engineState = AvatarEngineState.Offline;
                _localEngineStartRequested = false;
                _engineStatusDetail = null;
                ToastService.Show(Loc.GetOrDefault(SettingsTextKeys.AvatarShutdownInitiatedToast, "Avatar shutdown initiated"), ToastType.Success);
            }
            else
            {
                ToastService.Show(FormatSettingsText(SettingsTextKeys.AvatarShutdownFailedToast, "Failed to initiate shutdown: {0}", response?.Description), ToastType.Error);
            }
        }
        catch (Exception ex)
        {
