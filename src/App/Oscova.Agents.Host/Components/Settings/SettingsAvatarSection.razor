    // Force one preset temporarily, then restore the selected mode even after an early end.
    private async Task TestPresentationAsync(string mode)
    {
        var restore = _draft.Presentation.Clone();
        var preview = restore.Clone();
        preview.Mode = mode;
        using var cancellation = new CancellationTokenSource();
        _presentationTest = cancellation;
        try
        {
            if (!await SendPresentationAsync(preview)) { return; }
            cancellation.Token.ThrowIfCancellationRequested();
            if (!await TestMessageDisplayAsync()) { return; }
            await Task.Delay(TimeSpan.FromSeconds(preview.DurationSeconds), cancellation.Token);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            // Wait for pending preview requests before clearing and restoring the selected mode.
            if (cancellation.IsCancellationRequested) { await ClearMessageDisplayAsync(); }
            await SendPresentationAsync(restore);
            _presentationTest = null;
            if (!_disposed) { await InvokeAsync(StateHasChanged); }
        }
    }

    private Task EndPresentationTestAsync()
    {
        _presentationTest?.Cancel();
        return Task.CompletedTask;
    }

    /// <summary>Ends the temporary preset override when leaving settings.</summary>
    public void Dispose()
    {
        _disposed = true;
        AvatarUpdates.InstallationChanged -= OnInstallationChanged;
        _presentationTest?.Cancel();
    }

