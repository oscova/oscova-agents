@implements IAsyncDisposable
@using Oscova.Agents.Harness
@inject UserServiceScope UserScope
@inject ChatVisualizationService Visualizations
@inject IJSRuntime JS
@inject IStringLocalizer<ChatText> Loc

<div class="inline-visualization" aria-label="@Loc.GetOrDefault(ChatTextKeys.VisualizationTitle, "Interactive visualization")">
    @* Keep generated frame children separate from Blazor-owned status markup. *@
    <div @ref="_container"></div>
    @if (_html is null)
    {
        <div class="text-base-content/60 py-3 text-sm" role="status">@(_localOnly
            ? Loc.GetOrDefault(ChatTextKeys.VisualizationLocalOnly, "Visualizations are disabled in local-only mode.")
            : Loc.GetOrDefault(ChatTextKeys.VisualizationUnavailable, "Visualization unavailable"))</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatThread Thread { get; set; } = default!;
    [Parameter, EditorRequired] public ChatSegment Segment { get; set; } = default!;
    private ElementReference _container;
    private IJSObjectReference? _module;
    private string? _html;
    private string? _renderedHtml;
    private bool _localOnly;
    private bool _disposed;
    private bool IsLocalOnly => UserScope.PrivacySettings.IsLocalOnly || UserScope.AppService.ResolveAgentDefinition(Thread.AgentId).IsLocalOnly;
    private (string ThreadId, ChatVisualizationService.Receipt? Receipt)? _publication;
    private readonly SemaphoreSlim _refresh = new(1, 1);

    protected override void OnInitialized()
    {
        Visualizations.Changed += OnVisualizationChanged;
        UserScope.PrivacySettings.Changed += OnPolicyChanged;
        UserScope.AppService.StateChanged += OnPolicyChanged;
    }

    protected override Task OnParametersSetAsync()
    {
        ChatVisualizationService.TryRead(Segment, out var receipt);
        var publication = (Thread.Id, receipt);
        // Parent renders do not change a publication. File and policy events refresh it explicitly.
        if (_publication == publication) { return Task.CompletedTask; }
        _publication = publication;
        return RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await _refresh.WaitAsync();
        try
        {
            if (_disposed) { return; }
            _localOnly = IsLocalOnly;
            if (_localOnly || !ChatVisualizationService.TryRead(Segment, out var receipt)) { _html = null; return; }
            var thread = Thread;
            // File-backed policy reads include synchronous IO, so keep them off the circuit dispatcher.
            var html = await Task.Run(async () =>
            {
                var owned = await UserScope.ChatThreadRepository.ThreadExistsAsync(UserScope.UserId, thread.Id).ConfigureAwait(false);
                if (!owned) { return null; }
                var content = await Visualizations.ReadPublishedAsync(UserScope, thread, receipt!).ConfigureAwait(false);
                await Visualizations.EnsureAvailableAsync(UserScope, thread).ConfigureAwait(false);
                return content;
            });
            if (!_disposed) { _html = html; }
        }
        catch (ToolFailureException) { _html = null; }
        finally
        {
            _refresh.Release();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Parent renders can overlap while browser interop is pending.
        await _refresh.WaitAsync();
        try
        {
            if (_disposed) { return; }
            if (_html is null)
            {
                _renderedHtml = null;
                if (_module is not null) { await _module.InvokeVoidAsync("dispose", _container); }
                return;
            }
            if (_html == _renderedHtml) { return; }
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/inlineVisualization.js");
            if (_disposed)
            {
                // Navigation can dispose the component before the imported reference arrives.
                await _module.DisposeAsync();
                _module = null;
                return;
            }
            // Policy notifications can be waiting behind this mount's semaphore.
            _localOnly = IsLocalOnly;
            if (_localOnly) { _html = null; }
            if (_html is null) { return; }
            await _module.InvokeVoidAsync("render", _container, _html,
                Loc.GetOrDefault(ChatTextKeys.VisualizationTitle, "Interactive visualization"));
            _renderedHtml = _html;
        }
        finally { _refresh.Release(); }
    }

    private void OnVisualizationChanged(string userId, string threadId)
    {
        if (userId == UserScope.UserId && threadId == Thread.Id) { OnPolicyChanged(null, EventArgs.Empty); }
    }

    private async void OnPolicyChanged(object? sender, EventArgs args)
    {
        if (_disposed) { return; }
        try
        {
            await InvokeAsync(async () =>
            {
                // Ordinary chat updates must not reload an unchanged visualization.
                await RefreshAsync();
                if (!_disposed) { StateHasChanged(); }
            });
        }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _html = null;
        Visualizations.Changed -= OnVisualizationChanged;
        UserScope.PrivacySettings.Changed -= OnPolicyChanged;
        UserScope.AppService.StateChanged -= OnPolicyChanged;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _container); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
