@* Keeps dynamic block controls inside assistant Markdown without changing Help rendering. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<ChatText> Loc
@inject IDialogService Dialogs
@inject IToastService Toasts

@* Replacing the keyed root lets Blazor remove browser-added wrappers as one unit during streaming. *@
<div @key="_html" @ref="_root" class="markdown-content" dir="auto">@((MarkupString)_html)</div>

@code {
    [Parameter, EditorRequired] public string Markdown { get; set; } = string.Empty;
    [Parameter] public ChatThread? Thread { get; set; }
    [Parameter] public string? AgentId { get; set; }
    [Parameter] public IReadOnlyList<ThreadArtifact> Artifacts { get; set; } = [];
    [Parameter] public bool IsRunActive { get; set; }

    private ElementReference _root;
    private string _html = string.Empty;
    private string? _enhancedHtml;
    private IJSObjectReference? _module;
    private IJSObjectReference? _binding;
    private DotNetObjectReference<ChatMarkdown>? _self;
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private bool _disposed;

    protected override void OnParametersSet() => _html = RenderHtml();

    private string RenderHtml(int? tableIndex = null) =>
        MarkdownRenderer.ToChatHtml(Markdown, Thread, AgentId, Artifacts, IsRunActive, tableIndex);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Streamed renders can arrive while browser cleanup is still awaiting its reply.
        await _interopGate.WaitAsync();
        try
        {
            if (_disposed || _enhancedHtml == _html) { return; }
            var html = _html;
            var root = _root;
            if (_binding is not null)
            {
                await _binding.InvokeVoidAsync("dispose");
                await _binding.DisposeAsync();
                _binding = null;
            }
            if (!html.Contains("<table", StringComparison.Ordinal) && !html.Contains("<pre", StringComparison.Ordinal))
            {
                _enhancedHtml = html;
                return;
            }
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/chatMarkdown.js");
            _self ??= DotNetObjectReference.Create(this);
            _binding = await _module.InvokeAsync<IJSObjectReference>("enhance", root, _self, new
            {
                copy = Loc.GetOrDefault(ChatTextKeys.ResponseCopyLabel, "Copy"),
                copied = Loc.GetOrDefault(ChatTextKeys.ResponseCopiedLabel, "Copied"),
                expand = Loc.GetOrDefault(ChatTextKeys.ExpandTable, "Expand table")
            });
            _enhancedHtml = _binding is not null ? html : null;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException)
        {
            // A later render can retry controls after an interrupted browser call.
        }
        finally
        {
            _interopGate.Release();
        }
    }

    /// <summary>Opens a table from the server-owned Markdown rather than accepting browser-provided HTML.</summary>
    [JSInvokable]
    public async Task ExpandTable(int index)
    {
        if (index < 0) { return; }
        var html = RenderHtml(index);
        if (string.IsNullOrEmpty(html)) { return; }
        await Dialogs.ShowAsync<ChatTableDialog>(new Dictionary<string, object?>
        {
            ["Html"] = html,
            ["ChatId"] = Thread?.Id
        });
    }

    /// <summary>Shows the same actionable clipboard failure as the response copy control.</summary>
    [JSInvokable]
    public void CopyFailed() => Toasts.Show(
        Loc.GetOrDefault(ChatTextKeys.ResponseCopyFailed, "Unable to copy."), ToastType.Error);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _interopGate.WaitAsync();
        try
        {
            if (_binding is not null)
            {
                await _binding.InvokeVoidAsync("dispose");
                await _binding.DisposeAsync();
            }
            if (_module is not null) { await _module.DisposeAsync(); }
        }
        catch (JSDisconnectedException)
        {
            // Navigation or shutdown can end the circuit before browser cleanup completes.
        }
        finally
        {
            _self?.Dispose();
            _interopGate.Release();
        }
    }
}
