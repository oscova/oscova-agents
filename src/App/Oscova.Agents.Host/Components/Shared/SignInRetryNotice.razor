@implements IAsyncDisposable
@inject TimeProvider Clock
@inject IStringLocalizer<AuthText> Loc

@if (RetryUntil is not null)
{
    <div class="alert alert-warning">
        @CountdownText
    </div>
}
<span class="sr-only" role="status" aria-live="polite">@_announcement</span>

@code {
    [Parameter] public DateTimeOffset? RetryUntil { get; set; }
    [Parameter] public bool WasBlocked { get; set; }
    [Parameter] public EventCallback OnExpired { get; set; }

    private CancellationTokenSource? _cancellation;
    private Task? _ticker;
    private DateTimeOffset? _activeDeadline;
    private int _seconds;
    private string? _announcement;

    private string CountdownText => string.Format(CultureInfo.CurrentCulture,
        WasBlocked
            ? Loc.GetOrDefault(AuthTextKeys.SignInWaitCountdown, "Try again in {0} seconds.")
            : Loc.GetOrDefault(AuthTextKeys.SignInRetryCountdown, "That didn't match. Try again in {0} seconds."), _seconds);

    protected override void OnParametersSet()
    {
        if (_activeDeadline == RetryUntil) { return; }
        _cancellation?.Cancel();
        _cancellation?.Dispose();
        _cancellation = null;
        _activeDeadline = RetryUntil;
        if (RetryUntil is not { } deadline)
        {
            _announcement = Loc.GetOrDefault(AuthTextKeys.TryAgainButton, "Try again");
            return;
        }
        _cancellation = new();
        _seconds = RemainingSeconds(deadline);
        // Announce the wait and its end, without reading every second aloud.
        _announcement = CountdownText;
        _ticker = TickAsync(deadline, _cancellation.Token);
    }

    private int RemainingSeconds(DateTimeOffset deadline) =>
        Math.Max(0, (int)Math.Ceiling((deadline - Clock.GetUtcNow()).TotalSeconds));

    private async Task TickAsync(DateTimeOffset deadline, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await InvokeAsync(async () =>
                {
                    if (ct.IsCancellationRequested) { return; }
                    _seconds = RemainingSeconds(deadline);
                    if (_seconds == 0) { await OnExpired.InvokeAsync(); }
                    StateHasChanged();
                });
                if (_seconds == 0 || !await timer.WaitForNextTickAsync(ct)) { return; }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    /// <summary>Stops countdown updates when the form leaves the render tree.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_cancellation is not null) { await _cancellation.CancelAsync(); }
        if (_ticker is not null) { await _ticker; }
        _cancellation?.Dispose();
    }
}
