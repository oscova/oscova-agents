{
  "id": "oscova.llamasharp",
  "name": "Oscova LLamaSharp Provider",
  "version": "$version$",
  "frameworkVersionRange": "[$frameworkVersion$]",
  "supportedRuntimeIdentifiers": ["win-x64", "linux-x64", "osx-x64", "osx-arm64"],
  "hardwareRequirements": {
    "win-x64": { "backend": "cpu" },
    "linux-x64": { "backend": "cpu" },
    "osx-x64": { "backend": "cpu" },
    "osx-arm64": { "backend": "metal" }
  },
  "assembly": "Oscova.Agents.Plugins.LlamaSharp.dll",
  "entryType": "Oscova.Agents.Plugins.LlamaSharp.LlamaSharpAgentPlugin"
}
