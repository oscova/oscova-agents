<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);LOCAL_SYNTHESIS_PLUGIN</DefineConstants>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <IsPackable>true</IsPackable>
    <LocalSpeechEdition Condition="'$(LocalSpeechEdition)' == ''">Cpu</LocalSpeechEdition>
    <PackageId>Oscova.Agents.Plugins.LocalSpeechSynthesis</PackageId>
    <PackageId Condition="'$(LocalSpeechEdition)' == 'Cuda'">Oscova.Agents.Plugins.LocalSpeechSynthesis.Cuda</PackageId>
    <Version>$(LocalSpeechSynthesisPluginVersion)</Version>
    <KokoroVersion>0.8.4</KokoroVersion>
    <OnnxRuntimeVersion>1.31.0</OnnxRuntimeVersion>
    <DefineConstants Condition="'$(LocalSpeechEdition)' == 'Cuda'">$(DefineConstants);LOCAL_SPEECH_CUDA</DefineConstants>
    <NuspecFile Condition="'$(LocalSpeechEdition)' == 'Cuda' and '$(NuspecFile)' == ''">$(MSBuildProjectDirectory)/packaging/LocalSpeechSynthesis.Cuda.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <PackageType>OscovaPlugin</PackageType>
    <Description>Oscova Agents plugin providing local Kokoro synthesis.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>oscova;oscova-agents;plugin;speech;kokoro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/oscova/oscova-agents</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KokoroSharp" Version="[$(KokoroVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalSpeechEdition)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="[$(OnnxRuntimeVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalSpeechEdition)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="[$(OnnxRuntimeVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="oscova-plugin.json" Pack="true" PackagePath="\" Condition="'$(LocalSpeechEdition)' == 'Cpu'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="oscova-plugin.cuda.json" Condition="'$(LocalSpeechEdition)' == 'Cuda'" TargetPath="oscova-plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KokoroVersion" Value="$(KokoroVersion)" />
  </ItemGroup>

  <Target Name="ValidateLocalSpeechEdition" BeforeTargets="PrepareForBuild;GenerateNuspec">
    <Error Condition="'$(LocalSpeechEdition)' != 'Cpu' and '$(LocalSpeechEdition)' != 'Cuda'" Text="LocalSpeechEdition must be Cpu or Cuda." />
  </Target>

  <!-- Evaluate restored binary roots and the compiled assembly before packing custom manifests. -->
  <Target Name="SetLocalSpeechNuspecProperties" BeforeTargets="GenerateNuspec" Condition="'$(LocalSpeechEdition)' == 'Cuda'">
    <PropertyGroup>
      <NuspecProperties>rootVersion=$(Version);frameworkRange=$(PluginFrameworkVersionRange);kokoroVersion=$(KokoroVersion);onnxVersion=$(OnnxRuntimeVersion);assembly=$(TargetPath);satellites=$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutputPath)', '**', 'Oscova.Agents.Plugins.LocalSpeechSynthesis.resources.dll'));cudaManifest=$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'stamped', 'oscova-plugin.cuda.json'));readme=$(MSBuildProjectDirectory)/README.md;icon=$(MSBuildProjectDirectory)/../../../assets/branding/oscova-package-icon.png</NuspecProperties>
    </PropertyGroup>
  </Target>


  <ItemGroup>
    <!-- Razor defaults treat JSON as content, while manifest stamping uses explicit None items. -->
    <Content Remove="oscova-plugin*.json" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Shared/Speech/*.cs" Link="Speech/%(Filename)%(Extension)" />
    <Compile Include="../Shared/SpeechSettings/*.cs" Link="Settings/%(Filename)%(Extension)" />
    <Content Include="../Shared/SpeechSettings/*.razor" Link="Settings/%(Filename)%(Extension)" />
  </ItemGroup>


</Project>
