<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);LOCAL_RECOGNITION_PLUGIN</DefineConstants>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <IsPackable>true</IsPackable>
    <LocalSpeechEdition Condition="'$(LocalSpeechEdition)' == ''">Cpu</LocalSpeechEdition>
    <PackageId>Oscova.Agents.Plugins.LocalSpeechRecognition</PackageId>
    <PackageId Condition="'$(LocalSpeechEdition)' == 'Cuda'">Oscova.Agents.Plugins.LocalSpeechRecognition.Cuda</PackageId>
    <Version>$(LocalSpeechRecognitionPluginVersion)</Version>
    <WhisperRuntimeVersion>1.9.1</WhisperRuntimeVersion>
    <WhisperNativePackageVersion>2.0.1</WhisperNativePackageVersion>
    <NAudioVersion>3.0.1</NAudioVersion>
    <DefineConstants Condition="'$(LocalSpeechEdition)' == 'Cuda'">$(DefineConstants);LOCAL_SPEECH_CUDA</DefineConstants>
    <NuspecFile Condition="'$(LocalSpeechEdition)' == 'Cuda' and '$(NuspecFile)' == ''">$(MSBuildProjectDirectory)/packaging/LocalSpeechRecognition.Cuda.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <PackageType>OscovaPlugin</PackageType>
    <Description>Oscova Agents plugin providing local Whisper recognition.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>oscova;oscova-agents;plugin;speech;whisper</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/oscova/oscova-agents</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="[$(WhisperRuntimeVersion)]" />
    <PackageReference Include="NAudio" Version="[$(NAudioVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalSpeechEdition)' == 'Cpu'">
    <!-- Use the runtime package only as the binary source for standard runtime assets. -->
    <PackageReference Include="Whisper.net.Runtime" Version="[$(WhisperRuntimeVersion)]" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalSpeechEdition)' == 'Cuda'">
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="[$(WhisperRuntimeVersion)]" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Linux" Version="[$(WhisperRuntimeVersion)]" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="oscova-plugin.json" Pack="true" PackagePath="\" Condition="'$(LocalSpeechEdition)' == 'Cpu'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="oscova-plugin.cuda.json" Condition="'$(LocalSpeechEdition)' == 'Cuda'" TargetPath="oscova-plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="licenses\*.txt" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalSpeechEdition)' == 'Cpu'">
    <None Include="$(PkgWhisper_net_Runtime)\build\win-x64\**\*" Pack="true" PackagePath="runtimes\win-x64\native\runtimes\win-x64\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(PkgWhisper_net_Runtime)\build\linux-x64\**\*" Pack="true" PackagePath="runtimes\linux-x64\native\runtimes\linux-x64\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(PkgWhisper_net_Runtime)\build\macos-x64\**\*" Pack="true" PackagePath="runtimes\osx-x64\native\runtimes\macos-x64\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(PkgWhisper_net_Runtime)\build\macos-arm64\**\*" Pack="true" PackagePath="runtimes\osx-arm64\native\runtimes\macos-arm64\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WhisperNativePackageVersion" Value="$(WhisperNativePackageVersion)" />
  </ItemGroup>

  <Target Name="ValidateLocalSpeechEdition" BeforeTargets="PrepareForBuild;GenerateNuspec">
    <Error Condition="'$(LocalSpeechEdition)' != 'Cpu' and '$(LocalSpeechEdition)' != 'Cuda'" Text="LocalSpeechEdition must be Cpu or Cuda." />
  </Target>

  <!-- Evaluate restored binary roots and the compiled assembly before packing custom manifests. -->
  <Target Name="SetLocalSpeechNuspecProperties" BeforeTargets="GenerateNuspec" Condition="'$(LocalSpeechEdition)' == 'Cuda'">
    <PropertyGroup>
      <NuspecProperties>rootVersion=$(Version);frameworkRange=$(PluginFrameworkVersionRange);whisperVersion=$(WhisperRuntimeVersion);whisperNativePackageVersion=$(WhisperNativePackageVersion);naudioVersion=$(NAudioVersion);assembly=$(TargetPath);satellites=$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutputPath)', '**', 'Oscova.Agents.Plugins.LocalSpeechRecognition.resources.dll'));cudaManifest=$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'stamped', 'oscova-plugin.cuda.json'));readme=$(MSBuildProjectDirectory)/README.md;licenses=$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'licenses', '*.txt'));icon=$(MSBuildProjectDirectory)/../../assets/branding/oscova-package-icon.png;windows=$([System.IO.Path]::Combine('$(PkgWhisper_net_Runtime_Cuda_Windows)', 'build', 'win-x64', '*.dll'));linux=$([System.IO.Path]::Combine('$(PkgWhisper_net_Runtime_Cuda_Linux)', 'build', 'linux-x64', '*.so'))</NuspecProperties>
    </PropertyGroup>
  </Target>


  <ItemGroup>
    <!-- Razor defaults treat JSON as content, while manifest stamping uses explicit None items. -->
    <Content Remove="oscova-plugin*.json" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Shared/SpeechSettings/*.cs" Link="Settings/%(Filename)%(Extension)" />
    <Content Include="../Shared/SpeechSettings/*.razor" Link="Settings/%(Filename)%(Extension)" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.311" />
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Update="Roslynator.Analyzers" Version="5.0.1" />
  </ItemGroup>
</Project>
