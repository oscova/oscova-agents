<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Oscova.Agents.Plugins.LocalSpeechSynthesis.Cuda</id>
    <version>$rootVersion$</version>
    <authors>Oscova</authors>
    <description>NVIDIA CUDA local speech synthesis for Windows x64 and Linux x64. Requires an NVIDIA GPU, CUDA 13.0.1 or later in the CUDA 13 family, and cuDNN 9. Replaces Oscova Local Speech Synthesis after restarting Oscova. GPU prerequisites are installed separately.</description>
    <license type="expression">Apache-2.0</license>
    <readme>README.md</readme>
    <icon>oscova-package-icon.png</icon>
    <projectUrl>https://oscova.ai</projectUrl>
    <repository type="git" url="https://github.com/oscova/oscova-agents" />
    <tags>oscova oscova-agents plugin speech whisper kokoro nvidia cuda gpu</tags>
    <packageTypes><packageType name="OscovaPlugin" /></packageTypes>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Oscova.Agents" version="$frameworkRange$" />
        <dependency id="KokoroSharp" version="[$kokoroVersion$]" />
        <dependency id="Microsoft.ML.OnnxRuntime.Gpu" version="[$onnxVersion$]" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0"><frameworkReference name="Microsoft.AspNetCore.App" /></group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="$assembly$" target="runtimes/win-x64/lib/net10.0/Oscova.Agents.Plugins.LocalSpeechSynthesis.dll" />
    <file src="$assembly$" target="runtimes/linux-x64/lib/net10.0/Oscova.Agents.Plugins.LocalSpeechSynthesis.dll" />
    <file src="$satellites$" target="lib/net10.0" />
    <file src="$cudaManifest$" target="oscova-plugin.json" />
    <file src="$readme$" target="README.md" />
    <file src="$icon$" target="oscova-package-icon.png" />
  </files>
</package>
