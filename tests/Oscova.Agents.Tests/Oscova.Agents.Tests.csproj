		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Syn.Utilities" Version="1.7.7" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\src\Oscova.Agents\Oscova.Agents.csproj" />
	  <ProjectReference Include="..\Oscova.Agents.Plugins.Echo\Oscova.Agents.Plugins.Echo.csproj" ReferenceOutputAssembly="false" Private="false" />
