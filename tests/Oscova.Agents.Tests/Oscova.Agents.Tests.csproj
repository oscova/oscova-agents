	<ItemGroup>
	  <Compile Include="..\TestSupport\TestDoubles\InMemoryAgentDefinitionRepository.cs" Link="TestSupport\TestDoubles\InMemoryAgentDefinitionRepository.cs" />
	  <Compile Include="..\TestSupport\TestDoubles\NoopUserFileBackupService.cs" Link="TestSupport\TestDoubles\NoopUserFileBackupService.cs" />
	  <Compile Include="..\TestSupport\TestDoubles\PassThroughContentProtector.cs" Link="TestSupport\TestDoubles\PassThroughContentProtector.cs" />
	  <Compile Include="..\TestSupport\TestDoubles\TestChatClient.cs" Link="TestSupport\TestDoubles\TestChatClient.cs" />
	  <Compile Include="..\TestSupport\TestPlugin\TestPluginRoot.cs" Link="TestSupport\TestPlugin\TestPluginRoot.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Meziantou.Analyzer" Version="3.0.203" />
	  <PackageReference Update="Roslynator.Analyzers" Version="5.0.0" />
	  <PackageReference Update="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
